---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = 'Nexux Pro — IA que atiende a tus clientas mientras tú trabajas',
  description = 'Tu peluquería en piloto automático. Lara, tu asistente IA, agenda citas y responde mensajes 24h. Sin contratar a nadie.',
  canonical = 'https://nexux.pro'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://nexux.pro/og-image.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nexux Pro — Asistente IA para peluquerías" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nexux.pro/og-image.svg" />
  <meta name="twitter:site" content="@nexuxpro" />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />






















  <script is:inline>
    function nxLoadTrackers() {
      if (window._nxTrackersLoaded) return;
      window._nxTrackersLoaded = true;
      // GA4
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-GS6BCN6TMJ';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-GS6BCN6TMJ', { anonymize_ip: true });
      // Meta Pixel
      !function(f,b,e,v,n,t,ss)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;ss=b.getElementsByTagName(e)[0];
      ss.parentNode.insertBefore(t,ss)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1467739621760495');
      fbq('track', 'PageView');
    }
    if (localStorage.getItem('nx_cookie_consent') === 'accepted') { nxLoadTrackers(); }
    document.addEventListener('nx:consent-granted', nxLoadTrackers);
  </script>

  <!-- Plausible (privacy-first, no requiere consent) -->
  <script defer data-domain="nexux.pro" src="https://plausible.io/js/script.tagged-events.outbound-links.js"></script>

  <!-- Generic track helper for data-track attributes -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      var t = e.target.closest('[data-track]');
      if (!t) return;
      var name = t.getAttribute('data-track');
      if (window.gtag) gtag('event', name);
      if (window.fbq) fbq('trackCustom', name);
      if (window.plausible) plausible(name);
    }, { passive: true });
  </script>

  <slot name="head" />
  <!-- Stripe.js -->
  <script src="https://js.stripe.com/v3/" async></script>
  <script type=application/ld+json>{@context:https://schema.org,@graph:[{@type:Organization,@id:https://nexux.pro/#org,name:Nexux Pro,url:https://nexux.pro,logo:https://nexux.pro/favicon.svg,description:Software de gestion con IA para peluquerias y centros de estetica en Espana. Automatiza citas, WhatsApp e Instagram 24h con la asistente virtual Lara.,foundingDate:2024,areaServed:{@type:Country,name:Espana}},{@type:SoftwareApplication,name:Nexux Pro,applicationCategory:BusinessApplication,operatingSystem:Web,url:https://nexux.pro,description:Asistente de inteligencia artificial para peluquerias espanolas. Gestiona citas, responde WhatsApp 24h y reduce cancelaciones hasta un 60%.,offers:[{@type:Offer,name:Plan Starter,price:249,priceCurrency:EUR},{@type:Offer,name:Plan Pro,price:449,priceCurrency:EUR},{@type:Offer,name:Plan Total,price:749,priceCurrency:EUR}]},{@type:FAQPage,mainEntity:[{@type:Question,name:Cual es el mejor software de gestion para peluquerias en Espana?,acceptedAnswer:{@type:Answer,text:Nexux Pro es el software con IA mas completo para peluquerias en Espana. No cobra comision por cita, no comparte tus clientas con competidores y automatiza WhatsApp con IA real desde 249 euros al mes.}},{@type:Question,name:Como automatizar citas de peluqueria por WhatsApp?,acceptedAnswer:{@type:Answer,text:Nexux Pro automatiza la gestion de citas por WhatsApp con su asistente Lara. Responde en menos de 30 segundos, agenda directamente en el calendario y envia recordatorios automaticos.}},{@type:Question,name:Que alternativa hay a Treatwell para peluquerias espanolas?,acceptedAnswer:{@type:Answer,text:Nexux Pro es la mejor alternativa a Treatwell y Booksy para peluquerias en Espana. Sin comision por cita, sin compartir clientas, con automatizacion WhatsApp real. Desde 249 euros al mes.}},{@type:Question,name:Cuanto cuesta un software de gestion para peluqueria?,acceptedAnswer:{@type:Answer,text:Nexux Pro cuesta desde 249 euros al mes para peluquerias pequenas. Incluye asistente IA para WhatsApp, gestion automatica de citas y recordatorios. Prueba gratuita de 14 dias.}}]}]}</script>
</head>
<body>
  <main>
    <slot />
  </main>

  <!-- Cookie consent banner -->
  <div id="nx-cookie-banner" class="cookie-banner" role="dialog" aria-label="Consentimiento de cookies" hidden>
    <div class="cookie-text">
      <strong>🍪 Usamos cookies para mejorar la experiencia.</strong><br/>
      Analítica (GA4) y publicidad (Meta) sólo si las aceptas. Tú decides.
    </div>
    <div class="cookie-actions">
      <button id="cookie-reject" class="btn-ghost cookie-btn">Sólo necesarias</button>
      <button id="cookie-accept" class="btn-primary cookie-btn">Aceptar todo</button>
    </div>
  </div>

  <script is:inline>
    (function() {
      var banner = document.getElementById('nx-cookie-banner');
      var stored = localStorage.getItem('nx_cookie_consent');
      if (!stored) banner.removeAttribute('hidden');

      document.getElementById('cookie-accept').addEventListener('click', function() {
        localStorage.setItem('nx_cookie_consent', 'accepted');
        document.dispatchEvent(new CustomEvent('nx:consent-granted'));
        banner.setAttribute('hidden', '');
      });
      document.getElementById('cookie-reject').addEventListener('click', function() {
        localStorage.setItem('nx_cookie_consent', 'rejected');
        banner.setAttribute('hidden', '');
      });
    })();
  </script>

  <style is:global>
    @import '../styles/global.css';

    .cookie-banner {
      position: fixed;
      bottom: 16px;
      left: 16px;
      right: 16px;
      max-width: 540px;
      margin: 0 auto;
      z-index: 200;
      background: var(--nx-deep);
      border: 1px solid var(--nx-line-hover);
      border-radius: 18px;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      backdrop-filter: blur(20px);
      animation: cookie-slide 0.5s var(--nx-ease) 1s backwards;
    }
    @keyframes cookie-slide {
      from { transform: translateY(40px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .cookie-text {
      font-size: 0.88rem;
      color: var(--nx-ink-muted);
      line-height: 1.5;
    }
    .cookie-text strong { color: var(--nx-ink); display: block; margin-bottom: 0.2rem; }
    .cookie-actions {
      display: flex;
      gap: 0.6rem;
      justify-content: flex-end;
    }
    .cookie-btn { padding: 0.55rem 1rem !important; font-size: 0.85rem !important; }
    @media (max-width: 600px) {
      .cookie-actions { flex-direction: column-reverse; }
      .cookie-btn { width: 100%; justify-content: center; }
    }
  </style>
<script>
import "../scripts/gsap-animations.ts";
</script>
</body>
</html>
