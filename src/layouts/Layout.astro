---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = 'Nexux Pro — IA que atiende a tus clientas mientras tú trabajas',
  description = 'Tu peluquería en piloto automático. Lara, tu asistente IA, agenda citas y responde mensajes 24h. Sin contratar a nadie.',
  canonical = 'https://nexux.pro'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://nexux.pro/og-image.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nexux Pro — Asistente IA para peluquerías" />
  <meta property="og:locale" content="es_ES" />
