---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}
// Por defecto el canonical se deriva de la URL de la pagina, no de la home:
// un valor fijo hacia que /blog, /comparativa, /oferta y /demo se declarasen
// duplicados de la portada y Google las descartara. (2026-08-18)
const canonicalPorDefecto =
  `https://nexux.pro${Astro.url.pathname}`.replace(/\/+$/, '') || 'https://nexux.pro';
const {
  title = 'Recepcionista IA para tu negocio — 29 €/mes | Nexux',
  description = 'Recepcionista IA que contesta por WhatsApp, Telegram y tu web 24 horas y reserva las citas en tu calendario. 29 € al mes, todo incluido, sin permanencia y con 30 días de garantía.',
  canonical = canonicalPorDefecto,
  noindex = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://nexux.pro/og-image.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nexux — Recepcionista IA para tu negocio" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nexux.pro/og-image.svg" />
  <meta name="twitter:site" content="@nexuxpro" />
  <link rel="canonical" href={canonical} />
