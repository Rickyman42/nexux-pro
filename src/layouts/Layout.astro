---
import PixelOpenAI from '../components/PixelOpenAI.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}
// Por defecto el canonical se deriva de la URL de la pagina, no de la home:
// un valor fijo hacia que /blog, /comparativa, /oferta y /demo se declarasen
// duplicados de la portada y Google las descartara. (2026-08-18)
const canonicalPorDefecto =
  `https://nexux.pro${Astro.url.pathname}`.replace(/\/+$/, '') || 'https://nexux.pro';
const {
  title = 'Recepcionista IA para tu negocio — 29 €/mes | Nexux',
  description = 'Recepcionista IA que contesta por WhatsApp, Telegram y tu web 24 horas y reserva las citas en tu calendario. 29 € al mes, todo incluido, sin permanencia y con 30 días de garantía.',
  canonical = canonicalPorDefecto,
  noindex = false
} = Astro.props;
const openAiAdsPixelId = import.meta.env.PUBLIC_OPENAI_ADS_PIXEL_ID;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://nexux.pro/img/nexux-lara-crm.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:alt" content="Nexux — Recepcionista IA para tu negocio" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nexux.pro/img/nexux-lara-crm.jpg" />
  <meta name="twitter:site" content="@nexuxpro" />
  <link rel="canonical" href={canonical} />
    <meta name="msvalidate.01" content="642F949B50E414BE85104C2686A3FCCB" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Aqui y no dentro del CSS: asi se pide a la vez que todo lo demas en vez
       de esperar a que el navegador lea el CSS para enterarse de que existe.
       Un segundo menos de pantalla en blanco en movil (medido 14-sep-2026). -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />

  <PixelOpenAI />

  <!-- Conserva la atribucion antes de que otro script limpie la URL. -->
  <script is:inline>
    try {
      if (location.search) sessionStorage.setItem('nx_pending_query', location.search);
    } catch (e) {}
  </script>
  <script>
    import "../scripts/measurement.ts";
  </script>






















  <script is:inline>
    function nxLoadTrackers() {
      if (window._nxTrackersLoaded) return;
      window._nxTrackersLoaded = true;
      // GA4
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-GS6BCN6TMJ';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-GS6BCN6TMJ', { anonymize_ip: true });
      // Meta Pixel
      !function(f,b,e,v,n,t,ss)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;ss=b.getElementsByTagName(e)[0];
      ss.parentNode.insertBefore(t,ss)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1467739621760495');
      fbq('track', 'PageView');
    }
    if (localStorage.getItem('nx_cookie_consent') === 'accepted') { nxLoadTrackers(); }
    document.addEventListener('nx:consent-granted', nxLoadTrackers);
  </script>

  <!-- Umami (cookieless, sin consentimiento) -->
  <script is:inline>
    (function () {
      var s = document.createElement('script');
      s.id = 'umami-script';
      s.defer = true;
      s.src = '/stats/script.js';
      s.dataset.websiteId = '682a2c1c-85be-41eb-b8a1-95d575e30545';
      s.dataset.hostUrl = 'https://nexux.pro/stats';
      document.head.appendChild(s);
    })();
  </script>

  <!-- Plausible (privacy-first, no requiere consent) -->
  <script defer data-domain="nexux.pro" src="https://plausible.io/js/script.tagged-events.outbound-links.js"></script>

  <!-- Generic track helper for data-track attributes -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      var t = e.target.closest('[data-track]');
      if (!t) return;
      var name = t.getAttribute('data-track');
      if (window.gtag) gtag('event', name);
      if (window.fbq) fbq('trackCustom', name);
      if (window.plausible) plausible(name);
    }, { passive: true });
  </script>

  <slot name="head" />
  <!-- Stripe.js -->
  <script src="https://js.stripe.com/v3/" async></script>
  <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://nexux.pro/#website","url":"https://nexux.pro","name":"Nexux","alternateName":"Nexux.pro","inLanguage":"es"},{"@type":"Organization","@id":"https://nexux.pro/#org","name":"Nexux","alternateName":["Nexux Pro","Nexux Recepcionista IA"],"url":"https://nexux.pro","logo":"https://nexux.pro/favicon.svg","description":"Recepcionista con inteligencia artificial que responde por WhatsApp, Telegram y web las 24 horas y reserva citas en el calendario del negocio.","foundingDate":"2024","areaServed":{"@type":"Country","name":"España"},"sameAs":["https://www.instagram.com/nexux.pro","https://twitter.com/nexuxpro","https://www.wikidata.org/wiki/Q141254732"],"disambiguatingDescription":"Nexux, con x final, es un SaaS español de recepcionista con inteligencia artificial para salones de belleza y peluquerías, operado por Nexux Innovación Digital Es una entidad distinta de las empresas y productos llamados Nexus o Nexus AI.","legalName":"Nexux Innovación Digital","identifier":[{"@type":"PropertyValue","propertyID":"Wikidata","value":"Q141254732","url":"https://www.wikidata.org/wiki/Q141254732"},{"@type":"PropertyValue","propertyID":"Official domain","value":"nexux.pro","url":"https://nexux.pro"}],"knowsAbout":["Recepcionista IA","Reserva de citas por WhatsApp","Automatización para peluquerías y centros de estética","Asistente conversacional para pymes"],"email":"info@nexux.pro"},{"@type":"SoftwareApplication","name":"Nexux Recepcionista IA","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://nexux.pro","description":"Asistente de inteligencia artificial llamado Lara que responde mensajes por WhatsApp, Telegram y web, y reserva citas en el calendario del negocio.","offers":{"@type":"Offer","name":"Recepcionista IA","price":"29","priceCurrency":"EUR"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://nexux.pro"}]}]}</script>
</head>
<body>
  <main>
    <slot />
  </main>

  {/* En las fichas de producto no va: ocupa 121px de la primera pantalla de un
      movil, que es justo donde cae el anuncio. El precio de quitarlo es que a
      quien llega por el anuncio no se le pregunta nunca, y sin permiso no se
      cargan los pixeles de Google, Meta ni OpenAI Ads: la campana deja de ver
      sus conversiones. Decision de Ricardo, 15-sep-2026.
      Umami y Plausible no dependen de esto y siguen midiendo. */}
  {!Astro.url.pathname.startsWith('/paquetes/') && <AvisoCookies />}


  <style is:global>
    @import '../styles/global.css';

    .cookie-banner {
      position: fixed;
      bottom: 16px;
      left: 16px;
      right: 16px;
      max-width: 540px;
      margin: 0 auto;
      z-index: 200;
      background: var(--nx-deep);
      border: 1px solid var(--nx-line-hover);
      border-radius: 18px;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      backdrop-filter: blur(20px);
      animation: cookie-slide 0.5s var(--nx-ease) 1s backwards;
    }
    @keyframes cookie-slide {
      from { transform: translateY(40px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .cookie-text {
      font-size: 0.88rem;
      color: var(--nx-ink-muted);
      line-height: 1.5;
    }
    .cookie-text strong { color: var(--nx-ink); display: block; margin-bottom: 0.2rem; }
    .cookie-actions {
      display: flex;
      gap: 0.6rem;
      justify-content: flex-end;
    }
    .cookie-btn { padding: 0.55rem 1rem !important; font-size: 0.85rem !important; }
    /* En movil el aviso ocupaba 258px: un tercio de la pantalla de un telefono,
       fijo y tapando la zona donde estan los botones de compra. Con el 83% del
       trafico de la campana entrando desde movil y un 79% yendose sin tocar
       nada, ese bloque es lo primero que ve y lo primero que estorba.
       Se compacta SIN quitar informacion ni esconder el rechazo: los dos
       botones siguen igual de visibles y del mismo tamano, uno al lado del
       otro en vez de apilados. (medido 13-sep-2026) */
    @media (max-width: 600px) {
      .cookie-banner {
        bottom: 8px;
        left: 8px;
        right: 8px;
        padding: 0.7rem 0.85rem;
        gap: 0.55rem;
        border-radius: 14px;
      }
      .cookie-text { font-size: 0.78rem; line-height: 1.35; }
      /* El titulo deja de robar una linea entera para el solo. */
      .cookie-text strong { display: inline; margin-bottom: 0; }
      .cookie-text br { display: none; }
      .cookie-actions { flex-direction: row; gap: 0.5rem; }
      /* Mitad y mitad para cada uno: aceptar no puede pesar mas que rechazar,
         ni al reves. Va con el aviso por delante en el selector porque la regla
         de arriba (.cookie-btn, linea ~192) lleva !important y si no, gana ella
         aunque esta venga despues. Comprobado midiendo: sin esto los botones
         salian de 135 y 118 px. */
      .cookie-banner .cookie-btn {
        flex: 1 1 0 !important;
        width: auto !important;
        justify-content: center;
        padding: 0.5rem 0.4rem !important;
        font-size: 0.78rem !important;
        white-space: nowrap;
      }
    }
  </style>
<script>
import "../scripts/gsap-animations.ts";
</script>
</body>
</html>
