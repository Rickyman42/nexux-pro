---
import Layout from './Layout.astro';
import CalculadoraCitas from '../components/CalculadoraCitas.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
  faq?: { q: string; a: string }[];
  slug: string;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  recommended?: { slug: string; title: string; description: string; tags: string[] }[];
  showCalculator?: boolean;
}

const {
  title,
  description,
  pubDate,
  author,
  tags,
  faq,
  slug,
  prevPost,
  nextPost,
  recommended,
  showCalculator = false,
} = Astro.props;

const dateStr = pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
const dateISO = pubDate.toISOString();
const canonical = `https://nexux.pro/blog/${slug}`;

const jsonld: object[] = [
  {
    '@type': 'Article',
    headline: title,
    description,
    datePublished: dateISO,
    dateModified: dateISO,
    author: { '@type': 'Organization', name: author, url: 'https://nexux.pro' },
    publisher: { '@id': 'https://nexux.pro/#org' },
    inLanguage: 'es',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://nexux.pro' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://nexux.pro/blog' },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];

if (faq && faq.length > 0) {
  jsonld.push({
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}

const jsonldString = JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonld });
---

<Layout title={`${title} | Nexux Pro`} description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={jsonldString} />

  <article class="blogpost section">
    <div class="container-nx blogpost-inner">
      <a href="/blog" class="back-link">&larr; Volver al blog</a>

      <div class="post-meta">
        <span class="eyebrow">Blog</span>
        <time datetime={dateISO} class="post-date">{dateStr}</time>
      </div>

      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}

      <h1 class="h-section">{title}</h1>
      <p class="lead">{description}</p>

      {showCalculator && <CalculadoraCitas />}

      <div class="post-body">
        <slot />
      </div>

      {faq && faq.length > 0 && (
        <section class="faq-section">
          <h2>Preguntas frecuentes</h2>
          {faq.map(({ q, a }) => (
            <div class="faq-item">
              <h3>{q}</h3>
              <p>{a}</p>
            </div>
          ))}
        </section>
      )}

      <div class="post-cta">
        <p>Pruébalo gratis 14 días. Sin tarjeta. Sin permanencia.</p>
        <a href="/prueba-gratis" class="btn-primary">Activa tu prueba &rarr;</a>
      </div>

      {(prevPost || nextPost) && (
        <nav class="post-nav">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="post-nav-link prev">
              <span class="nav-label">&larr; Anterior</span>
              <span class="nav-title">{prevPost.title}</span>
            </a>
          ) : <span />}
          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="post-nav-link next">
              <span class="nav-label">Siguiente &rarr;</span>
              <span class="nav-title">{nextPost.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}

      {recommended && recommended.length > 0 && (
        <section class="related-section">
          <h2>Te puede interesar</h2>
          <div class="related-grid">
            {recommended.map((rel) => (
              <a href={`/blog/${rel.slug}`} class="related-card">
                <h3>{rel.title}</h3>
                <p>{rel.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>

<style>
  .blogpost-inner {
    max-width: 720px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--nx-ink-muted);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: color 0.3s var(--nx-ease);
  }
  .back-link:hover { color: var(--nx-magnet); }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .post-date {
    font-family: var(--nx-font-mono);
    font-size: 0.8rem;
    color: var(--nx-ink-muted);
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .tag {
    font-family: var(--nx-font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--nx-magnet);
    background: var(--nx-magnet-halo);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }

  .blogpost h1 {
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--nx-ink-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .post-body {
    color: var(--nx-ink);
    line-height: 1.85;
  }
  .post-body :global(h2) {
    font-family: var(--nx-font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    margin: 2.5rem 0 1rem;
    color: var(--nx-ink);
  }
  .post-body :global(p) {
    margin-bottom: 1.25rem;
    color: var(--nx-ink-muted);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    color: var(--nx-ink-muted);
  }
  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-body :global(strong) {
    color: var(--nx-ink);
  }
  .post-body :global(a) {
    color: var(--nx-magnet);
    text-decoration: underline;
  }
  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--nx-line);
    margin: 2rem 0;
  }

  .faq-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--nx-line);
  }
  .faq-section h2 {
    font-family: var(--nx-font-serif);
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
  }
  .faq-item {
    margin-bottom: 1.5rem;
  }
  .faq-item h3 {
    font-size: 1.05rem;
    color: var(--nx-ink);
    margin-bottom: 0.4rem;
  }
  .faq-item p {
    color: var(--nx-ink-muted);
  }

  .post-cta {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--nx-deep);
    border: 1px solid var(--nx-line);
    border-radius: 18px;
    text-align: center;
  }
  .post-cta p {
    color: var(--nx-ink);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--nx-line);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--nx-line);
    border-radius: 14px;
    transition: border-color 0.3s var(--nx-ease);
  }
  .post-nav-link:hover { border-color: var(--nx-magnet); }
  .post-nav-link.next { text-align: right; }
  .nav-label {
    font-family: var(--nx-font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--nx-ink-faint);
  }
  .nav-title {
    font-size: 0.9rem;
    color: var(--nx-ink);
  }

  .related-section {
    margin-top: 2.5rem;
  }
  .related-section h2 {
    font-family: var(--nx-font-serif);
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .related-grid {
    display: grid;
    gap: 1rem;
  }
  .related-card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--nx-line);
    border-radius: 14px;
    transition: border-color 0.3s var(--nx-ease);
  }
  .related-card:hover { border-color: var(--nx-magnet); }
  .related-card h3 {
    font-size: 0.95rem;
    color: var(--nx-ink);
    margin-bottom: 0.4rem;
  }
  .related-card p {
    font-size: 0.85rem;
    color: var(--nx-ink-muted);
  }

  @media (max-width: 600px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-link.next { text-align: left; }
  }
</style>
