---
import CheckoutModal from '../components/CheckoutModal.astro';
import Layout from '../layouts/Layout.astro';

const canonical = 'https://nexux.pro/promo';
const title = 'Oferta Especial — 49€/mes | Nexux Pro';
const description = 'Precio de lanzamiento exclusivo para los primeros salones. Lara, tu asistente IA en WhatsApp 24h, gestiona citas automáticamente. 49€/mes en vez de 249€.';
---
<Layout title={title} description={description} canonical={canonical}>
  <main class="promo-page">

    <!-- HERO -->
    <section class="hero">
      <div class="badge-promo">🔥 PROMOCIÓN ESPECIAL — PLAZAS LIMITADAS</div>
      <h1>Lara trabaja en tu salón<br/><span class="accent">mientras tú atiendes</span></h1>
      <p class="sub">Tu asistente IA responde clientes por WhatsApp, gestiona citas y nunca deja un mensaje sin contestar — 24h al día, 7 días a la semana.</p>

      <div class="price-block">
        <span class="price-old">249€/mes</span>
        <div class="price-new">49<span class="price-sup">€/mes</span></div>
        <p class="price-note">Precio de lanzamiento para los primeros salones de Móstoles.<br/>Sin permanencia · Cancela cuando quieras · 30 días de garantía.</p>
      </div>

      <button class="btn-cta" onclick="openCheckout('promo')">Empezar ahora por 49€/mes</button>
      <p class="demo-link">¿Quieres verlo en acción primero? <a href="/demo">Ver demo gratis →</a></p>
    </section>

    <!-- QUÉ INCLUYE -->
    <section class="features">
      <h2>Qué incluye</h2>
      <div class="features-grid">
        <div class="feature-card">
          <span class="icon">💬</span>
          <h3>Lara responde por WhatsApp 24h</h3>
          <p>Responde al instante a cualquier hora. Nunca pierdes una clienta por no contestar.</p>
        </div>
        <div class="feature-card">
          <span class="icon">📅</span>
          <h3>Gestión de citas automática</h3>
          <p>Las citas van directas a tu Google Calendar. Tú solo apareces y trabajas.</p>
        </div>
        <div class="feature-card">
          <span class="icon">⏰</span>
          <h3>Recordatorios automáticos</h3>
          <p>Lara avisa a la clienta 24h y 1h antes. Los no-shows se reducen hasta un 60%.</p>
        </div>
        <div class="feature-card">
          <span class="icon">📊</span>
          <h3>Resumen diario</h3>
          <p>Cada día a las 21:00 recibes un resumen de citas. Sin abrir el móvil.</p>
        </div>
        <div class="feature-card">
          <span class="icon">⚡</span>
          <h3>Setup en 24h</h3>
          <p>Lo configuramos nosotros. Tú no tocas nada técnico. En 24h está funcionando.</p>
        </div>
        <div class="feature-card">
          <span class="icon">🛡️</span>
          <h3>30 días de garantía</h3>
          <p>Si en 30 días no ves el valor, te devolvemos el dinero. Sin preguntas.</p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="cta-final">
      <div class="urgency-box">
        <p class="urgency-text">⚡ Este precio es exclusivo para los <strong>primeros salones de Móstoles</strong>.<br/>Cuando se acaben las plazas, el precio vuelve a 249€/mes.</p>
      </div>
      <button class="btn-cta" onclick="openCheckout('promo')">Quiero Lara por 49€/mes</button>
      <p class="demo-link">¿Dudas? <a href="/demo">Mira la demo primero →</a> o escríbenos al <a href="https://wa.me/34600000000">WhatsApp</a></p>
    </section>

  </main>

  <CheckoutModal />
  <script>
    import '../scripts/checkout.ts';
  </script>
</Layout>

<style>
  .promo-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    color: var(--nx-text, #f0f0f0);
    font-family: var(--font-body, sans-serif);
  }

  /* HERO */
  .hero { text-align: center; padding: 3rem 0 2rem; }

  .badge-promo {
    display: inline-block;
    background: #ff4d4d;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.75} }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .accent { color: #4ECDC4; }

  .hero .sub {
    font-size: 1.1rem;
    color: #aaa;
    max-width: 560px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  /* PRICE */
  .price-block {
    background: rgba(78,205,196,0.06);
    border: 1px solid rgba(78,205,196,0.25);
    border-radius: 1rem;
    padding: 2rem;
    max-width: 420px;
    margin: 0 auto 2rem;
  }
  .price-old {
    display: block;
    text-decoration: line-through;
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }
  .price-new {
    font-size: 4rem;
    font-weight: 900;
    color: #4ECDC4;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .price-sup { font-size: 1.4rem; font-weight: 600; }
  .price-note {
    font-size: 0.85rem;
    color: #888;
    line-height: 1.5;
    margin: 0;
  }

  /* CTA */
  .btn-cta {
    display: inline-block;
    background: #4ECDC4;
    color: #0a0a0a;
    font-size: 1.1rem;
    font-weight: 700;
    padding: 0.9rem 2.5rem;
    border-radius: 0.6rem;
    border: none;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
    margin-bottom: 1rem;
  }
  .btn-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(78,205,196,0.35); }

  .demo-link { font-size: 0.9rem; color: #888; }
  .demo-link a { color: #4ECDC4; }

  /* FEATURES */
  .features { padding: 3rem 0; }
  .features h2 {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .feature-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }
  .feature-card .icon { font-size: 1.8rem; display: block; margin-bottom: 0.75rem; }
  .feature-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
  .feature-card p { font-size: 0.9rem; color: #999; line-height: 1.5; margin: 0; }

  /* CTA FINAL */
  .cta-final { text-align: center; padding: 3rem 0; }
  .urgency-box {
    background: rgba(255,77,77,0.08);
    border: 1px solid rgba(255,77,77,0.3);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    max-width: 520px;
    margin: 0 auto 2rem;
  }
  .urgency-text { font-size: 0.95rem; color: #ccc; line-height: 1.6; margin: 0; }
</style>
