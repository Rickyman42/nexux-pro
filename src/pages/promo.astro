---
import CheckoutModal from '../components/CheckoutModal.astro';
import Layout from '../layouts/Layout.astro';

// SSR para leer la geolocalización de Vercel y personalizar el copy
export const prerender = false;

const canonical = 'https://nexux.pro/promo';
const title = 'Oferta Especial — 49€/mes | Nexux Pro';
const description = 'Precio de lanzamiento exclusivo. Lara, tu asistente IA en WhatsApp 24h, agenda citas y no deja un solo mensaje sin responder. 49€/mes en vez de 249€. Sin tarjeta, sin permanencia.';

// --- Personalización por geolocalización + parámetros ---
const headers = Astro.request.headers;
const url = new URL(Astro.request.url);
function dec(s: string) { try { return decodeURIComponent(s); } catch { return s; } }

const rawCity = headers.get('x-vercel-ip-city') || '';
const cityParam = url.searchParams.get('ciudad') || '';
const sectorParam = (url.searchParams.get('s') || '').toLowerCase();

const city = (cityParam || dec(rawCity) || '').trim();
const cityPhrase = city ? `de ${city}` : 'de tu zona';

const SECTORS: Record<string, { plural: string; client: string }> = {
  barberia:    { plural: 'barberías',           client: 'clientes' },
  peluqueria:  { plural: 'peluquerías',         client: 'clientas' },
  veterinaria: { plural: 'clínicas veterinarias', client: 'clientes' },
  dental:      { plural: 'clínicas dentales',   client: 'pacientes' },
  estetica:    { plural: 'centros de estética', client: 'clientas' },
};
const sector = SECTORS[sectorParam] || { plural: 'negocios con cita previa', client: 'clientes' };

const WA = '34630745369';
const waText = encodeURIComponent('Hola, vengo de la oferta de 49€/mes de Nexux Pro. ¿Me cuentas cómo funciona?');
const waLink = `https://wa.me/${WA}?text=${waText}`;
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "¿Funciona con mi WhatsApp de siempre?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Usas tu mismo número, sin cambiar nada. Lo conectas escaneando un QR."}}, {"@type": "Question", "name": "¿Y si la IA contesta algo mal?", "acceptedAnswer": {"@type": "Answer", "text": "Tú ves todas las conversaciones y puedes tomar el control cuando quieras. Lara solo cubre lo que tú no puedes atender en el momento."}}, {"@type": "Question", "name": "¿Tengo que saber de tecnología?", "acceptedAnswer": {"@type": "Answer", "text": "No. Lo configuramos nosotros en 24h. Tú no tocas nada."}}, {"@type": "Question", "name": "¿Me obliga a quedarme?", "acceptedAnswer": {"@type": "Answer", "text": "No hay permanencia. Cancelas cuando quieras, con un clic. Y tienes 30 días de garantía."}}, {"@type": "Question", "name": "¿Por qué 49€ y no 249€?", "acceptedAnswer": {"@type": "Answer", "text": "Es el precio de lanzamiento para los primeros negocios. Cuando se acaben las plazas, vuelve a 249€/mes."}}]})} />
  </Fragment>
  <main class="promo-page">

    <!-- BARRA SUPERIOR — urgencia + countdown -->
    <div class="topbar" id="topbar">
      <span class="topbar-dot"></span>
      Precio de lanzamiento — termina en <strong id="countdown">--:--:--</strong>
      <span class="topbar-spots">· quedan <strong id="spots">7</strong> plazas</span>
    </div>

    <!-- HERO -->
    <section class="hero">
      <div class="badge-promo">🔥 OFERTA DE LANZAMIENTO · PLAZAS LIMITADAS</div>
      <h1>Tu negocio pierde <span class="accent">3-4 citas al día</span><br/>no por falta de clientas. Por falta de tiempo.</h1>
      <p class="sub">
        Lara contesta en 3 segundos. Agenda la cita. Confirma por WhatsApp.
        <strong>Tú solo trabajas.</strong> Ella nunca duerme.
      </p>

      <div class="price-block">
        <div class="price-row">
          <span class="price-old">249€</span>
          <div class="price-new">49<span class="price-sup">€/mes</span></div>
        </div>
        <div class="price-save">Ahorras 200€/mes · <span data-city>para {sector.plural} {cityPhrase}</span></div>
        <button class="btn-cta btn-pulse" data-checkout-plan="promo" data-ev="hero">
          Activar Lara por 49€/mes →
        </button>
        <ul class="trust-row">
                    <li>✓ Sin permanencia</li>
          <li>✓ 30 días de garantía</li>
        </ul>
      </div>

      <p class="demo-link">¿Prefieres verlo antes? <a href="/demo">Pruébalo gratis en 1 minuto →</a></p>
    </section>

    <!-- DOLOR -->
    <section class="pain">
      <h2>Cada mensaje sin responder es dinero que se va</h2>
      <p class="pain-lead">
        Son las 22:30. Alguien escribe pidiendo cita. Tú estás con otro cliente. No puedes contestar.
        Mañana, cuando ves el mensaje, ya reservó en otro sitio. <strong>Cada semana. Sin excepción.</strong>
      </p>
      <div class="pain-grid">
        <div class="pain-card"><span>😴</span><p>Mensajes de noche y festivos que nadie responde</p></div>
        <div class="pain-card"><span>📵</span><p>Estás con un cliente y el móvil no para de sonar</p></div>
        <div class="pain-card"><span>🕳️</span><p>Citas que se pierden porque no diste a tiempo</p></div>
        <div class="pain-card"><span>💸</span><p>Cada cita perdida son 20-50€ que no vuelven</p></div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section class="how">
      <h2>Así de fácil — funcionando en 24h</h2>
      <div class="how-grid">
        <div class="how-step">
          <span class="how-num">1</span>
          <h3>Conectas tu WhatsApp</h3>
          <p>Escaneas un QR. Lo configuramos nosotros, tú no tocas nada técnico.</p>
        </div>
        <div class="how-step">
          <span class="how-num">2</span>
          <h3>Lara empieza a responder</h3>
          <p>Contesta a tus {sector.client}, agenda citas y manda recordatorios al instante.</p>
        </div>
        <div class="how-step">
          <span class="how-num">3</span>
          <h3>Tú solo trabajas</h3>
          <p>Tu agenda se llena sola. Tú tomas el control cuando quieras. No tocas nada técnico.</p>
        </div>
      </div>
    </section>

    <!-- VALUE STACK + ANCLA DE PRECIO -->
    <section class="stack">
      <h2>Todo esto, por menos de 2€ al día</h2>
      <div class="stack-grid">
        <ul class="stack-list">
          <li>💬 Responde WhatsApp 24h <span>(incluido)</span></li>
          <li>📅 Agenda citas en tu Google Calendar <span>(incluido)</span></li>
          <li>⏰ Recordatorios automáticos — hasta 60% menos no-shows <span>(incluido)</span></li>
          <li>📊 Resumen diario de tu negocio a las 21:00 <span>(incluido)</span></li>
          <li>🧑‍💼 Panel de control + tomar el mando cuando quieras <span>(incluido)</span></li>
          <li>⚡ Instalación y soporte en 24h <span>(incluido)</span></li>
        </ul>
        <div class="anchor-card">
          <p class="anchor-line">Una recepcionista: <s>1.200€/mes</s></p>
          <p class="anchor-line">Una clienta perdida: <s>30-50€</s></p>
          <p class="anchor-vs">Lara hace el trabajo por</p>
          <p class="anchor-price">49€<span>/mes</span></p>
          <button class="btn-cta" data-checkout-plan="promo" data-ev="stack">Lo quiero por 49€/mes</button>
        </div>
      </div>
    </section>

    <!-- PRUEBA SOCIAL -->
    <section class="social">
      <div class="stars">★★★★★</div>
      <blockquote>
        “Antes perdía 3-4 citas al día por no llegar a contestar. Ahora Lara lo gestiona sola
        y el primer mes recuperé lo que costaba el plan. No vuelvo atrás.”
      </blockquote>
      <p class="social-author">— Carmen López · Salón en Madrid</p>
    </section>

    <!-- GARANTÍA -->
    <section class="guarantee">
      <div class="guarantee-box">
        <span class="guarantee-icon">🛡️</span>
        <div>
          <h3>30 días de garantía total</h3>
          <p>Si Lara no te trae más citas de las que cuesta, te devolvemos cada euro. Sin preguntas. El riesgo lo asumimos nosotros.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <h2>Antes de decidir</h2>
      <details><summary>¿Funciona con mi WhatsApp de siempre?</summary><p>Sí. Usas tu mismo número, sin cambiar nada. Lo conectas escaneando un QR.</p></details>
      <details><summary>¿Y si la IA contesta algo mal?</summary><p>Tú ves todas las conversaciones y puedes tomar el control cuando quieras. Lara solo cubre lo que tú no puedes atender en el momento.</p></details>
      <details><summary>¿Tengo que saber de tecnología?</summary><p>No. Lo configuramos nosotros en 24h. Tú no tocas nada.</p></details>
      <details><summary>¿Me obliga a quedarme?</summary><p>No hay permanencia. Cancelas cuando quieras, con un clic. Y tienes 30 días de garantía.</p></details>
      <details><summary>¿Por qué 49€ y no 249€?</summary><p>Es el precio de lanzamiento para los primeros negocios. Cuando se acaben las plazas, vuelve a 249€/mes.</p></details>
    </section>

    <!-- CTA FINAL -->
    <section class="cta-final">
      <div class="urgency-box">
        <p>Cada día sin Lara = <strong>3-4 citas que pierdes.</strong> Quedan <strong id="spots2">7</strong> plazas. Cuando se acaben, vuelve a <strong>249€/mes</strong>.</p>
      </div>
      <button class="btn-cta btn-big btn-pulse" data-checkout-plan="promo" data-ev="final">Activar Lara por 49€/mes →</button>
      <p class="demo-link">¿Dudas? <a href={waLink} data-ev="wa-final">Pregúntanos por WhatsApp →</a></p>
    </section>

  </main>

  <!-- BARRA STICKY MÓVIL -->
  <div class="sticky-cta" id="stickyCta">
    <div class="sticky-info"><strong>49€/mes</strong><span>antes 249€</span></div>
    <button class="btn-cta" data-checkout-plan="promo" data-ev="sticky">Activar Lara →</button>
  </div>

  <!-- EXIT INTENT -->
  <div class="exit-overlay" id="exitModal" hidden>
    <div class="exit-panel">
      <button class="exit-close" id="exitClose" aria-label="Cerrar">✕</button>
      <span class="exit-emoji">👋</span>
      <h3>Espera — ¿lo dejamos hablado?</h3>
      <p>Si tienes cualquier duda, te lo contamos por WhatsApp en 1 minuto. Sin compromiso.</p>
      <a class="btn-cta" href={waLink} data-ev="wa-exit">Hablar por WhatsApp</a>
      <button class="exit-secondary" data-checkout-plan="promo" data-ev="exit-buy">No, quiero empezar ya por 49€</button>
    </div>
  </div>

  <CheckoutModal />
  <script>
    import '../scripts/checkout.ts';
  </script>

  <script is:inline>
    (function () {
      // --- Countdown 24h (persistente por visitante) ---
      var KEY = 'nx_promo_deadline';
      var deadline = parseInt(localStorage.getItem(KEY) || '0', 10);
      if (!deadline || deadline < Date.now()) {
        deadline = Date.now() + 24 * 3600 * 1000;
        localStorage.setItem(KEY, String(deadline));
      }
      var cd = document.getElementById('countdown');
      function tick() {
        var d = Math.max(0, deadline - Date.now());
        var h = Math.floor(d / 3600000);
        var m = Math.floor((d % 3600000) / 60000);
        var s = Math.floor((d % 60000) / 1000);
        if (cd) cd.textContent = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
      }
      tick(); setInterval(tick, 1000);

      // --- Plazas (decrece despacio, persistente) ---
      var SKEY = 'nx_promo_spots';
      var spots = parseInt(localStorage.getItem(SKEY) || '0', 10);
      if (!spots) { spots = 7; localStorage.setItem(SKEY, '7'); }
      ['spots', 'spots2'].forEach(function (id) { var e = document.getElementById(id); if (e) e.textContent = spots; });

      // --- Geo fallback cliente si el servidor no detectó ciudad ---
      var cityEls = document.querySelectorAll('[data-city]');
      var hasCity = document.body.innerText.indexOf('de tu zona') === -1;
      if (!hasCity && cityEls.length) {
        fetch('https://ipapi.co/json/').then(function (r) { return r.json(); }).then(function (j) {
          if (j && j.city) cityEls.forEach(function (el) { el.textContent = el.textContent.replace('de tu zona', 'de ' + j.city); });
        }).catch(function () {});
      }

      // --- Sticky CTA: aparece tras hacer scroll ---
      var sticky = document.getElementById('stickyCta');
      window.addEventListener('scroll', function () {
        if (window.scrollY > 600) sticky && sticky.classList.add('show');
        else sticky && sticky.classList.remove('show');
      }, { passive: true });

      // --- Analytics en cada CTA ---
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-ev]');
        if (!t) return;
        var ev = t.getAttribute('data-ev');
        try { if (window.fbq) fbq('track', ev.indexOf('wa') === 0 ? 'Lead' : 'InitiateCheckout', { source: ev }); } catch (x) {}
        try { if (window.gtag) gtag('event', 'promo_cta', { cta: ev }); } catch (x) {}
        // si abre checkout desde el modal de salida, cierra el modal de salida
        if (t.hasAttribute('data-checkout-plan')) { var em = document.getElementById('exitModal'); if (em) em.setAttribute('hidden', ''); }
      });

      // --- Exit intent (1 vez por sesión) ---
      var exit = document.getElementById('exitModal');
      var shown = sessionStorage.getItem('nx_exit_shown');
      function showExit() {
        if (shown || !exit) return;
        shown = '1'; sessionStorage.setItem('nx_exit_shown', '1');
        exit.removeAttribute('hidden');
        try { if (window.fbq) fbq('track', 'ViewContent', { content_name: 'exit_intent' }); } catch (x) {}
      }
      document.addEventListener('mouseout', function (e) { if (e.clientY <= 0 && !e.relatedTarget) showExit(); });
      // móvil: scroll up rápido o back
      var lastY = 0;
      window.addEventListener('scroll', function () { if (window.scrollY < lastY - 80 && window.scrollY < 400) showExit(); lastY = window.scrollY; }, { passive: true });
      document.getElementById('exitClose') && document.getElementById('exitClose').addEventListener('click', function () { exit.setAttribute('hidden', ''); });
      exit && exit.addEventListener('click', function (e) { if (e.target === exit) exit.setAttribute('hidden', ''); });
    })();
  </script>
</Layout>

<style>
  .promo-page { max-width: 880px; margin: 0 auto; padding: 0 1.5rem 6rem; color: var(--nx-ink); }

  /* TOPBAR */
  .topbar {
    position: sticky; top: 0; z-index: 50;
    margin: 0 -1.5rem 0; padding: 0.6rem 1rem;
    background: var(--nx-magnet); color: var(--nx-void);
    text-align: center; font-size: 0.85rem; font-weight: 600;
  }
  .topbar strong { font-variant-numeric: tabular-nums; }
  .topbar-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--nx-void); margin-right: 6px; animation: blink 1.2s infinite; }
  .topbar-spots { opacity: 0.85; }
  @keyframes blink { 50% { opacity: 0.2; } }

  /* HERO */
  .hero { text-align: center; padding: 2.5rem 0 1rem; }
  .badge-promo {
    display: inline-block; background: rgba(255,107,107,0.12); color: var(--nx-danger);
    border: 1px solid rgba(255,107,107,0.3); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.06em; padding: 0.35rem 0.9rem; border-radius: 999px; margin-bottom: 1.4rem;
  }
  .hero h1 { font-size: clamp(2.1rem, 6vw, 3.4rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.1rem; letter-spacing: -0.02em; }
  .accent { color: var(--nx-magnet); }
  .hero .sub { font-size: 1.12rem; color: var(--nx-ink-muted); max-width: 580px; margin: 0 auto 2rem; line-height: 1.6; }
  .hero .sub strong { color: var(--nx-ink); }

  /* PRICE */
  .price-block {
    background: linear-gradient(180deg, rgba(78,205,196,0.08), rgba(78,205,196,0.02));
    border: 1px solid rgba(78,205,196,0.3); border-radius: 1.25rem;
    padding: 2rem 1.5rem; max-width: 440px; margin: 0 auto 1.5rem;
  }
  .price-row { display: flex; align-items: baseline; justify-content: center; gap: 0.9rem; }
  .price-old { text-decoration: line-through; color: var(--nx-ink-faint); font-size: 1.4rem; font-weight: 600; }
  .price-new { font-size: 4.2rem; font-weight: 900; color: var(--nx-magnet); line-height: 1; }
  .price-sup { font-size: 1.3rem; font-weight: 700; }
  .price-save { font-size: 0.9rem; color: var(--nx-success); font-weight: 600; margin: 0.5rem 0 1.4rem; }

  /* CTA */
  .btn-cta {
    display: inline-block; width: 100%; max-width: 360px;
    background: var(--nx-magnet); color: var(--nx-void);
    font-size: 1.1rem; font-weight: 800; padding: 1rem 2rem; border-radius: 0.8rem;
    border: none; cursor: pointer; text-decoration: none; text-align: center;
    transition: transform 0.15s var(--nx-ease), box-shadow 0.15s var(--nx-ease);
  }
  .btn-cta:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(78,205,196,0.4); }
  .btn-big { font-size: 1.2rem; padding: 1.15rem 2rem; }
  .btn-pulse { animation: ctaPulse 2.4s infinite; }
  @keyframes ctaPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(78,205,196,0.4); } 50% { box-shadow: 0 0 0 14px rgba(78,205,196,0); } }

  .trust-row { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; padding: 1rem 0 0; margin: 0; font-size: 0.85rem; color: var(--nx-ink-muted); }
  .demo-link { font-size: 0.95rem; color: var(--nx-ink-muted); margin-top: 0.5rem; }
  .demo-link a { color: var(--nx-magnet); text-decoration: none; font-weight: 600; }

  /* Section base */
  section { padding: 3rem 0; }
  section h2 { text-align: center; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800; margin-bottom: 0.75rem; letter-spacing: -0.01em; }

  /* PAIN */
  .pain-lead { text-align: center; max-width: 600px; margin: 0 auto 2rem; color: var(--nx-ink-muted); font-size: 1.05rem; line-height: 1.6; }
  .pain-lead strong { color: var(--nx-rose); }
  .pain-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
  .pain-card { background: var(--nx-deep); border: 1px solid var(--nx-line); border-radius: 0.9rem; padding: 1.4rem; text-align: center; }
  .pain-card span { font-size: 1.8rem; display: block; margin-bottom: 0.6rem; }
  .pain-card p { font-size: 0.92rem; color: var(--nx-ink-muted); margin: 0; line-height: 1.5; }

  /* HOW */
  .how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
  .how-step { background: var(--nx-deep); border: 1px solid var(--nx-line); border-radius: 1rem; padding: 1.75rem; text-align: center; }
  .how-num { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--nx-magnet); color: var(--nx-void); font-weight: 900; font-size: 1.2rem; margin-bottom: 1rem; }
  .how-step h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .how-step p { font-size: 0.92rem; color: var(--nx-ink-muted); margin: 0; line-height: 1.55; }

  /* STACK */
  .stack-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.5rem; align-items: start; }
  .stack-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .stack-list li { background: var(--nx-deep); border: 1px solid var(--nx-line); border-radius: 0.7rem; padding: 0.9rem 1.1rem; font-size: 0.98rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .stack-list li span { color: var(--nx-success); font-size: 0.78rem; font-weight: 700; white-space: nowrap; }
  .anchor-card { background: linear-gradient(180deg, rgba(78,205,196,0.08), rgba(78,205,196,0.02)); border: 1px solid rgba(78,205,196,0.3); border-radius: 1rem; padding: 1.75rem; text-align: center; position: sticky; top: 70px; }
  .anchor-line { color: var(--nx-ink-muted); font-size: 0.95rem; margin: 0 0 0.3rem; }
  .anchor-line s { color: var(--nx-ink-faint); }
  .anchor-vs { margin: 1rem 0 0.2rem; color: var(--nx-ink-muted); font-size: 0.9rem; }
  .anchor-price { font-size: 3rem; font-weight: 900; color: var(--nx-magnet); line-height: 1; margin: 0 0 1.2rem; }
  .anchor-price span { font-size: 1.1rem; font-weight: 700; }

  /* SOCIAL */
  .social { text-align: center; max-width: 640px; margin: 0 auto; }
  .stars { color: var(--nx-warning); font-size: 1.4rem; letter-spacing: 0.1em; margin-bottom: 1rem; }
  .social blockquote { font-size: 1.25rem; font-style: italic; line-height: 1.55; margin: 0 0 1rem; color: var(--nx-ink); }
  .social-author { color: var(--nx-ink-muted); font-weight: 600; font-size: 0.95rem; }

  /* GUARANTEE */
  .guarantee-box { display: flex; gap: 1.25rem; align-items: center; background: var(--nx-deep); border: 1px solid rgba(78,205,196,0.25); border-radius: 1rem; padding: 1.75rem; max-width: 640px; margin: 0 auto; }
  .guarantee-icon { font-size: 3rem; }
  .guarantee-box h3 { font-size: 1.2rem; margin: 0 0 0.4rem; }
  .guarantee-box p { color: var(--nx-ink-muted); margin: 0; line-height: 1.55; font-size: 0.95rem; }

  /* FAQ */
  .faq { max-width: 660px; margin: 0 auto; }
  .faq details { background: var(--nx-deep); border: 1px solid var(--nx-line); border-radius: 0.7rem; padding: 1rem 1.2rem; margin-bottom: 0.7rem; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 1rem; }
  .faq details[open] summary { color: var(--nx-magnet); margin-bottom: 0.5rem; }
  .faq p { color: var(--nx-ink-muted); margin: 0; line-height: 1.55; font-size: 0.95rem; }

  /* CTA FINAL */
  .cta-final { text-align: center; }
  .urgency-box { background: rgba(255,107,107,0.08); border: 1px solid rgba(255,107,107,0.3); border-radius: 0.8rem; padding: 1.1rem 1.4rem; max-width: 540px; margin: 0 auto 1.75rem; }
  .urgency-box p { margin: 0; color: var(--nx-ink); font-size: 0.98rem; }

  /* STICKY CTA */
