---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/Pain.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Proof from '../components/Proof.astro';
import Testimonials from '../components/Testimonials.astro';
import LaraWidget from '../components/LaraWidget.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <Hero />
  <Pain />
  <HowItWorks />
  <Pricing />
  <Proof />
  <Testimonials />
  <LaraWidget />
  <CheckoutModal />
  <section class="cities-nav">
    <div class="container-nx">
      <p class="cities-nav-label">Nexux Pro disponible en toda Espana:</p>
      <div class="cities-nav-links">
        {['Madrid', 'Barcelona', 'Valencia', 'Sevilla', 'Bilbao', 'Zaragoza'].map(ciudad => (
          <a href={`/ciudad/${ciudad.toLowerCase()}`} class="city-link">{ciudad}</a>
        ))}
      </div>
    </div>
  </section>
  <Footer />
  <script>
    import '../scripts/checkout.ts';
  </script>
</Layout>

<style>
  .cities-nav {
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--nx-line);
  }

  .cities-nav-label {
    color: var(--nx-ink-muted);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .cities-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .city-link {
    color: var(--nx-ink-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .city-link:hover {
    color: var(--nx-magnet);
  }
</style>
