---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Nexux Pro" description="Artículos sobre gestión de peluquerías, automatización de citas y comparativas de software para salones de belleza en España.">
  <section class="section blog-section">
    <div class="container-nx">
      <header class="blog-header">
        <span class="eyebrow">Blog</span>
        <h1 class="h-section">Nexux Pro</h1>
        <p class="text-muted blog-lead">Gestión, automatización y comparativas para peluquerías que no quieren perder más citas.</p>
      </header>

      <div class="blog-grid">
        {posts.map((post) => {
          const slug = post.id.replace(/\.md$/, '');
          return (
            <a href={`/blog/${slug}`} class="blog-card">
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="tag">{post.data.tags[0]}</span>
              )}
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc text-muted">{post.data.description}</p>
              <time class="card-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-section { padding-top: 8rem; }
  .blog-header { max-width: 640px; margin-bottom: 3rem; }
  .blog-header h1 { margin: 0.75rem 0 1rem; }
  .blog-lead { font-size: 1.1rem; line-height: 1.7; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border: 1px solid var(--nx-line);
    border-radius: 18px;
    background: var(--nx-deep);
    transition: border-color 0.3s var(--nx-ease), transform 0.3s var(--nx-ease);
  }
  .blog-card:hover {
    border-color: var(--nx-magnet);
    transform: translateY(-2px);
  }

  .tag {
    font-family: var(--nx-font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--nx-magnet);
    background: var(--nx-magnet-halo);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    align-self: flex-start;
  }

  .card-title {
    font-family: var(--nx-font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--nx-ink);
    line-height: 1.3;
  }
  .card-desc {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .card-date {
    font-family: var(--nx-font-mono);
    font-size: 0.75rem;
    color: var(--nx-ink-faint);
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>
