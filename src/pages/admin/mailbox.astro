---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const ADMIN_SECRET = import.meta.env.ADMIN_SECRET || 'nexux-admin-2026';
const PI_URL = import.meta.env.NEXUX_CLIENTS_URL || 'https://pi.nexux.pro';
const PROVISION_SECRET = import.meta.env.MAILBOX_PI_SECRET || 'nexux-wa-trial-2026';

const cookieSecret = Astro.cookies.get('nexux_admin')?.value;
const urlSecret = Astro.url.searchParams.get('s');
const authed = urlSecret === ADMIN_SECRET || cookieSecret === ADMIN_SECRET;

if (urlSecret === ADMIN_SECRET && cookieSecret !== ADMIN_SECRET) {
  Astro.cookies.set('nexux_admin', ADMIN_SECRET, {
    httpOnly: true,
    secure: true,
    sameSite: 'strict',
    maxAge: 86400 * 7,
    path: '/admin',
  });
}

if (!authed) {
  return new Response('Unauthorized — go to /admin?s=YOUR_SECRET first', { status: 401 });
}

type MailEvent = {
  id: string;
  ts: string;
  direction: 'inbound' | 'outbound';
  source: string;
  status: string;
  provider: string;
  from?: { email?: string; name?: string };
  to?: Array<{ email?: string; name?: string }>;
  subject: string;
  preview: string;
  text?: string;
  html?: string;
  meta?: Record<string, unknown>;
};

type MailStatus = {
  mailbox?: {
    total: number;
    inbound: number;
    outbound: number;
    lastEventAt: string | null;
  };
  improvmx?: {
    domain: string;
    alias: string;
    hasApiKey: boolean;
    webhookUrl: string;
    targetEmail?: string;
    sync?: {
      lastRunAt?: string;
      lastAdded?: number;
    } | null;
  };
};

const direction = Astro.url.searchParams.get('direction') || 'all';
const q = Astro.url.searchParams.get('q') || '';
const params = new URLSearchParams({ key: PROVISION_SECRET, limit: '300' });
if (direction === 'inbound' || direction === 'outbound') params.set('direction', direction);
if (q) params.set('q', q);

let events: MailEvent[] = [];
let status: MailStatus | null = null;
let fetchError = '';
let sendNotice = '';
let sendNoticeType: 'ok' | 'error' = 'ok';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const payload = {
      to: String(form.get('to') || ''),
      subject: String(form.get('subject') || ''),
      text: String(form.get('text') || ''),
    };
    const sendResp = await fetch(`${PI_URL}/mailbox/send`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-provision-secret': PROVISION_SECRET },
      body: JSON.stringify(payload),
    });
    if (sendResp.ok) {
      sendNotice = 'Correo enviado y registrado en la bandeja.';
      sendNoticeType = 'ok';
    } else {
      const data = await sendResp.json().catch(() => ({}));
      sendNotice = `No se pudo enviar: ${data.error || sendResp.status}`;
      sendNoticeType = 'error';
    }
  } catch (err: any) {
    sendNotice = err?.message || 'No se pudo enviar el correo.';
    sendNoticeType = 'error';
  }
}

try {
  const [eventsResp, statusResp] = await Promise.all([
    fetch(`${PI_URL}/mailbox/events?${params.toString()}`, {
      headers: { 'x-provision-secret': PROVISION_SECRET },
    }),
    fetch(`${PI_URL}/mailbox/status?key=${encodeURIComponent(PROVISION_SECRET)}`, {
      headers: { 'x-provision-secret': PROVISION_SECRET },
    }),
  ]);
  if (eventsResp.ok) {
    const data = await eventsResp.json();
    events = data.events || [];
  } else {
    fetchError = `Pi respondio ${eventsResp.status}`;
  }
  if (statusResp.ok) {
    status = await statusResp.json();
  }
} catch (err: any) {
  fetchError = err?.message || 'Error cargando mailbox';
}

if (!status) {
  try {
    const statusResp = await fetch(`${PI_URL}/mailbox/status?key=${encodeURIComponent(PROVISION_SECRET)}`, {
      headers: { 'x-provision-secret': PROVISION_SECRET },
    });
    if (statusResp.ok) status = await statusResp.json();
  } catch {}
}

const fmtDate = (iso: string) => new Date(iso).toLocaleString('es-ES', {
  timeZone: 'Europe/Madrid',
  day: '2-digit',
  month: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
});

const recipientText = (event: MailEvent) => {
  if (event.direction === 'inbound') return event.from?.email || 'desconocido';
  return (event.to || []).map(r => r.email).filter(Boolean).join(', ') || 'sin destinatario';
};
---

<Layout title="Admin Mailbox — Nexux Pro">
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
    <style>
      body { background: #0a0a0f; color: #e8e8f0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 30px 16px 64px; }
      .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 20px; }
      .back { color: #7b7b96; text-decoration: none; font-size: 13px; }
      .back:hover { color: #4ECDC4; }
      h1 { color: #4ECDC4; font-size: 22px; margin: 8px 0 4px; }
      .sub { color: #73738f; font-size: 13px; margin: 0; }
      .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 18px 0 22px; }
      .filters a, .filters button { background: #12121a; border: 1px solid #24243a; color: #e8e8f0; border-radius: 8px; padding: 9px 12px; font-size: 13px; text-decoration: none; cursor: pointer; }
      .filters a.active { border-color: #4ECDC4; color: #4ECDC4; }
      .filters input { min-width: 240px; background: #0d0d14; border: 1px solid #24243a; color: #e8e8f0; border-radius: 8px; padding: 9px 11px; font-size: 13px; }
      .mail-list { display: grid; gap: 8px; }
      .status-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 18px 0 8px; }
      .status-card { background: #12121a; border: 1px solid #1f1f31; border-radius: 8px; padding: 12px 14px; min-height: 62px; }
      .status-label { color: #71718d; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; margin: 0 0 6px; }
      .status-value { color: #e8e8f0; font-size: 14px; font-weight: 700; margin: 0; overflow-wrap: anywhere; }
      .status-value.ok { color: #50e3b8; }
      .status-value.warn { color: #fbbf24; }
      .status-note { color: #85859f; font-size: 12px; line-height: 1.4; margin: 8px 0 0; }
      .compose { background: #12121a; border: 1px solid #1f1f31; border-radius: 8px; padding: 14px; margin: 18px 0; }
      .compose-title { color: #e8e8f0; font-size: 14px; font-weight: 800; margin: 0 0 12px; }
      .compose-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .compose label { color: #71718d; display: grid; gap: 6px; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
      .compose input, .compose textarea { background: #0d0d14; border: 1px solid #24243a; border-radius: 8px; color: #e8e8f0; font: inherit; padding: 10px 11px; }
      .compose textarea { min-height: 120px; resize: vertical; }
      .compose .wide { grid-column: 1 / -1; }
      .compose button { align-self: end; background: #4ECDC4; border: 0; border-radius: 8px; color: #071010; cursor: pointer; font-size: 13px; font-weight: 800; padding: 10px 14px; }
      .notice { border-radius: 8px; font-size: 13px; margin: 10px 0 0; padding: 10px 12px; }
      .notice.ok { background: #073326; color: #50e3b8; }
      .notice.error { background: #331018; color: #f87171; }
      .mail { display: grid; grid-template-columns: 116px minmax(150px, 230px) 1fr 92px; gap: 14px; align-items: start; background: #12121a; border: 1px solid #1f1f31; border-radius: 8px; padding: 13px 14px; }
      .mail:hover { border-color: #34344f; }
      .badge { display: inline-flex; align-items: center; justify-content: center; min-width: 72px; padding: 3px 8px; border-radius: 999px; font-size: 11px; font-weight: 800; text-transform: uppercase; }
      .inbound .badge { background: #073326; color: #50e3b8; }
      .outbound .badge { background: #101f46; color: #8eb2ff; }
      .person { color: #b6b6ca; font-size: 12px; overflow-wrap: anywhere; }
      .subject { font-size: 14px; font-weight: 700; margin: 0 0 5px; }
      .preview { color: #8989a3; font-size: 13px; line-height: 1.4; margin: 0; }
      .meta { color: #666680; font-size: 11px; text-align: right; }
      details.mail-detail { margin-top: 10px; border-top: 1px solid #24243a; padding-top: 10px; }
      details.mail-detail summary { color: #4ECDC4; cursor: pointer; font-size: 12px; font-weight: 700; list-style: none; }
      details.mail-detail summary::-webkit-details-marker { display: none; }
      .mail-body { margin: 10px 0 0; background: #0d0d14; border: 1px solid #24243a; border-radius: 8px; padding: 12px; color: #c9c9d8; font-size: 12px; line-height: 1.5; white-space: pre-wrap; overflow-x: auto; }
      .mail-technical { margin-top: 8px; color: #666680; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; overflow-wrap: anywhere; }
      .empty, .error { background: #12121a; border: 1px solid #24243a; border-radius: 8px; padding: 24px; color: #8b8ba4; }
      .error { color: #f87171; border-color: #5a1f2a; }
      @media (max-width: 760px) {
        .topbar { display: block; }
        .status-grid { grid-template-columns: 1fr; }
        .compose-grid { grid-template-columns: 1fr; }
        .mail { grid-template-columns: 1fr; gap: 8px; }
        .meta { text-align: left; }
        .filters input { width: 100%; min-width: 0; }
      }
    </style>
  </Fragment>

  <main class="wrap">
    <div class="topbar">
      <div>
        <a class="back" href="/admin">← Panel admin</a>
        <h1>Mailbox</h1>
        <p class="sub">Correos enviados por Brevo y entradas registradas para info@nexux.pro.</p>
      </div>
      <p class="sub">{events.length} eventos</p>
    </div>

    <section class="status-grid" aria-label="Estado del mailbox">
      <div class="status-card">
        <p class="status-label">Correo</p>
        <p class="status-value">{status?.improvmx?.targetEmail || `${status?.improvmx?.alias || 'info'}@${status?.improvmx?.domain || 'nexux.pro'}`}</p>
      </div>
      <div class="status-card">
        <p class="status-label">Eventos</p>
        <p class="status-value">{status?.mailbox?.total ?? events.length} total · {status?.mailbox?.inbound ?? 0} recibidos · {status?.mailbox?.outbound ?? 0} enviados</p>
      </div>
      <div class="status-card">
        <p class="status-label">ImprovMX API</p>
        <p class={`status-value ${status?.improvmx?.hasApiKey ? 'ok' : 'warn'}`}>{status?.improvmx?.hasApiKey ? 'Conectada' : 'Falta API key'}</p>
      </div>
      <div class="status-card">
        <p class="status-label">Última sync</p>
        <p class="status-value">{status?.improvmx?.sync?.lastRunAt ? fmtDate(status.improvmx.sync.lastRunAt) : 'Sin ejecutar'}</p>
      </div>
    </section>
    {!status?.improvmx?.hasApiKey ? (
      <p class="status-note">Para activar recibidos reales: confirmar dominio, añadir IMPROVMX_API_KEY en la Pi y ejecutar el configurador de ImprovMX.</p>
    ) : null}

    <section class="compose" aria-label="Enviar correo">
      <p class="compose-title">Enviar correo</p>
      <form method="post" class="compose-grid">
        <label>
          Para
          <input type="email" name="to" placeholder="cliente@salon.com" required />
        </label>
        <label>
          Asunto
          <input type="text" name="subject" placeholder="Asunto" required />
        </label>
        <label class="wide">
          Mensaje
          <textarea name="text" placeholder="Escribe el mensaje..." required></textarea>
        </label>
        <button type="submit">Enviar</button>
      </form>
      {sendNotice ? <p class={`notice ${sendNoticeType}`}>{sendNotice}</p> : null}
    </section>

    <form class="filters" method="get">
      <a class={direction === 'all' ? 'active' : ''} href="/admin/mailbox">Todos</a>
      <a class={direction === 'outbound' ? 'active' : ''} href="/admin/mailbox?direction=outbound">Enviados</a>
      <a class={direction === 'inbound' ? 'active' : ''} href="/admin/mailbox?direction=inbound">Recibidos</a>
      {direction !== 'all' ? <input type="hidden" name="direction" value={direction} /> : null}
      <input type="search" name="q" value={q} placeholder="Buscar asunto, email o texto" />
      <button type="submit">Buscar</button>
    </form>

    {fetchError ? (
      <div class="error">{fetchError}</div>
    ) : events.length === 0 ? (
      <div class="empty">Todavia no hay correos para este filtro.</div>
    ) : (
      <section class="mail-list">
        {events.map(event => (
          <article class={`mail ${event.direction}`}>
            <div>
              <span class="badge">{event.direction === 'inbound' ? 'Recibido' : 'Enviado'}</span>
            </div>
            <div class="person">{recipientText(event)}</div>
            <div>
              <p class="subject">{event.subject || '(sin asunto)'}</p>
              <p class="preview">{event.preview || ''}</p>
              <details class="mail-detail">
                <summary>Ver contenido</summary>
                <pre class="mail-body">{event.text || event.preview || '(sin contenido de texto)'}</pre>
                <div class="mail-technical">
                  ID: {event.id}<br />
                  Provider: {event.provider} · Source: {event.source}
                </div>
              </details>
            </div>
            <div class="meta">
              <div>{fmtDate(event.ts)}</div>
              <div>{event.status}</div>
              <div>{event.source}</div>
            </div>
          </article>
        ))}
      </section>
    )}
  </main>
</Layout>
