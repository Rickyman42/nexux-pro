---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import LaraWidget from '../components/LaraWidget.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="7 días gratis con Lara — Nexux Pro"
  description="Prueba Lara gratis 7 días. Tu asistente IA responde WhatsApp y gestiona citas 24h. Sin tarjeta, sin permanencia. Activa en minutos."
  canonical="https://nexux.pro/prueba-gratis"
>
  <Nav />

  <section class="pg-hero">
    <div class="pg-orb pg-orb-1" aria-hidden="true"></div>
    <div class="pg-orb pg-orb-2" aria-hidden="true"></div>

    <div class="container-nx pg-grid">

      <!-- LEFT: COPY -->
      <div class="pg-copy">
        <div class="pg-eyebrow">
          <span class="pg-dot"></span>
          Oferta exclusiva · Sin tarjeta · Cancela cuando quieras
        </div>

        <h1 class="h-display pg-title">
          Lara en tu negocio<br/>
          <em>7 días gratis.</em>
        </h1>

        <p class="pg-sub">
          Tu asistente IA responde por WhatsApp <strong>las 24h</strong>, agenda citas y manda recordatorios automáticos. Sin apps nuevas. Sin contratar a nadie.
        </p>

        <div class="pg-price-anchor">
          <div class="pg-price-free">Gratis</div>
          <div class="pg-price-detail">
            <span class="pg-price-after">después 249€/mes</span>
            <span class="pg-price-cancel">cancela cuando quieras</span>
          </div>
        </div>

        <button class="btn-primary pg-cta" id="prueba-open-lara">
          Quiero mis 7 días gratis
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>

        <p class="pg-disclaimer">Sin tarjeta · Sin permanencia · Activa en minutos</p>

        <div class="pg-trust">
          <div class="pg-trust-item">
            <div class="pg-trust-num">24<span>h</span></div>
            <div class="pg-trust-label">Responde sola</div>
          </div>
          <div class="pg-trust-sep"></div>
          <div class="pg-trust-item">
            <div class="pg-trust-num">&lt;5<span>seg</span></div>
            <div class="pg-trust-label">Respuesta media</div>
          </div>
          <div class="pg-trust-sep"></div>
          <div class="pg-trust-item">
            <div class="pg-trust-num">0<span>€</span></div>
            <div class="pg-trust-label">7 días</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: PHONE DEMO + FEATURES -->
      <div class="pg-right">
        <div class="pg-phone-wrap">
          <div class="phone">
            <div class="phone-screen">
              <div class="chat-header">
                <div class="chat-avatar">L</div>
                <div class="chat-meta">
                  <div class="chat-name">Lara · Tu Negocio</div>
                  <div class="chat-status"><span class="online-dot"></span> activa ahora</div>
                </div>
              </div>
              <div class="chat-body" id="pg-chat-stage"></div>
              <div class="chat-input-bar" aria-hidden="true"><span>Escribe un mensaje...</span></div>
            </div>
            <div class="phone-notch" aria-hidden="true"></div>
          </div>
          <div class="pg-float pg-float-1">
            <span>📅</span>
            <div>
              <div class="pg-float-title">Cita agendada</div>
              <div class="pg-float-sub">hace 3 segundos</div>
            </div>
          </div>
          <div class="pg-float pg-float-2">
            <span>💬</span>
            <div>
              <div class="pg-float-title">Lara responde</div>
              <div class="pg-float-sub">mientras tú trabajas</div>
            </div>
          </div>
        </div>

        <div class="pg-features">
          <div class="pg-feat">
            <div class="pg-feat-icon">💬</div>
            <strong>WhatsApp 24h sin app nueva</strong>
            <span>Desde tu número actual</span>
          </div>
          <div class="pg-feat">
            <div class="pg-feat-icon">📅</div>
            <strong>Agenda automática</strong>
            <span>Sin errores ni dobles reservas</span>
          </div>
          <div class="pg-feat">
            <div class="pg-feat-icon">🔔</div>
            <strong>Recordatorios automáticos</strong>
            <span>Cero no-shows</span>
          </div>
          <div class="pg-feat">
            <div class="pg-feat-icon">📊</div>
            <strong>Resumen diario</strong>
            <span>Todo tu negocio de un vistazo</span>
          </div>
        </div>
      </div>

    </div>
    <div class="pg-fadeline" aria-hidden="true"></div>
  </section>

  <LaraWidget trial={true} />
  <Footer />
</Layout>

<script is:inline>
(function() {
  var params = new URLSearchParams(location.search);
  if (params.get('ref') === 'email') {
    setTimeout(function() {
      var l = document.getElementById('lara-launcher');
      if (l) l.click();
    }, 1500);
  }
  document.getElementById('prueba-open-lara').addEventListener('click', function() {
    var l = document.getElementById('lara-launcher');
    if (l) l.click();
  });

  var messages = [
    { who: 'user', text: 'Hola, quiero cita para el viernes', delay: 700 },
    { who: 'bot', text: '¡Hola! 😊 Tengo hueco el viernes a las 10:00 y a las 16:30. ¿Cuál te viene mejor?', delay: 1400, typing: 1000 },
    { who: 'user', text: 'A las 10 perfecto', delay: 1300 },
    { who: 'bot', text: '✨ Reservada. Viernes 10:00 con María. Te mando recordatorio el jueves. ¡Hasta el viernes!', delay: 1500, typing: 1100 },
  ];

  function el(tag, cls, html) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (html !== undefined) e.innerHTML = html;
    return e;
  }

  async function playChat() {
    var stage = document.getElementById('pg-chat-stage');
    if (!stage) return;
    stage.innerHTML = '';
    for (var m of messages) {
      await new Promise(function(r) { setTimeout(r, m.delay); });
      if (m.who === 'bot' && m.typing) {
        var typing = el('div', 'msg msg-bot msg-typing', '<span></span><span></span><span></span>');
        stage.appendChild(typing);
        stage.scrollTop = stage.scrollHeight;
        await new Promise(function(r) { setTimeout(r, m.typing); });
        typing.remove();
      }
      var bubble = el('div', 'msg msg-' + m.who, m.text);
      bubble.style.animation = 'fade-in-up 0.4s var(--nx-ease) forwards';
      stage.appendChild(bubble);
      stage.scrollTop = stage.scrollHeight;
    }
    await new Promise(function(r) { setTimeout(r, 3500); });
    playChat();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', playChat);
  } else {
    playChat();
  }
})();
</script>

<style>
  .pg-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
    overflow: hidden;
  }
  .pg-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; z-index: 0; }
  .pg-orb-1 { width: 520px; height: 520px; background: radial-gradient(circle, rgba(78,205,196,0.20) 0%, transparent 70%); top: -120px; left: -180px; }
  .pg-orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(232,165,152,0.10) 0%, transparent 70%); bottom: -150px; right: -150px; }

  .pg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  @media (min-width: 1024px) { .pg-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }

  .pg-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    padding: 0.4rem 0.9rem;
    background: var(--nx-magnet-halo);
    border: 1px solid rgba(78,205,196,0.2);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--nx-magnet);
  }
  .pg-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--nx-magnet); animation: pulse-glow 2s infinite; flex-shrink: 0; }
  .pg-title { margin-bottom: 1.5rem; }
  .pg-sub { font-size: clamp(1rem, 1.4vw, 1.15rem); color: var(--nx-ink-muted); line-height: 1.7; max-width: 500px; margin-bottom: 2rem; }
  .pg-sub strong { color: var(--nx-ink); font-weight: 600; }

  .pg-price-anchor {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding: 1rem 1.25rem;
    background: var(--nx-surface);
    border: 1px solid var(--nx-line);
    border-radius: 14px;
    max-width: 320px;
  }
  .pg-price-free { font-size: 2rem; font-weight: 800; color: var(--nx-magnet); font-family: var(--nx-font-serif); font-style: italic; line-height: 1; }
  .pg-price-after { display: block; font-size: 0.8rem; color: var(--nx-ink-muted); text-decoration: line-through; }
  .pg-price-cancel { display: block; font-size: 0.73rem; color: var(--nx-magnet); font-weight: 600; margin-top: 0.15rem; }

  .pg-cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; font-size: 1rem; }
  .pg-disclaimer { font-size: 0.78rem; color: var(--nx-ink-faint); margin: 0 0 2.5rem; }

  .pg-trust { display: flex; align-items: center; gap: 1.25rem; padding-top: 2rem; border-top: 1px solid var(--nx-line); flex-wrap: wrap; }
  .pg-trust-num { font-family: var(--nx-font-serif); font-size: 1.65rem; line-height: 1; color: var(--nx-magnet); }
  .pg-trust-num span { font-size: 0.9rem; color: var(--nx-ink-muted); margin-left: 0.1rem; }
  .pg-trust-label { font-size: 0.75rem; color: var(--nx-ink-muted); margin-top: 0.3rem; }
  .pg-trust-sep { width: 1px; height: 30px; background: var(--nx-line); }

  .pg-right { display: flex; flex-direction: column; gap: 2rem; align-items: center; }
  @media (min-width: 1024px) { .pg-right { align-items: flex-start; } }

  .pg-phone-wrap { position: relative; perspective: 1200px; }
  .phone {
    width: 300px; height: 540px;
    background: linear-gradient(155deg, #1c2029, #0f1218);
    border-radius: 36px;
    padding: 11px;
    box-shadow: 0 60px 80px -30px rgba(0,0,0,0.7), 0 0 0 1px rgba(78,205,196,0.18), inset 0 0 0 1px rgba(255,255,255,0.04);
    position: relative;
    transform: rotate(-2deg);
    animation: phone-float 6s ease-in-out infinite;
  }
  @keyframes phone-float {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(-2deg) translateY(-10px); }
  }
  .phone-screen { width: 100%; height: 100%; background: #0d1015; border-radius: 27px; overflow: hidden; display: flex; flex-direction: column; }
  .phone-notch { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); width: 90px; height: 20px; background: #000; border-radius: 999px; z-index: 2; }
  .chat-header { display: flex; align-items: center; gap: 0.65rem; padding: 2.4rem 0.9rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.04); background: linear-gradient(180deg, rgba(78,205,196,0.06), transparent); }
  .chat-avatar { width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep)); color: var(--nx-void); display: grid; place-items: center; font-family: var(--nx-font-serif); font-style: italic; font-size: 1.1rem; font-weight: 500; }
  .chat-name { font-size: 0.82rem; font-weight: 600; color: var(--nx-ink); }
  .chat-status { font-size: 0.68rem; color: var(--nx-ink-muted); display: flex; align-items: center; gap: 0.25rem; margin-top: 0.1rem; }
  .online-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--nx-success); box-shadow: 0 0 6px var(--nx-success); }
  .chat-body { flex: 1; padding: 0.85rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.45rem; }
  .chat-body::-webkit-scrollbar { width: 0; }
  .chat-input-bar { padding: 0.65rem 0.9rem; border-top: 1px solid rgba(255,255,255,0.04); color: var(--nx-ink-faint); font-size: 0.75rem; }
  .msg { padding: 0.5rem 0.8rem; border-radius: 14px; font-size: 0.79rem; line-height: 1.45; max-width: 82%; opacity: 0; transform: translateY(8px); }
  .msg-user { background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep)); color: var(--nx-void); align-self: flex-end; border-bottom-right-radius: 3px; font-weight: 500; }
  .msg-bot { background: rgba(255,255,255,0.06); color: var(--nx-ink); align-self: flex-start; border-bottom-left-radius: 3px; }
  .msg-typing { background: rgba(255,255,255,0.06); align-self: flex-start; border-bottom-left-radius: 3px; display: flex; gap: 0.22rem; align-items: center; padding: 0.65rem 0.9rem; opacity: 1; transform: translateY(0); }
  .msg-typing span { width: 5px; height: 5px; border-radius: 50%; background: var(--nx-ink-muted); animation: typing-bounce 1.2s infinite; }
  .msg-typing span:nth-child(2) { animation-delay: 0.2s; }
  .msg-typing span:nth-child(3) { animation-delay: 0.4s; }

  .pg-float { position: absolute; background: var(--nx-deep); border: 1px solid var(--nx-line-hover); border-radius: 12px; padding: 0.6rem 0.85rem; display: flex; align-items: center; gap: 0.6rem; font-size: 1.1rem; box-shadow: 0 20px 40px -15px rgba(0,0,0,0.5); animation: float-bob 4s ease-in-out infinite; }
  .pg-float-1 { top: 10%; right: -14%; animation-delay: 0s; }
  .pg-float-2 { bottom: 12%; left: -16%; animation-delay: 2s; }
  @keyframes float-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  .pg-float-title { font-size: 0.76rem; color: var(--nx-ink); font-weight: 600; }
  .pg-float-sub { font-size: 0.67rem; color: var(--nx-ink-muted); margin-top: 0.1rem; }

  .pg-features { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; width: 100%; max-width: 340px; }
  .pg-feat { background: var(--nx-surface); border: 1px solid var(--nx-line); border-radius: 12px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; transition: border-color 0.2s; }
  .pg-feat:hover { border-color: rgba(78,205,196,0.35); }
  .pg-feat-icon { font-size: 1.2rem; }
  .pg-feat strong { font-size: 0.8rem; color: var(--nx-ink); font-weight: 600; line-height: 1.3; }
  .pg-feat span { font-size: 0.72rem; color: var(--nx-ink-muted); }

  .pg-fadeline { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60%; height: 1px; background: linear-gradient(90deg, transparent, var(--nx-magnet), transparent); opacity: 0.4; }

  @media (max-width: 768px) {
    .pg-hero { padding: 6rem 0 3rem; }
    .phone { width: 260px; height: 470px; }
    .pg-float-1 { right: -2%; }
    .pg-float-2 { left: -2%; }
    .pg-features { max-width: 100%; }
  }
</style>
