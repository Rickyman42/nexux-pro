---
import CheckoutModal from '../../components/CheckoutModal.astro';
import LaraWidget from '../../components/LaraWidget.astro';
import PlanDetail from '../../components/PlanDetail.astro';
import ProductExploded from '../../components/ProductExploded.astro';
import { planEntries, type PlanData, type PlanSlug } from '../../data/plans';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;
export function getStaticPaths() {
  return planEntries.map(([slug, plan]) => ({
    params: { plan: slug },
    props: { slug, plan },
  }));
}

const { slug, plan } = Astro.props as { slug: PlanSlug; plan: PlanData };
const canonical = `https://nexux.pro/paquetes/${slug}`;
const title = 'Recepcionista IA para negocios | Nexux';
const description = `Recepcionista IA para WhatsApp, Telegram y web que responde mensajes y reserva citas en tu calendario. ${plan.price} €/mes, sin permanencia y con 30 días de garantía.`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: plan.faqs.map((faq: { q: string; a: string }) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: plan.name,
  description: plan.sub,
  brand: { '@type': 'Brand', name: 'Nexux' },
  // Google exige imagen para la ficha de comerciante; sin ella el elemento sale "no valido" en Search Console.
  image: ['https://nexux.pro/img/demo-crm.png'],
  offers: {
    '@type': 'Offer',
    price: plan.price,
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: plan.price,
      priceCurrency: 'EUR',
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
    },
    availability: 'https://schema.org/InStock',
    url: canonical,
    // Los 30 dias de garantia: si no encaja, se devuelve el dinero sin preguntas.
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'ES',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 30,
      returnFees: 'https://schema.org/FreeReturn',
    },
  },
};
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)}></script>
  </Fragment>
  <PlanDetail plan={plan} slug={slug} />
  <ProductExploded />
  <LaraWidget />
  <CheckoutModal />
  <script>
    import '../../scripts/checkout.ts';
  </script>
</Layout>
