    }
    .ob-w-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(42,157,151,0.42), 0 2px 6px rgba(0,0,0,0.12);
    }
    .ob-w-arrow {
      transition: transform 0.2s ease;
      flex-shrink: 0;
    }
    .ob-w-cta:hover .ob-w-arrow {
      animation: ob-arrow-bounce 0.6s ease infinite;
    }
    .ob-w-skip {
      animation: ob-fade-up 0.5s ease both;
      animation-delay: 0.6s;
      opacity: 0;
    }
    /* Canal guide ordered list */
    .ob-guide-ol {
      margin: 0.4rem 0 0.4rem 1.2rem;
