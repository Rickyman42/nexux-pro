    .ob-w-brand { font-size: 0.72rem; font-weight: 400; color: var(--ob-muted); }
    .ob-w-brand strong { color: var(--ob-accent); font-weight: 700; }
    .ob-w-name {
      font-size: 2.4rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: var(--ob-text);
      margin: 0 0 0.75rem;
      animation: ob-fade-up 0.5s ease both;
      animation-delay: 0.2s;
      opacity: 0;
    }
    .ob-w-sub {
      margin: 0 0 1.25rem;
      line-height: 1.6;
      animation: ob-fade-up 0.5s ease both;
      animation-delay: 0.28s;
      opacity: 0;
    }
    .ob-w-steps-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 1.5rem;
      animation: ob-fade-up 0.5s ease both;
      animation-delay: 0.36s;
      opacity: 0;
    }
    .ob-w-step-chip {
      display: flex; align-items: center; gap: 0.3rem;
      font-size: 0.72rem;
      color: var(--ob-muted);
      padding: 0.25rem 0.65rem;
      background: var(--ob-input-bg);
      border: 1px solid var(--ob-line);
      border-radius: 20px;
      white-space: nowrap;
    }
    .ob-w-sep { font-size: 0.6rem; color: var(--ob-line); }
    .ob-w-pill {
      margin-bottom: 1.5rem;
      animation: ob-fade-up 0.5s ease both;
      animation-delay: 0.44s;
