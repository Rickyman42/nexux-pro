      letter-spacing: 0.04em;
      padding: 0.1rem 0.35rem;
      margin-left: 0.35rem;
      border-radius: 999px;
      background: rgba(56, 160, 233, 0.16);
      color: #38a0e9;
      vertical-align: middle;
    }
    /* TG QR in onboarding */
    .ob-tg-qr-wrap { margin: 0.75rem 0 0.5rem; }
    .ob-tg-qr-wrap canvas { border-radius: 10px; border: 4px solid #fff; display: block; }
    .ob-tg-qr-actions { margin-top: 0.4rem; }
    .ob-tg-qr-actions a { font-size: 0.78rem; color: var(--ob-accent); text-decoration: none; }
    .ob-tg-qr-actions a:hover { text-decoration: underline; }
    /* ── Business context optional section ─────────────── */
    .ob-ctx-details {
      margin: 1rem 0 0.5rem;
