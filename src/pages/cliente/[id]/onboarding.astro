</style>

<script define:vars={{
  clientId,
  waConnected: data.channels.whatsapp.connected,
  tgEnabled: data.channels.telegram.enabled,
  servicesJson: JSON.stringify(data.services ?? []),
  scheduleJson: JSON.stringify(data.schedule ?? {})
}}>
(function () {

  var DAYS   = ['lunes','martes','miercoles','jueves','viernes','sabado','domingo'];
  var LABELS = ['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];
  var DEFAULT_SCH = {
    lunes:     { open:'09:00', close:'19:00' },
    martes:    { open:'09:00', close:'19:00' },
    miercoles: { open:'09:00', close:'19:00' },
    jueves:    { open:'09:00', close:'19:00' },
    viernes:   { open:'09:00', close:'19:00' },
    sabado:    { open:'09:00', close:'14:00' },
    domingo:   null
  };

  var ob          = document.getElementById('ob');
  var fill        = document.getElementById('ob-fill');
  var lblEl       = document.getElementById('ob-lbl');
  var currentStep = 0;
  var TOTAL       = 5;
  var finishItems = [];
  var chosenTheme = localStorage.getItem('crm-theme') || 'light';

  /* ── Theme ────────────────────────────────────────── */
  function applyTheme(t) {
    ob.className = t === 'dark' ? 'ob-dark' : 'ob-light';
    chosenTheme  = t;
  }
  applyTheme(chosenTheme);
  if (chosenTheme === 'dark') {
    var tbL = document.getElementById('tb-light');
    var tbD = document.getElementById('tb-dark');
    if (tbL) tbL.classList.remove('ob-t-selected');
    if (tbD) tbD.classList.add('ob-t-selected');
  }

  /* ── Progress ─────────────────────────────────────── */
  function setProgress(n) {
    var pct = n === 0 ? 0 : Math.round((n / TOTAL) * 100);
    fill.style.width = pct + '%';
    lblEl.textContent = n === 0 ? 'Comenzando…' : 'Paso ' + n + ' de ' + TOTAL;
  }

  /* ── Step nav ─────────────────────────────────────── */
  function showStep(n) {
    document.querySelectorAll('.ob-step').forEach(function (s) { s.classList.add('ob-hidden'); });
    var el = document.getElementById('os-' + n);
    if (el) el.classList.remove('ob-hidden');
    currentStep = n;
    setProgress(n);
    document.querySelector('.ob-stage').scrollTop = 0;
  }

  function goNext() { showStep(currentStep + 1); }

  /* ── API save ─────────────────────────────────────── */
  function saveConfig(config, cb) {
    fetch('/portal-api/update-config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ clientId: clientId, config: config })
    }).then(function (r) { cb(r.ok); }).catch(function () { cb(false); });
  }

  /* ── Analytics ──────────────────────────────────────── */
  function trackOb(event, data) {
    try {
      fetch('/pub-api/analytics/ob', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: event, clientId: clientId, data: data || {} }),
      }).catch(function () {});
    } catch(e) {}
  }

  /* ── Utils ────────────────────────────────────────── */
  function esc(s) {
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ════════════════════════════════════════════════════
     STEP 0 — Bienvenida
  ════════════════════════════════════════════════════ */
  document.getElementById('btn-start').addEventListener('click', function () { trackOb('ob_step', { step: 1, name: 'servicios' }); showStep(1); });

  /* ════════════════════════════════════════════════════
     STEP 1 — Servicios
  ════════════════════════════════════════════════════ */
  var services = JSON.parse(servicesJson);
  if (!Array.isArray(services)) services = [];

  function renderSvcs() {
    var list = document.getElementById('svc-list');
    if (!services.length) {
      list.innerHTML = '<p class="ob-svc-empty">Aún no hay servicios. Pulsa "Añadir servicio".</p>';
      return;
    }
    var h = '<div class="ob-svc-header">' +
      '<span>Servicio</span><span>Min.</span><span>Precio</span><span></span></div>';
    var rows = services.map(function (s, i) {
      return '<div class="ob-svc-row">' +
        '<input type="text" value="' + esc(s.name || '') + '" placeholder="Ej: Corte de pelo" data-i="' + i + '" data-f="name">' +
        '<input type="number" value="' + (s.duration || 30) + '" min="5" max="480" placeholder="30" data-i="' + i + '" data-f="duration">' +
        '<input type="number" value="' + (s.price || '') + '" min="0" step="0.01" placeholder="12.00" data-i="' + i + '" data-f="price">' +
        '<button class="ob-svc-del" data-i="' + i + '">×</button>' +
        '</div>';
    }).join('');
    list.innerHTML = h + rows;
    list.querySelectorAll('input').forEach(function (inp) {
      inp.addEventListener('input', function () {
        var idx = parseInt(this.dataset.i), f = this.dataset.f;
        if (f === 'name') services[idx].name = this.value;
        else services[idx][f] = parseFloat(this.value) || 0;
      });
    });
    list.querySelectorAll('.ob-svc-del').forEach(function (btn) {
      btn.addEventListener('click', function () {
        services.splice(parseInt(this.dataset.i), 1);
        renderSvcs();
      });
    });
  }
  renderSvcs();

  document.getElementById('svc-add').addEventListener('click', function () {
    services.push({ name: '', duration: 30, price: 0 });
    renderSvcs();
  });

  document.getElementById('svc-skip').addEventListener('click', function() { trackOb('ob_svc_skipped', {}); goNext(); });

  document.getElementById('svc-save').addEventListener('click', function () {
    var btn = this;
    btn.disabled = true; btn.textContent = 'Guardando…';
    var ctxPayload = { services: services };
    var ctxCity   = (document.getElementById('ctx-city')   || {}).value || '';
    var ctxAddr   = (document.getElementById('ctx-address') || {}).value || '';
    var ctxBio    = (document.getElementById('ctx-bio')     || {}).value || '';
    var ctxCancel = (document.getElementById('ctx-cancel')  || {}).value || '';
    if (ctxCity)   ctxPayload.city                = ctxCity.trim();
    if (ctxAddr)   ctxPayload.address             = ctxAddr.trim();
    if (ctxBio)    ctxPayload.bio                 = ctxBio.trim();
    if (ctxCancel) ctxPayload.cancellation_policy = ctxCancel.trim();
    saveConfig(ctxPayload, function (ok) {
      btn.disabled = false; btn.textContent = 'Guardar y continuar';
      if (ok && services.length) finishItems.push(services.length + ' servicio' + (services.length === 1 ? '' : 's') + ' configurado' + (services.length === 1 ? '' : 's'));
      trackOb('ob_svc_saved', { count: services.length, ok: ok });
      goNext();
    });
  });

  /* ════════════════════════════════════════════════════
     STEP 2 — Horario
  ════════════════════════════════════════════════════ */
  var existSch = JSON.parse(scheduleJson) || {};

  function renderSch() {
    var grid = document.getElementById('sch-grid');
    grid.innerHTML = DAYS.map(function (day, i) {
      var ex   = existSch[day];
      var def  = DEFAULT_SCH[day];
      var open = ex !== undefined ? ex !== null : def !== null;
      var ov   = (ex && ex.open)        || (def && def.open)  || '09:00';
      var cv   = (ex && ex.close)       || (def && def.close) || '19:00';
      var lcv  = (ex && ex.lunch_close) || '';
      var lov  = (ex && ex.lunch_open)  || '';
      var hasL = !!(ex && ex.lunch_close);
      return '<div class="ob-sch-row">' +
        '<label class="ob-day-toggle">' +
          '<input type="checkbox" id="chk-' + day + '"' + (open ? ' checked' : '') + '>' +
          '<span class="ob-day-name">' + LABELS[i] + '</span>' +
        '</label>' +
        '<div class="ob-day-times' + (open ? '' : ' ob-closed') + '" id="times-' + day + '">' +
          '<div class="ob-time-pair"><label>Apertura</label><input type="time" id="op-' + day + '" value="' + ov + '"></div>' +
          '<label class="ob-lunch-toggle" title="Pausa comida">' +
            '<input type="checkbox" id="lnch-chk-' + day + '"' + (hasL ? ' checked' : '') + '>' +
            '<span class="ob-lunch-lbl">🍽</span>' +
          '</label>' +
          '<div class="ob-lunch-times' + (hasL ? '' : ' ob-hidden') + '" id="lunch-' + day + '">' +
            '<div class="ob-time-pair"><label>Cierra</label><input type="time" id="lc-' + day + '" value="' + lcv + '"></div>' +
            '<div class="ob-time-pair"><label>Reabre</label><input type="time" id="lo-' + day + '" value="' + lov + '"></div>' +
          '</div>' +
          '<div class="ob-time-pair"><label>Cierre</label><input type="time" id="cl-' + day + '" value="' + cv + '"></div>' +
        '</div>' +
        '</div>';
    }).join('');

    DAYS.forEach(function (day) {
      document.getElementById('chk-' + day).addEventListener('change', function () {
        var t = document.getElementById('times-' + day);
        if (this.checked) t.classList.remove('ob-closed');
        else t.classList.add('ob-closed');
      });
      document.getElementById('lnch-chk-' + day).addEventListener('change', function () {
        var lt = document.getElementById('lunch-' + day);
        if (this.checked) lt.classList.remove('ob-hidden');
        else lt.classList.add('ob-hidden');
      });
    });
  }
  renderSch();

  document.getElementById('sch-skip').addEventListener('click', function() { trackOb('ob_sch_skipped', {}); goNext(); });

  document.getElementById('sch-save').addEventListener('click', function () {
    var schedule = {};
    DAYS.forEach(function (day) {
      var chk = document.getElementById('chk-' + day);
      if (!chk.checked) { schedule[day] = null; return; }
      var entry = {
        open:  document.getElementById('op-' + day).value || '09:00',
        close: document.getElementById('cl-' + day).value || '19:00'
      };
      var lnchChk = document.getElementById('lnch-chk-' + day);
      if (lnchChk && lnchChk.checked) {
        var lcVal = document.getElementById('lc-' + day).value;
        var loVal = document.getElementById('lo-' + day).value;
        if (lcVal) entry.lunch_close = lcVal;
        if (loVal) entry.lunch_open  = loVal;
      }
      schedule[day] = entry;
    });
    var btn = this;
    btn.disabled = true; btn.textContent = 'Guardando…';
    saveConfig({ schedule: schedule }, function (ok) {
      btn.disabled = false; btn.textContent = 'Guardar y continuar';
      if (ok) {
        var openCount = Object.values(schedule).filter(function (v) { return v !== null; }).length;
        finishItems.push('Horario: ' + openCount + ' día' + (openCount === 1 ? '' : 's') + ' configurado' + (openCount === 1 ? '' : 's'));
      }
      trackOb('ob_sch_saved', { ok: ok });
      goNext();
    });
  });

  /* ════════════════════════════════════════════════════
     STEP 3 — Canal selection
  ════════════════════════════════════════════════════ */
  (function () {
    var tgDeepLink = 'https://t.me/NexuxProAssistantBot?start=c_' + clientId;

    var GUIDES = {
      whatsapp: '<strong>📱 WhatsApp</strong><p>Perfecto. Nuestro equipo se pondrá en contacto contigo en menos de 24h para conectar tu número — sin cambiar el que ya tienen guardado tus clientas, sin perder chats.</p><p class="ob-guide-tip">Solo necesitarás escanear un código QR desde tu teléfono cuando te lo indiquemos. Tardas 2 minutos.</p><p class="ob-guide-tip">⏳ Importante: ese código dura 24 horas. Si se te pasa el plazo, la conexión se apaga sola y la vuelves a activar desde tu panel, en Canales.</p><p class="ob-guide-tip">💡 Puedes tener los dos a la vez. Telegram no caduca ni se desconecta, así que muchos salones lo dejan puesto también como red de seguridad.</p>',
      tg_group: '<strong>💬 Telegram — grupo existente</strong><p>Añade a Lara como administradora de tu grupo y empezará a responder sola a tus clientas.</p><ol class="ob-guide-ol"><li>Abre tu grupo de Telegram</li><li>Miembros → Añadir administrador</li><li>Busca <code>@NexuxProAssistantBot</code></li></ol><p class="ob-guide-tip">Eso es todo. Lara activa al instante.</p>',
      tg_new:   '<strong>✈️ Telegram — empezamos desde cero</strong><p>Comparte este enlace con tus clientas. Las que lo abran podrán chatear directamente con Lara para pedir cita.</p><div class="ob-guide-link"><a href="' + tgDeepLink + '" target="_blank">' + tgDeepLink + '</a><button data-copy="' + tgDeepLink + '" class="ob-copy-btn">Copiar</button></div><div class="ob-tg-qr-wrap"><canvas id="ob-tg-qr" width="180" height="180"></canvas><div class="ob-tg-qr-actions"><a id="ob-tg-qr-dl" download="lara-telegram.png" class="ob-link-sm">⬇️ Descargar QR</a></div></div><p class="ob-guide-tip">Imprímelo para el mostrador o ponlo en tu bio de Instagram.</p>',

    };

    var LABELS = {
      whatsapp: 'WhatsApp', tg_group: 'Telegram (grupo)', tg_new: 'Telegram (deeplink)', web: 'Widget web',
    };

    var chNext  = document.getElementById('ch-next');
    var guide   = document.getElementById('canal-guide');
    var guideIn = document.getElementById('canal-guide-inner');
    var chosen  = null;

    document.querySelectorAll('.ob-canal-opt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.ob-canal-opt').forEach(function (b) { b.classList.remove('ob-canal-selected'); });
        this.classList.add('ob-canal-selected');
        chosen = this.dataset.canal;
        guideIn.innerHTML = GUIDES[chosen] || '';
        // Render Telegram QR when tg_new selected
        if (chosen === 'tg_new') {
          (function tryRender() {
            if (typeof QRCode === 'undefined') { setTimeout(tryRender, 300); return; }
            var c = document.getElementById('ob-tg-qr');
            var dl = document.getElementById('ob-tg-qr-dl');
            if (!c) return;
            QRCode.toCanvas(c, tgDeepLink, { width: 180, margin: 1, color: { dark: '#0a0a0f', light: '#ffffff' } }, function (err) {
              if (!err && dl) dl.href = c.toDataURL('image/png');
            });
          })();
        }
        guide.classList.remove('ob-hidden');
        chNext.disabled = false;
        chNext.style.opacity = '';
        chNext.style.cursor  = '';
        trackOb('ob_canal_selected', { canal: chosen });
      });
    });

    chNext.addEventListener('click', function () {
      if (!chosen) return;
      finishItems.push('Canal: ' + LABELS[chosen]);
      trackOb('ob_canal_confirmed', { canal: chosen });
      goNext();
    });
    document.addEventListener('click', function(e) {
      var btn = e.target;
      if (btn && btn.classList.contains('ob-copy-btn') && btn.dataset.copy) {
        navigator.clipboard.writeText(btn.dataset.copy).catch(function(){});
        btn.textContent = '\u00a1Copiado!';
        setTimeout(function(){ btn.textContent = 'Copiar'; }, 1500);
      }
    });
  })();

  /* ════════════════════════════════════════════════════
     STEP 4 — Tema
  ════════════════════════════════════════════════════ */
  document.querySelectorAll('.ob-theme-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.ob-theme-btn').forEach(function (b) { b.classList.remove('ob-t-selected'); });
      this.classList.add('ob-t-selected');
      applyTheme(this.dataset.t);
    });
  });

  document.getElementById('th-next').addEventListener('click', function () {
    localStorage.setItem('crm-theme', chosenTheme);
    finishItems.push('Estilo ' + (chosenTheme === 'dark' ? 'oscuro 🌙' : 'claro ☀️') + ' seleccionado');
    trackOb('ob_theme_set', { theme: chosenTheme });
    renderFinish();
    goNext();
  });

  /* ════════════════════════════════════════════════════
     STEP 5 — Listo
  ════════════════════════════════════════════════════ */
  function renderFinish() {
    var list = document.getElementById('fin-list');
    if (!finishItems.length) {
      list.innerHTML = '<p style="font-size:0.84rem;color:var(--ob-muted)">Puedes configurar todo desde el panel cuando quieras.</p>';
      return;
    }
    list.innerHTML = finishItems.map(function (txt) {
      return '<div class="ob-fin-item"><div class="ob-fin-dot"></div><span>' + esc(txt) + '</span></div>';
    }).join('');
  }

  /* ── Init ─────────────────────────────────────────── */
  setProgress(0);
  trackOb('ob_start', {});

  /* ── Marcar onboarding como visto ─────────────────── */
  function markDone() {
    try { localStorage.setItem('nx_ob_' + clientId, '1'); } catch(e) {}
    trackOb('ob_mark_done', {});
  }
  var skipEl   = document.getElementById('ob-skip');
  var finishEl = document.getElementById('ob-finish');
  var doneEls  = document.querySelectorAll('.ob-mark-done');
  if (skipEl)   skipEl.addEventListener('click', function() { trackOb('ob_skipped', {}); markDone(); });
  if (finishEl) finishEl.addEventListener('click', function() { trackOb('ob_complete', {}); markDone(); });
  doneEls.forEach(function(el){ el.addEventListener('click', markDone); });

})();
</script>

<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
</Layout>
