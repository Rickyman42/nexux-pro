---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';

const { id } = Astro.params;
const reason = Astro.url.searchParams.get('reason');
const isExpiredSession = reason === 'session' || reason === 'expired';
---
<Layout
  title="Acceso al portal | Nexux Pro"
  description="Solicita un nuevo enlace de acceso a tu portal de cliente."
  canonical={`https://nexux.pro/cliente/${id}/login`}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <section class="portal-auth">
    <div class="container-nx">
      <div class="portal-auth-card">
        <p class="eyebrow">Portal cliente</p>
        <h1>{isExpiredSession ? 'Vuelve a entrar a tu' : 'Acceso al'} <em>portal</em></h1>
        <p class="portal-auth-copy">
          {isExpiredSession
            ? 'Por seguridad, te enviamos un enlace nuevo para abrir el panel de tu salon en este dispositivo.'
            : 'Introduce tu email para recibir un nuevo enlace de acceso al portal de tu salon.'}
        </p>
        <p class="portal-auth-hint">Solo tienes que hacerlo cuando el enlace anterior haya caducado.</p>

        <form id="portal-login-form" class="portal-auth-form">
          <label class="portal-field">
            <span>Email</span>
            <input id="portal-email" type="email" name="email" placeholder="tu@email.com" required />
          </label>
          <button class="btn-primary" type="submit">Enviar enlace</button>
        </form>

        <p id="portal-login-message" class="portal-auth-message" hidden>
          Si el email es correcto, recibiras el enlace en breve.
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{ clientId: id }}>
    const form = document.getElementById('portal-login-form');
    const message = document.getElementById('portal-login-message');
    const emailInput = document.getElementById('portal-email');
    const emailStorageKey = 'portal-email:' + clientId;

    if (emailInput instanceof HTMLInputElement) {
      emailInput.value = localStorage.getItem(emailStorageKey) || localStorage.getItem('portal-email') || '';
    }

    form?.addEventListener('submit', async event => {
      event.preventDefault();
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      if (!email) return;
      localStorage.setItem(emailStorageKey, email);
      localStorage.setItem('portal-email', email);
      localStorage.setItem('crm-last-client', clientId);

      await fetch('/portal-api/resend-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId, email }),
      }).catch(() => {});

      if (message) {
        message.hidden = false;
      }
    });
  </script>

  <style>
    .portal-auth {
      min-height: 100vh;
      display: grid;
      align-items: center;
      padding: 7rem 0;
    }

    .portal-auth-card {
      max-width: 560px;
      padding: 2rem;
      background: var(--nx-deep);
      border: 1px solid var(--nx-line);
      border-radius: 28px;
    }

    .portal-auth-card .eyebrow {
      display: inline-block;
      margin-bottom: 1rem;
    }

    .portal-auth-card h1 {
      font-family: var(--nx-font-serif);
      font-size: clamp(2rem, 5vw, 3.4rem);
      line-height: 1.05;
      font-weight: 400;
      letter-spacing: -0.03em;
    }

    .portal-auth-card h1 em {
      color: var(--nx-magnet);
      font-style: italic;
    }

    .portal-auth-copy {
      margin-top: 1rem;
      color: var(--nx-ink-muted);
      line-height: 1.8;
    }

    .portal-auth-hint {
      margin-top: 0.75rem;
      color: var(--nx-ink-muted);
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .portal-auth-form {
      display: grid;
      gap: 1rem;
      margin-top: 2rem;
    }

    .portal-field {
      display: grid;
      gap: 0.5rem;
    }

    .portal-field span {
      color: var(--nx-ink);
      font-size: 0.9rem;
      font-weight: 500;
    }

    .portal-field input {
      width: 100%;
      padding: 0.95rem 1rem;
      border-radius: 16px;
      border: 1px solid var(--nx-line);
      background: rgba(20, 22, 26, 0.05);
      color: var(--nx-ink);
      font: inherit;
    }

    .portal-auth-message {
      margin-top: 1rem;
      color: var(--nx-magnet);
      line-height: 1.6;
    }
  </style>
</Layout>
