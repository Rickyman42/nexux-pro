---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getClientData, type Appointment } from '../../lib/portal-client';

const { id: clientId } = Astro.params;
const token = Astro.cookies.get('nexux_token')?.value;

if (!clientId || !token) {
  return Astro.redirect(`/cliente/${clientId ?? ''}/login`);
}

const data = await getClientData(clientId, token);
if (!data) {
  return Astro.redirect('/acceso-denegado');
}

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  weekday: 'short',
  day: 'numeric',
  month: 'long',
});

const timeFormatter = new Intl.DateTimeFormat('es-ES', {
  hour: '2-digit',
  minute: '2-digit',
});

const todayKey = new Date().toDateString();
const todayAppointments = data.nextAppointments.filter(item => new Date(item.datetime).toDateString() === todayKey).length;
const limitedProgress = data.metrics.conversationLimit
  ? Math.min(100, Math.round((data.metrics.conversationCount / data.metrics.conversationLimit) * 100))
  : 100;
const planLabel = data.plan.charAt(0).toUpperCase() + data.plan.slice(1);
const qrImageSrc = data.qrPngBase64
  ? data.qrPngBase64.startsWith('data:image')
    ? data.qrPngBase64
    : `data:image/png;base64,${data.qrPngBase64}`
  : null;
const ownerTelegramUrl = `https://t.me/NexuxProAssistantBot?start=${data.clientId}`;
const customerTelegramUrl = `https://t.me/NexuxProAssistantBot?start=c_${data.clientId}`;
const showWhatsApp = !!data.channels.whatsapp?.provider;

const weekdayLabels: [string, string][] = [
  ['monday', 'Lunes'],
  ['tuesday', 'Martes'],
  ['wednesday', 'Miercoles'],
  ['thursday', 'Jueves'],
  ['friday', 'Viernes'],
  ['saturday', 'Sabado'],
  ['sunday', 'Domingo'],
];

function renderAppointmentDate(item: Appointment) {
  const date = new Date(item.datetime);
  return {
    date: dateFormatter.format(date),
    time: timeFormatter.format(date),
  };
}
---
<Layout
  title={`Portal - ${data.name}`}
  description={`Portal del cliente ${data.name} en Nexux Pro.`}
  canonical={`https://nexux.pro/cliente/${clientId}`}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <section class="portal-page">
    <div class="container-nx">
      <header class="portal-header">
        <div>
          <p class="eyebrow">Portal cliente</p>
          <h1>Tu bot - {data.name}</h1>
        </div>
        <div class="portal-badges">
          <span class="portal-badge portal-badge-plan">Plan {planLabel}</span>
          <span class={`portal-badge ${data.active ? 'portal-badge-live' : 'portal-badge-off'}`}>
            {data.active ? 'Activo' : 'Inactivo'}
          </span>
        </div>
      </header>

      <section class="portal-grid">
        <article class="portal-card">
          <div class="portal-card-head">
            <h2>Estado del bot</h2>
          </div>
          <div class="portal-status-grid">
            {showWhatsApp && (
            <div class="portal-status-item">
              <strong>WhatsApp</strong>
              <span class="portal-status-val">
                <span class={`portal-status-dot ${data.channels.whatsapp.connected ? 'dot-green' : data.botStatus === 'pending_qr' ? 'dot-yellow' : 'dot-red'}`}></span>
                {data.channels.whatsapp.connected
                  ? `Conectado (${data.channels.whatsapp.provider})`
                  : data.botStatus === 'pending_qr'
                    ? 'Pendiente de QR'
                    : 'Desconectado'}
              </span>
            </div>
            )}
            <div class="portal-status-item">
              <strong>Telegram</strong>
              <span class="portal-status-val">
                <span class={`portal-status-dot ${data.channels.telegram.ownerLinked ? 'dot-green' : 'dot-yellow'}`}></span>
                {data.channels.telegram.ownerLinked ? 'Vinculado' : 'Pendiente de vincular'}
              </span>
            </div>
          </div>

          {showWhatsApp && data.botStatus === 'pending_qr' && (
            <div class="portal-qr-block">
              <p>
                WhatsApp esta pendiente de vinculacion. {data.qrPngBase64 ? 'Escanea el QR desde tu movil.' : 'Te enviaremos un QR valido en breve desde soporte.'}
              </p>
              {qrImageSrc && (
                <img
                  src={qrImageSrc}
                  alt="QR para vincular WhatsApp"
                  class="portal-qr-image"
                />
              )}
            </div>
          )}
        </article>

        <article class="portal-card">
          <div class="portal-card-head">
            <h2>Proximas citas</h2>
            <span class="portal-mini-badge">{todayAppointments} hoy</span>
          </div>

          {data.nextAppointments.length ? (
            <div class="portal-table-wrap">
              <table class="portal-table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Clienta</th>
                    <th>Servicio</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {data.nextAppointments.slice(0, 10).map(item => {
                    const row = renderAppointmentDate(item);
                    return (
                      <tr>
                        <td>{row.date}</td>
                        <td>{row.time}</td>
                        <td>{item.clientName || item.clientPhone}</td>
                        <td>{item.service}</td>
                        <td>
                          <span class={`portal-status-chip ${item.status === 'confirmed' ? 'portal-status-confirmed' : 'portal-status-cancelled'}`}>
                            {item.status === 'confirmed' ? 'Confirmada' : 'Cancelada'}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="portal-empty">Aun no hay citas registradas. Las citas reservadas por tu bot apareceran aqui.</p>
          )}
        </article>
      </section>

      <section class="portal-metrics">
        <article class="portal-metric-card">
          <span>Conversaciones</span>
          <strong>
            {data.metrics.conversationCount}{data.metrics.conversationLimit ? `/${data.metrics.conversationLimit}` : ''}
          </strong>
          {data.plan === 'starter' && data.metrics.conversationLimit && (
            <div class="portal-progress">
              <div class="portal-progress-bar" style={`width:${limitedProgress}%`}></div>
            </div>
          )}
        </article>
        <article class="portal-metric-card">
          <span>Citas reservadas</span>
          <strong>{data.metrics.appointmentsBooked}</strong>
        </article>
        <article class="portal-metric-card">
          <span>Cancelaciones</span>
          <strong>{data.metrics.appointmentsCancelled}</strong>
        </article>
      </section>

      <section class="portal-card portal-calendar-card">
        <div class="portal-card-head">
          <h2>Calendario de citas</h2>
          <button class="btn-primary btn-sm" id="open-apt-modal">+ Nueva cita</button>
        </div>
        <div class="portal-calendar-nav">
          <button id="cal-prev" class="btn-ghost">← Semana anterior</button>
          <span id="cal-week-label"></span>
          <button id="cal-next" class="btn-ghost">Semana siguiente →</button>
        </div>
        <div class="portal-calendar-grid" id="cal-grid">
          <p class="portal-cal-empty">Cargando...</p>
        </div>
      </section>

      <section class="portal-card portal-telegram-card">
        <div class="portal-card-head">
          <h2>Telegram</h2>
          <span class={`portal-status-chip ${data.channels.telegram.ownerLinked ? 'portal-status-confirmed' : 'portal-status-warning'}`}>
            {data.channels.telegram.ownerLinked ? 'Vinculado' : 'No vinculado'}
          </span>
        </div>

        {!data.channels.telegram.ownerLinked && (
          <div class="portal-telegram-owner">
            <p>Vincula tu Telegram para recibir avisos de citas y actividad de Lara.</p>
            <a href={ownerTelegramUrl} class="btn-primary" target="_blank" rel="noopener">Vincular mi Telegram -></a>
          </div>
        )}

        <div class="portal-telegram-customer">
          <div>
            <strong>Enlace para tus clientas</strong>
            <p>Compártelo para que puedan iniciar conversacion con tu bot en Telegram.</p>
          </div>
          <div class="portal-copy-row">
            <input id="telegram-customer-link" type="text" value={customerTelegramUrl} readonly />
            <button id="telegram-copy" type="button" class="btn-ghost">Copiar enlace</button>
          </div>
        </div>
      </section>

      <details class="portal-card portal-config-card portal-services-card">
        <summary>
          <span>Mis servicios</span>
          <span class="portal-summary-hint">Servicios del salón</span>
        </summary>

        <div id="services-list-wrap" class="portal-services-table-wrap"></div>

        <div class="portal-services-form">
          <div class="portal-services-add-row">
            <input type="text" id="svc-name" placeholder="Nombre del servicio" />
            <input type="number" id="svc-duration" placeholder="Duración (min)" min="1" />
            <input type="number" id="svc-price" placeholder="Precio (€)" min="0" step="0.01" />
            <button type="button" id="svc-add" class="btn-ghost">+ Añadir</button>
          </div>
        </div>

        <button type="button" id="svc-save" class="btn-primary">Guardar cambios</button>
      </details>

      <details class="portal-card portal-config-card">
        <summary>
          <span>Configuracion rapida</span>
          <span class="portal-summary-hint">Horario y disponibilidad</span>
        </summary>

        <form id="schedule-form" class="portal-config-form">
          {weekdayLabels.map(([key, label]) => {
            const slot = data.schedule[key];
            return (
              <div class="portal-schedule-row">
                <div class="portal-schedule-day">{label}</div>
                <label class="portal-switch">
                  <input type="checkbox" name={`${key}_closed`} checked={!slot} />
                  <span>Cerrado</span>
                </label>
                <input type="time" name={`${key}_open`} value={slot?.open ?? '09:00'} disabled={!slot} />
                <input type="time" name={`${key}_close`} value={slot?.close ?? '19:00'} disabled={!slot} />
              </div>
            );
          })}
          <button type="submit" class="btn-primary">Guardar horario</button>
        </form>
      </details>

      {data.plan !== 'starter' && (
        <section class="portal-card portal-provider-card">
          <div class="portal-card-head">
            <h2>Proveedor WhatsApp</h2>
          </div>
          <div class="portal-provider-options">
            <label class="portal-provider-option">
              <input type="radio" name="whatsapp_provider" value="baileys" checked={data.channels.whatsapp.provider === 'baileys'} />
              <span>
                <strong>Baileys</strong>
                <small>Tu numero actual - Gratis</small>
              </span>
            </label>
            <label class="portal-provider-option">
              <input type="radio" name="whatsapp_provider" value="twilio" checked={data.channels.whatsapp.provider === 'twilio'} />
              <span>
                <strong>Twilio WhatsApp Business</strong>
                <small>Numero dedicado - +10EUR/mes</small>
              </span>
            </label>
          </div>
          <button id="provider-trigger" type="button" class="btn-ghost">Cambiar proveedor -></button>
        </section>
      )}

      <footer class="portal-footer">
        Necesitas ayuda? Contacta a Ricardo:
        <a href="https://t.me/nexux_soporte_bot" target="_blank" rel="noopener">t.me/nexux_soporte_bot</a>
      </footer>
    </div>
  </section>

  <div id="portal-toast" class="portal-toast" hidden>Guardado OK</div>

  {data.plan !== 'starter' && (
    <dialog id="provider-dialog" class="portal-dialog">
      <div class="portal-dialog-card">
        <h3>Cambiar a Twilio WhatsApp Business</h3>
        <ul>
          <li>Tu numero actual de WhatsApp dejara de recibir mensajes del bot.</li>
          <li>Recibiras un numero nuevo de Twilio en 24-48h.</li>
          <li>El coste adicional se aplicara en la proxima factura.</li>
        </ul>
        <div class="portal-dialog-actions">
          <button type="button" id="provider-confirm" class="btn-primary">Confirmar cambio</button>
          <button type="button" id="provider-cancel" class="btn-ghost">Cancelar</button>
        </div>
      </div>
    </dialog>
  )}

  <dialog id="new-apt-modal" class="portal-dialog">
    <form id="new-apt-form" class="portal-modal-form">
      <h3>Nueva cita</h3>
      <label>
        Nombre cliente
        <input type="text" name="client_name" required placeholder="Nombre del cliente" />
      </label>
      <label>
        Servicio
        <input type="text" name="service" required placeholder="Corte, tinte…" />
      </label>
      <div class="apt-field-group">
        <span class="apt-field-label">Fecha</span>
        <div class="apt-date-picker">
          <div class="apt-dp-nav">
            <button type="button" id="apt-dp-prev">←</button>
            <span id="apt-dp-month-label"></span>
            <button type="button" id="apt-dp-next">→</button>
          </div>
          <div class="apt-dp-weekdays">Lu Ma Mi Ju Vi Sá Do</div>
          <div class="apt-dp-grid" id="apt-dp-grid"></div>
        </div>
        <span class="apt-date-display" id="apt-date-display">Selecciona una fecha</span>
        <input type="hidden" name="date" id="apt-date-val" />
      </div>
      <div class="apt-field-group">
        <span class="apt-field-label">Hora</span>
        <div class="apt-time-picker" id="apt-time-grid"></div>
        <input type="hidden" name="time" id="apt-time-val" />
      </div>
      <label>
        Duración (min)
        <input type="number" name="duration_min" value="60" min="15" step="15" />
      </label>
      <div class="portal-modal-actions">
        <button type="submit" class="btn-primary">Reservar cita</button>
        <button type="button" id="close-apt-modal" class="btn-ghost">Cancelar</button>
      </div>
    </form>
  </dialog>

  <script define:vars={{ clientId, currentProvider: data.channels.whatsapp.provider, isStarter: data.plan === 'starter', customerTelegramUrl, servicesJson: JSON.stringify(data.services ?? []) }}>
    const toast = document.getElementById('portal-toast');
    const scheduleForm = document.getElementById('schedule-form');
    const telegramCopy = document.getElementById('telegram-copy');
    const telegramCustomerLink = document.getElementById('telegram-customer-link');

    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.hidden = false;
      toast.classList.add('portal-toast-show');
      setTimeout(() => {
        toast.classList.remove('portal-toast-show');
        toast.hidden = true;
      }, 2200);
    }

    function buildSchedulePayload(form) {
      const payload = {};
      ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'].forEach(day => {
        const closed = form.elements.namedItem(`${day}_closed`);
        const open = form.elements.namedItem(`${day}_open`);
        const close = form.elements.namedItem(`${day}_close`);
        if (closed instanceof HTMLInputElement && closed.checked) {
          payload[day] = null;
          return;
        }
        payload[day] = {
          open: open instanceof HTMLInputElement ? open.value : '09:00',
          close: close instanceof HTMLInputElement ? close.value : '19:00',
        };
      });
      return payload;
    }

    async function copyTelegramLink(url) {
      try {
        await navigator.clipboard.writeText(url);
        showToast('¡Copiado!');
      } catch {
        if (telegramCustomerLink instanceof HTMLInputElement) {
          telegramCustomerLink.focus();
          telegramCustomerLink.select();
          document.execCommand('copy');
          showToast('¡Copiado!');
        }
      }
    }

    telegramCopy?.addEventListener('click', () => {
      copyTelegramLink(customerTelegramUrl);
    });

    scheduleForm?.querySelectorAll('input[type="checkbox"]').forEach(input => {
      input.addEventListener('change', event => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLInputElement)) return;
        const day = target.name.replace('_closed', '');
        const open = scheduleForm.elements.namedItem(`${day}_open`);
        const close = scheduleForm.elements.namedItem(`${day}_close`);
        if (open instanceof HTMLInputElement) open.disabled = target.checked;
        if (close instanceof HTMLInputElement) close.disabled = target.checked;
      });
    });

    scheduleForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!(scheduleForm instanceof HTMLFormElement)) return;

      const response = await fetch('/portal-api/update-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          clientId,
          config: { schedule: buildSchedulePayload(scheduleForm) },
        }),
      }).catch(() => null);

      showToast(response?.ok ? 'Guardado OK' : 'No se pudo guardar');
    });

    // ── Services ───────────────────────────────────────
    let services = JSON.parse(servicesJson || '[]');

    function esc(s) { const d = document.createElement('div'); d.textContent = String(s ?? ''); return d.innerHTML; }
    function renderServices() {
      const wrap = document.getElementById('services-list-wrap');
      if (!wrap) return;
      if (services.length === 0) {
        wrap.innerHTML = '<p class="portal-empty portal-services-empty">Sin servicios configurados. Añade el primero.</p>';
        return;
      }
      wrap.innerHTML = `
        <div class="portal-table-wrap">
          <table class="portal-table">
            <thead><tr><th>Servicio</th><th>Duración</th><th>Precio</th><th></th></tr></thead>
            <tbody>${services.map((s, i) => `
              <tr>
                <td>${esc(s.name)}</td>
                <td>${esc(s.duration)} min</td>
                <td>${esc(s.price)} €</td>
                <td><button type="button" class="btn-del-svc" data-i="${i}" title="Eliminar">🗑</button></td>
              </tr>`).join('')}
            </tbody>
          </table>
        </div>`;
      wrap.querySelectorAll('.btn-del-svc').forEach(btn => {
        btn.addEventListener('click', () => {
          services.splice(parseInt(btn.dataset.i), 1);
          renderServices();
        });
      });
    }
    renderServices();

    document.getElementById('svc-add')?.addEventListener('click', () => {
      const nameInput = document.getElementById('svc-name');
      const durInput  = document.getElementById('svc-duration');
      const priceInput = document.getElementById('svc-price');
      const name     = nameInput?.value.trim();
      const duration = parseInt(durInput?.value);
      const price    = parseFloat(priceInput?.value);
      if (!name)                        { showToast('Nombre obligatorio'); return; }
      if (!duration || duration <= 0)   { showToast('Duración inválida'); return; }
      if (isNaN(price) || price < 0)   { showToast('Precio inválido'); return; }
      services.push({ name, duration, price });
      renderServices();
      nameInput.value = '';
      durInput.value  = '';
      priceInput.value = '';
    });

    document.getElementById('svc-save')?.addEventListener('click', async () => {
      const response = await fetch('/portal-api/update-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId, config: { services } }),
      }).catch(() => null);
      showToast(response?.ok ? 'Guardado ✅' : 'No se pudo guardar');
    });
    // ── /Services ──────────────────────────────────────

    if (!isStarter) {
      const providerTrigger = document.getElementById('provider-trigger');
      const providerDialog = document.getElementById('provider-dialog');
      const providerCancel = document.getElementById('provider-cancel');
      const providerConfirm = document.getElementById('provider-confirm');

      providerTrigger?.addEventListener('click', () => {
        const selected = document.querySelector('input[name="whatsapp_provider"]:checked');
        if (!(selected instanceof HTMLInputElement)) return;
        if (selected.value === currentProvider) {
          showToast('No hay cambios pendientes');
          return;
        }
        if (providerDialog instanceof HTMLDialogElement) {
          providerDialog.showModal();
        }
      });

      providerCancel?.addEventListener('click', () => {
        if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
      });

      providerConfirm?.addEventListener('click', async () => {
        const selected = document.querySelector('input[name="whatsapp_provider"]:checked');
        if (!(selected instanceof HTMLInputElement)) return;

        const response = await fetch('/portal-api/update-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            clientId,
            config: { channels: { whatsapp: { provider: selected.value } } },
          }),
        }).catch(() => null);

        if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
        showToast(response?.ok ? 'Cambio solicitado OK' : 'No se pudo solicitar el cambio');
      });
    }

    // ── Calendar ───────────────────────────────────────────────────────────
    (function () {
      let currentWeekOffset = 0;

      const DAY_NAMES = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
      // Indices 3-6 (Thu-Sun) hidden on mobile — show Mon/Tue/Wed
      const HIDE_ON_MOBILE = [3, 4, 5, 6];

      function getMondayOfWeek(offset) {
        const now = new Date();
        const day = now.getDay(); // 0=Sun
        const diffToMon = (day === 0 ? -6 : 1 - day);
        const mon = new Date(now);
        mon.setDate(now.getDate() + diffToMon + offset * 7);
        mon.setHours(0, 0, 0, 0);
        return mon;
      }

      function pad(n) { return String(n).padStart(2, '0'); }

      function fmtDate(d) {
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      }

      function fmtTime(iso) {
        if (!iso) return '';
        const d = new Date(iso);
        return pad(d.getHours()) + ':' + pad(d.getMinutes());
      }

      function isToday(d) {
        const t = new Date();
        return (
          d.getFullYear() === t.getFullYear() &&
          d.getMonth() === t.getMonth() &&
          d.getDate() === t.getDate()
        );
      }

      async function loadCalendar() {
        const grid = document.getElementById('cal-grid');
        const label = document.getElementById('cal-week-label');
        if (!grid) return;
        grid.innerHTML = '<p class="portal-cal-empty">Cargando…</p>';

        let apts = [];
        try {
          const res = await fetch('/portal-api/appointments?clientId=' + clientId);
          if (res.ok) apts = await res.json();
        } catch (e) {
          grid.innerHTML = '<p class="portal-cal-empty">Error al cargar citas</p>';
          return;
        }

        const monday = getMondayOfWeek(currentWeekOffset);

        const mStr = (monday.getMonth() + 1);
        const sunday = new Date(monday);
        sunday.setDate(monday.getDate() + 6);
        label.textContent =
          monday.getDate() + '/' + mStr + ' – ' +
          sunday.getDate() + '/' + (sunday.getMonth() + 1) + '/' + sunday.getFullYear();

        grid.innerHTML = '';

        for (let i = 0; i < 7; i++) {
          const day = new Date(monday);
          day.setDate(monday.getDate() + i);
          const dayStr = fmtDate(day);

          const dayApts = apts
            .filter(a => {
              const d = new Date(a.datetime);
              return fmtDate(d) === dayStr;
            })
            .sort((a, b) => new Date(a.datetime) - new Date(b.datetime));

          const col = document.createElement('div');
          col.className = 'portal-cal-day' + (HIDE_ON_MOBILE.includes(i) ? ' hide-mobile' : '');

          const hdr = document.createElement('div');
          hdr.className = 'portal-cal-day-header' + (isToday(day) ? ' today' : '');
          hdr.innerHTML = DAY_NAMES[i] + '<span class="cal-date">' + day.getDate() + '</span>';
          col.appendChild(hdr);

          if (dayApts.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'portal-cal-empty';
            empty.textContent = '–';
            col.appendChild(empty);
          } else {
            dayApts.forEach(apt => {
              const card = document.createElement('div');
              const st = (apt.status || 'confirmed').toLowerCase();
              card.className = 'portal-cal-apt ' + st;

              const tSpan = document.createElement('span');
              tSpan.className = 'portal-cal-apt-time';
              tSpan.textContent = fmtTime(apt.datetime);
              const nSpan = document.createElement('span');
              nSpan.className = 'portal-cal-apt-name';
              nSpan.textContent = apt.clientName || apt.client_name || '';
              const sSpan = document.createElement('span');
              sSpan.className = 'portal-cal-apt-name';
              sSpan.style.fontSize = '0.7rem';
              sSpan.textContent = apt.service || '';
              card.appendChild(tSpan);
              card.appendChild(nSpan);
              card.appendChild(sSpan);

              if (st !== 'cancelled') {
                const btn = document.createElement('button');
                btn.className = 'portal-cal-apt-cancel';
                btn.textContent = 'Cancelar';
                btn.addEventListener('click', async () => {
                  btn.disabled = true;
                  try {
                    await fetch('/portal-api/appointments', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ clientId, action: 'cancel', aptId: apt.id })
                    });
                  } catch (_) {}
                  await loadCalendar();
                });
                card.appendChild(btn);
              }

              col.appendChild(card);
            });
          }

          grid.appendChild(col);
        }
      }

      // Week navigation
      document.getElementById('cal-prev')?.addEventListener('click', () => {
        currentWeekOffset--;
        loadCalendar();
      });
      document.getElementById('cal-next')?.addEventListener('click', () => {
        currentWeekOffset++;
        loadCalendar();
      });

      // Modal
      const aptModal = document.getElementById('new-apt-modal');
      document.getElementById('open-apt-modal')?.addEventListener('click', () => {
        aptModal?.showModal();
      });
      document.getElementById('close-apt-modal')?.addEventListener('click', () => {
        aptModal?.close();
      });

      // New appointment submit
      document.getElementById('new-apt-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const date = fd.get('date');
        const time = fd.get('time');
        if (!date || !time) { showToast('Selecciona fecha y hora'); return; }
        const body = {
          clientId,
          client_name:  fd.get('client_name'),
          service:      fd.get('service'),
          datetime:     date + 'T' + time + ':00',
          duration_min: parseInt(fd.get('duration_min'), 10) || 60
        };
        try {
          const r = await fetch('/portal-api/appointments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
          if (!r.ok) throw new Error('api error');
          aptModal?.close();
          e.target.reset();
        } catch (_) {}
        await loadCalendar();
      });

      // ── Date + Time Pickers ────────────────────────────────────────────────
      const DP_MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
      let dpYear = new Date().getFullYear();
      let dpMonth = new Date().getMonth();
      let dpSelected = null;
      let tpSelected = null;

      function renderDatePicker() {
        const dpGrid = document.getElementById('apt-dp-grid');
        const dpLabel = document.getElementById('apt-dp-month-label');
        const dpDisplay = document.getElementById('apt-date-display');
        const dpHidden = document.getElementById('apt-date-val');
        if (!dpGrid || !dpLabel) return;
        const pad2 = n => String(n).padStart(2,'0');
        dpLabel.textContent = DP_MONTHS[dpMonth] + ' ' + dpYear;
        const firstDay = new Date(dpYear, dpMonth, 1).getDay();
        const offset = (firstDay === 0 ? 6 : firstDay - 1);
        const daysInMonth = new Date(dpYear, dpMonth + 1, 0).getDate();
        const today = new Date(); today.setHours(0,0,0,0);
        dpGrid.innerHTML = '';
        for (let i = 0; i < offset; i++) {
          const empty = document.createElement('span');
          empty.className = 'apt-dp-cell empty';
          dpGrid.appendChild(empty);
        }
        for (let d = 1; d <= daysInMonth; d++) {
          const cellDate = new Date(dpYear, dpMonth, d);
          const isPast = cellDate < today;
          const isTodayCell = cellDate.getTime() === today.getTime();
          const dateStr = dpYear + '-' + pad2(dpMonth+1) + '-' + pad2(d);
          const isSelected = dpSelected === dateStr;
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.textContent = String(d);
          cell.className = 'apt-dp-cell' + (isPast ? ' past' : '') + (isTodayCell ? ' today' : '') + (isSelected ? ' selected' : '');
          cell.disabled = isPast;
          if (!isPast) {
            cell.addEventListener('click', () => {
              dpSelected = dateStr;
              if (dpHidden) dpHidden.value = dateStr;
              if (dpDisplay) dpDisplay.textContent = d + ' de ' + DP_MONTHS[dpMonth] + ' ' + dpYear;
              renderDatePicker();
            });
          }
          dpGrid.appendChild(cell);
        }
      }

      function renderTimePicker() {
        const tpGrid = document.getElementById('apt-time-grid');
        const tpHidden = document.getElementById('apt-time-val');
        if (!tpGrid) return;
        tpGrid.innerHTML = '';
        const pad2 = n => String(n).padStart(2,'0');
        for (let h = 8; h <= 20; h++) {
          for (const m of [0, 30]) {
            if (h === 20 && m === 30) continue;
            const slot = pad2(h) + ':' + pad2(m);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = slot;
            btn.className = 'apt-time-slot' + (tpSelected === slot ? ' selected' : '');
            btn.addEventListener('click', () => {
              tpSelected = slot;
              if (tpHidden) tpHidden.value = slot;
              renderTimePicker();
            });
            tpGrid.appendChild(btn);
          }
        }
      }

      document.getElementById('apt-dp-prev')?.addEventListener('click', () => {
        dpMonth--; if (dpMonth < 0) { dpMonth = 11; dpYear--; }
        renderDatePicker();
      });
      document.getElementById('apt-dp-next')?.addEventListener('click', () => {
        dpMonth++; if (dpMonth > 11) { dpMonth = 0; dpYear++; }
        renderDatePicker();
      });
      document.getElementById('open-apt-modal')?.addEventListener('click', () => {
        dpYear = new Date().getFullYear(); dpMonth = new Date().getMonth();
        dpSelected = null; tpSelected = null;
        const dh = document.getElementById('apt-date-val');
        const th = document.getElementById('apt-time-val');
        const dd = document.getElementById('apt-date-display');
        if (dh) dh.value = ''; if (th) th.value = '';
        if (dd) dd.textContent = 'Selecciona una fecha';
        renderDatePicker();
        renderTimePicker();
      });

      // Boot
      loadCalendar();
    })();
  </script>

