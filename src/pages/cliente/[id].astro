          }).catch(function () { return null; });
          if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
          showToast(response && response.ok ? 'Cambio solicitado OK' : 'No se pudo solicitar el cambio');
        });
      }
    }

    // ── Calendar ──────────────────────────────────────────────────────
    (function () {
      var currentWeekOffset = 0;
      // Si vistaDia tiene una fecha, el calendario muestra SOLO ese dia a ancho
      // completo. En la semana cada dia ocupa un septimo del ancho y con tres o
      // cuatro citas solapadas no hay quien las lea; en el dia hay sitio.
      var vistaDia = null;
      var DAY_NAMES = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
      var HIDE_ON_MOBILE = [3, 4, 5, 6];

      function getMondayOfWeek(offset) {
        var now = new Date();
        var day = now.getDay();
        var diffToMon = (day === 0 ? -6 : 1 - day);
        var mon = new Date(now);
        mon.setDate(now.getDate() + diffToMon + offset * 7);
        mon.setHours(0, 0, 0, 0);
        return mon;
      }

      function pad(n) { return String(n).padStart(2, '0'); }
      function fmtDate(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
      function fmtTime(iso) { if (!iso) return ''; var d = new Date(iso); return pad(d.getHours()) + ':' + pad(d.getMinutes()); }
      function isToday(d) { var t = new Date(); return d.getFullYear() === t.getFullYear() && d.getMonth() === t.getMonth() && d.getDate() === t.getDate(); }

      var editAptModal = document.getElementById('edit-apt-modal');
      var editAptForm = document.getElementById('edit-apt-form');
      var closeEditAptModal = document.getElementById('close-edit-apt-modal');

      function appointmentName(apt) { return apt.client_name || apt.clientName || 'Cliente sin nombre'; }
      function appointmentPhone(apt) { return apt.client_phone || apt.clientPhone || ''; }

      function openAppointmentEditor(apt) {
        if (!(editAptModal instanceof HTMLDialogElement) || !(editAptForm instanceof HTMLFormElement)) return;
        var d = new Date(apt.datetime);
        editAptForm.elements.apt_id.value = apt.id || '';
        editAptForm.elements.client_name.value = appointmentName(apt) === 'Cliente sin nombre' ? '' : appointmentName(apt);
        editAptForm.elements.client_phone.value = appointmentPhone(apt);
        editAptForm.elements.service.value = apt.service || '';
        editAptForm.elements.date.value = fmtDate(d);
        editAptForm.elements.time.value = fmtTime(apt.datetime);
        editAptForm.elements.duration_min.value = apt.duration_min || 60;
        editAptModal.showModal();
      }

      async function updateAppointment(aptId, changes) {
        try {
          var response = await fetch('/portal-api/appointments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.assign({ clientId: clientId, action: 'update', aptId: aptId }, changes)),
          });
          var payload = await response.json().catch(function () { return {}; });
          if (!response.ok) {
            showToast(payload.error === 'appointment_conflict' ? 'Ese horario ya está ocupado' : 'No se pudo modificar la cita');
            return false;
          }
          showToast('Cita actualizada');
          return true;
        } catch (_) {
          showToast('Error de conexión');
          return false;
        }
      }

      if (closeEditAptModal) closeEditAptModal.addEventListener('click', function () {
        if (editAptModal instanceof HTMLDialogElement) editAptModal.close();
      });

      if (editAptForm) editAptForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        var fd = new FormData(editAptForm);
        var date = String(fd.get('date') || '');
        var time = String(fd.get('time') || '');
        if (!date || !time) { showToast('Indica fecha y hora'); return; }
        if (!window.confirm('¿Confirmas los cambios de esta cita?')) return;
        var ok = await updateAppointment(String(fd.get('apt_id') || ''), {
          client_name: String(fd.get('client_name') || '').trim(),
          client_phone: String(fd.get('client_phone') || '').trim(),
          service: String(fd.get('service') || '').trim(),
          datetime: date + 'T' + time + ':00',
          duration_min: parseInt(String(fd.get('duration_min') || '60'), 10) || 60,
        });
        if (ok && editAptModal instanceof HTMLDialogElement) editAptModal.close();
        await loadCalendar();
      });

      function enableAppointmentDrag(block, apt, columns, monday, minH, maxH, slotHeight, numDias) {
        if (!window.PointerEvent || (apt.status || 'confirmed').toLowerCase() === 'cancelled') return;
        var pointerId = null;
        var startX = 0;
        var startY = 0;
        var grabOffsetY = 0;
        var moved = false;

        block.addEventListener('pointerdown', function (event) {
          if (event.button !== 0 || event.target.closest('button')) return;
          pointerId = event.pointerId;
          startX = event.clientX;
          startY = event.clientY;
          grabOffsetY = event.clientY - block.getBoundingClientRect().top;
          moved = false;
          block.setPointerCapture(pointerId);
        });

        block.addEventListener('pointermove', function (event) {
          if (pointerId !== event.pointerId) return;
          var dx = event.clientX - startX;
          var dy = event.clientY - startY;
          if (!moved && Math.hypot(dx, dy) < 6) return;
          moved = true;
          event.preventDefault();
          block.classList.add('dragging');
          block.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
        });

        block.addEventListener('pointerup', async function (event) {
          if (pointerId !== event.pointerId) return;
          pointerId = null;
          if (!moved) return;
          block.classList.remove('dragging');
          block.style.transform = '';

          var rect = columns.getBoundingClientRect();
          var totalDias = numDias || 7;
          var dayWidth = rect.width / totalDias;
          var dayIndex = Math.max(0, Math.min(totalDias - 1, Math.floor((event.clientX - rect.left) / dayWidth)));
          var duration = parseInt(apt.duration_min || 60, 10) || 60;
          var minute = minH * 60 + Math.round((((event.clientY - rect.top - grabOffsetY) / slotHeight) * 60) / 15) * 15;
          minute = Math.max(minH * 60, Math.min(maxH * 60 - duration, minute));
          var targetDay = new Date(monday);
          targetDay.setDate(monday.getDate() + dayIndex);
          var targetDatetime = fmtDate(targetDay) + 'T' + pad(Math.floor(minute / 60)) + ':' + pad(minute % 60) + ':00';
          var current = new Date(apt.datetime);
          var currentLocal = fmtDate(current) + 'T' + fmtTime(apt.datetime) + ':00';
          if (targetDatetime === currentLocal) { await loadCalendar(); return; }

          var readable = targetDay.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
          var targetTime = pad(Math.floor(minute / 60)) + ':' + pad(minute % 60);
          if (!window.confirm('¿Mover la cita de ' + appointmentName(apt) + ' al ' + readable + ' a las ' + targetTime + '?')) {
            await loadCalendar();
            return;
          }
          await updateAppointment(apt.id, { datetime: targetDatetime });
          await loadCalendar();
        });

        block.addEventListener('pointercancel', function () {
          pointerId = null;
          block.classList.remove('dragging');
          block.style.transform = '';
        });
      }

      async function loadCalendar() {
        // Reparte en columnas las citas que se pisan en el tiempo. Devuelve, por
        // cita, en que columna va y cuantas hay en su grupo.
        function repartirSolapes(lista) {
          var mapa = {};
          var grupo = [];
          var finGrupo = 0;

          function cerrarGrupo() {
            if (!grupo.length) return;
            var columnas = [];
            grupo.forEach(function (cita) {
              var inicio = new Date(cita.datetime).getTime();
              var fin = inicio + (cita.duration_min || 60) * 60000;
              var c = 0;
              while (columnas[c] !== undefined && columnas[c] > inicio) c += 1;
              columnas[c] = fin;
              mapa[cita.id] = { columna: c, total: 1 };
            });
            grupo.forEach(function (cita) { mapa[cita.id].total = columnas.length; });
            grupo = [];
            finGrupo = 0;
          }

          lista.forEach(function (cita) {
            var inicio = new Date(cita.datetime).getTime();
            var fin = inicio + (cita.duration_min || 60) * 60000;
            if (grupo.length && inicio >= finGrupo) cerrarGrupo();
            grupo.push(cita);
            finGrupo = Math.max(finGrupo, fin);
          });
          cerrarGrupo();
          return mapa;
        }

        var grid = document.getElementById('cal-grid');
        var label = document.getElementById('cal-week-label');
        if (!grid) return;
        grid.innerHTML = '<p class="crm-empty">Cargando…</p>';
        var apts = [];
        try {
          var res = await fetch('/portal-api/appointments?clientId=' + clientId);
          if (res.ok) apts = await res.json();
        } catch (e) {
          grid.innerHTML = '<p class="crm-empty">Error al cargar citas</p>';
          return;
        }
        var esDia = !!vistaDia;
        var monday = getMondayOfWeek(currentWeekOffset);
        var diaBase = esDia ? new Date(vistaDia) : monday;
        var numDias = esDia ? 1 : 7;

        if (label) {
          if (esDia) {
            label.textContent = diaBase.toLocaleDateString('es-ES', {
              weekday: 'long', day: 'numeric', month: 'long',
            });
          } else {
            var sunday = new Date(monday);
            sunday.setDate(monday.getDate() + 6);
            label.textContent = monday.getDate() + '/' + (monday.getMonth() + 1) + ' – '
              + sunday.getDate() + '/' + (sunday.getMonth() + 1) + '/' + sunday.getFullYear();
          }
        }
        // El boton de volver solo tiene sentido dentro de un dia.
        var btnSemana = document.getElementById('cal-week-back');
        if (btnSemana) btnSemana.classList.toggle('crm-hidden', !esDia);

        var schedObj = {};
        try { schedObj = JSON.parse(scheduleJson || '{}'); } catch (_) {}
        var dayKeyList = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
        var minH = 9, maxH = 20;
        dayKeyList.forEach(function(k) {
          var s = schedObj[k];
          if (!s) return;
          var o = parseInt((s.open || '09:00').split(':')[0], 10);
          var c = parseInt((s.close || '20:00').split(':')[0], 10);
          if (o < minH) minH = o;
          if (c > maxH) maxH = c;
        });
        var SLOT_H = 52;
        var totalH = (maxH - minH) * SLOT_H;

        grid.innerHTML = '';
        grid.className = 'crm-tac' + (esDia ? ' crm-tac--dia' : '');

        var hdrEl = document.createElement('div');
        hdrEl.className = 'crm-tac-header';
        hdrEl.style.gridTemplateColumns = '52px repeat(' + numDias + ', 1fr)';
        var corner = document.createElement('div');
        corner.className = 'crm-tac-corner';
        hdrEl.appendChild(corner);
        for (var di = 0; di < numDias; di++) {
          var dDay = new Date(diaBase);
          dDay.setDate(diaBase.getDate() + di);
          var dh2 = document.createElement('div');
          dh2.className = 'crm-tac-day-hdr' + (isToday(dDay) ? ' today' : '') + (esDia ? '' : ' pinchable');
          var nombreDia = esDia
            ? dDay.toLocaleDateString('es-ES', { weekday: 'long' })
            : DAY_NAMES[di];
          dh2.innerHTML = '<span class="crm-tac-dn">' + nombreDia + '</span>'
            + '<span class="crm-tac-dd">' + dDay.getDate() + '</span>';
          if (!esDia) {
            // Pinchar el dia lo abre a solas: es donde caben las citas solapadas.
            dh2.setAttribute('role', 'button');
            dh2.setAttribute('tabindex', '0');
            dh2.title = 'Ver solo este día';
            (function (fecha) {
              function abrir() { vistaDia = fecha; loadCalendar(); }
              dh2.addEventListener('click', abrir);
              dh2.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(); }
              });
            })(new Date(dDay));
          }
          hdrEl.appendChild(dh2);
        }
        grid.appendChild(hdrEl);

        var scrollEl = document.createElement('div');
        scrollEl.className = 'crm-tac-scroll';

        var innerEl = document.createElement('div');
        innerEl.className = 'crm-tac-inner';
        innerEl.style.height = totalH + 'px';

        var timeColEl = document.createElement('div');
        timeColEl.className = 'crm-tac-time-col';
        timeColEl.style.height = totalH + 'px';
        for (var th3 = minH; th3 <= maxH; th3++) {
          var tl = document.createElement('div');
          tl.className = 'crm-tac-time-lbl';
          tl.style.top = ((th3 - minH) * SLOT_H) + 'px';
          tl.textContent = pad(th3) + ':00';
          timeColEl.appendChild(tl);
        }
        innerEl.appendChild(timeColEl);

        var colsEl = document.createElement('div');
        colsEl.className = 'crm-tac-cols';
        colsEl.style.height = totalH + 'px';
        colsEl.style.position = 'relative';

        colsEl.style.gridTemplateColumns = 'repeat(' + numDias + ', 1fr)';
        for (var ci = 0; ci < numDias; ci++) {
          var cDay = new Date(diaBase);
          cDay.setDate(diaBase.getDate() + ci);
          var cStr = fmtDate(cDay);
          var cApts = apts.filter(function(a) { return fmtDate(new Date(a.datetime)) === cStr; });
          // Con varias agendas puede haber dos citas a la misma hora. Antes se
          // pintaban una encima de otra y la de debajo era invisible: se reparte
          // el ancho de la columna entre las que se solapan.
          cApts.sort(function(a, b) { return new Date(a.datetime) - new Date(b.datetime); });
          var colocacion = repartirSolapes(cApts);

          var col = document.createElement('div');
          col.className = 'crm-tac-col' + (isToday(cDay) ? ' today' : '');

          cApts.forEach(function(apt) {
            var aptD2 = new Date(apt.datetime);
            var fracH = aptD2.getHours() + aptD2.getMinutes() / 60;
            var dur = (apt.duration_min || 60) / 60;
            var top = (fracH - minH) * SLOT_H;
            var height = Math.max(dur * SLOT_H, 26);
            if (fracH < minH || fracH >= maxH) return;
            var st2 = (apt.status || 'confirmed').toLowerCase();
            var blk = document.createElement('div');
            blk.className = 'crm-tac-apt ' + st2;
            blk.style.top = top + 'px';
            blk.style.height = height + 'px';

            var sitio = colocacion[apt.id] || { columna: 0, total: 1 };
            if (sitio.total > 1) {
              var ancho = 100 / sitio.total;
              blk.style.left = (sitio.columna * ancho) + '%';
              blk.style.width = 'calc(' + ancho + '% - 3px)';
              blk.classList.add('compartido');
            }

            // Quien atiende: nombre y color, solo si el negocio tiene equipo.
            var quien = null;
            if (apt.professional_id) {
              for (var qi = 0; qi < equipo.length; qi++) {
                if (equipo[qi].id === apt.professional_id) { quien = equipo[qi]; break; }
              }
            }
            var nombreQuien = quien ? quien.name : (apt.professional_name || '');
            var mostrarQuien = (modoEquipo || sitio.total > 1) && nombreQuien
              && nombreQuien !== 'Agenda principal';
            if (mostrarQuien && quien && quien.color) {
              blk.style.borderLeft = '3px solid ' + quien.color;
            }

            blk.title = appointmentName(apt) + ' · ' + (apt.service || 'Sin servicio') + ' · ' + fmtTime(apt.datetime)
              + (mostrarQuien ? ' · ' + nombreQuien : '');
            blk.innerHTML =
              '<span class="crm-tac-apt-main"><strong>' + fmtTime(apt.datetime) + '</strong><span>' + esc(appointmentName(apt)) + '</span></span>' +
              '<span class="crm-tac-apt-s">' + esc(apt.service || 'Sin servicio') + '</span>' +
              (mostrarQuien ? '<span class="crm-tac-apt-pro">' + esc(nombreQuien) + '</span>' : '');
            if (st2 !== 'cancelled') {
              var actions = document.createElement('span');
              actions.className = 'crm-tac-apt-actions';
              var eb = document.createElement('button');
              eb.type = 'button';
              eb.className = 'crm-cal-apt-edit';
              eb.textContent = '✎';
              eb.title = 'Editar cita';
              eb.setAttribute('aria-label', 'Editar cita de ' + appointmentName(apt));
              (function(aa, bb) {
                bb.addEventListener('click', function(event) {
                  event.stopPropagation();
                  openAppointmentEditor(aa);
                });
              })(apt, eb);
              var cb = document.createElement('button');
              cb.type = 'button';
              cb.className = 'crm-cal-apt-cancel';
              cb.textContent = '×';
              cb.title = 'Cancelar cita';
              cb.setAttribute('aria-label', 'Cancelar cita de ' + appointmentName(apt));
              (function(aa, bb) {
                bb.addEventListener('click', async function(event) {
                  event.stopPropagation();
                  if (!window.confirm('¿Confirmas que quieres cancelar la cita de ' + appointmentName(aa) + '?')) return;
                  bb.disabled = true;
                  try { await fetch('/portal-api/appointments', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({clientId, action:'cancel', aptId:aa.id}) }); } catch(_){}
                  await loadCalendar();
                });
              })(apt, cb);
              actions.appendChild(eb);
              actions.appendChild(cb);
              blk.appendChild(actions);
              enableAppointmentDrag(blk, apt, colsEl, diaBase, minH, maxH, SLOT_H, numDias);
            }
            col.appendChild(blk);
          });
          colsEl.appendChild(col);
        }

        var nowD = new Date(); var nowFrac = nowD.getHours() + nowD.getMinutes() / 60;
        if (nowFrac >= minH && nowFrac <= maxH) {
          var nowLine = document.createElement('div');
          nowLine.className = 'crm-tac-now-line';
          nowLine.style.top = ((nowFrac - minH) * SLOT_H) + 'px';
          colsEl.appendChild(nowLine);
        }
        innerEl.appendChild(colsEl);
        scrollEl.appendChild(innerEl);
        grid.appendChild(scrollEl);
      }

      var calPrev = document.getElementById('cal-prev');
      var calNext = document.getElementById('cal-next');
      function moverCalendario(pasos) {
        if (vistaDia) {
          var d = new Date(vistaDia);
          d.setDate(d.getDate() + pasos);
          vistaDia = d;
        } else {
          currentWeekOffset += pasos;
        }
        loadCalendar();
      }
      if (calPrev) calPrev.addEventListener('click', function () { moverCalendario(-1); });
      if (calNext) calNext.addEventListener('click', function () { moverCalendario(1); });

      var calBack = document.getElementById('cal-week-back');
      if (calBack) {
        calBack.addEventListener('click', function () {
          // Volver a la semana del dia que se estaba mirando, no a la de hoy.
          if (vistaDia) {
            var lunesHoy = getMondayOfWeek(0);
            var lunesDia = new Date(vistaDia);
            lunesDia.setDate(lunesDia.getDate() - ((lunesDia.getDay() + 6) % 7));
            currentWeekOffset = Math.round((lunesDia - lunesHoy) / (7 * 86400000));
          }
          vistaDia = null;
          loadCalendar();
        });
      }

      var aptModal = document.getElementById('new-apt-modal');
      var openBtn = document.getElementById('open-apt-modal');
      var closeBtn = document.getElementById('close-apt-modal');
      if (openBtn) {
        openBtn.addEventListener('click', function () {
          dpYear = new Date().getFullYear(); dpMonth = new Date().getMonth();
          dpSelected = null; tpSelected = null;
          var dh = document.getElementById('apt-date-val'); if (dh) dh.value = '';
          var th = document.getElementById('apt-time-val'); if (th) th.value = '';
          var dd = document.getElementById('apt-date-display'); if (dd) dd.textContent = 'Selecciona una fecha';
          var svcList = document.getElementById('svc-suggest');
          if (svcList) svcList.innerHTML = services.map(function(s) { return '<option value="' + esc(s.name) + '">'; }).join('');
          // El selector de persona solo aparece si de verdad hay equipo.
          var proWrap = document.getElementById('apt-pro-wrap');
          var proSel = document.getElementById('apt-pro');
          if (proWrap && proSel) {
            if (modoEquipo && equipo.length > 1) {
              proSel.innerHTML = '<option value="">Quien esté libre</option>'
                + equipo.map(function (profesional) {
                  return '<option value="' + esc(profesional.id) + '">' + esc(profesional.name) + '</option>';
                }).join('');
              proWrap.classList.remove('crm-hidden');
            } else {
              proWrap.classList.add('crm-hidden');
            }
          }
          var errBox = document.getElementById('apt-error');
          if (errBox) { errBox.textContent = ''; errBox.classList.add('crm-hidden'); }
          renderDatePicker(); renderTimePicker();
          if (aptModal instanceof HTMLDialogElement) aptModal.showModal();
        });
      }
      if (closeBtn) closeBtn.addEventListener('click', function () { if (aptModal instanceof HTMLDialogElement) aptModal.close(); });

      var aptForm = document.getElementById('new-apt-form');
      if (aptForm) {
        aptForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          var fd = new FormData(e.target);
          var date = fd.get('date'); var time = fd.get('time');
          if (!date || !time) { showToast('Selecciona fecha y hora'); return; }
          var errBox = document.getElementById('apt-error');
          if (errBox) { errBox.textContent = ''; errBox.classList.add('crm-hidden'); }
          try {
            var cuerpo = {
              clientId: clientId,
              client_name: fd.get('client_name'),
              service: fd.get('service'),
              datetime: date + 'T' + time + ':00',
              duration_min: parseInt(fd.get('duration_min'), 10) || 60,
            };
            var proElegido = fd.get('professional_id');
            if (proElegido) cuerpo.professional_id = proElegido;

            var r = await fetch('/portal-api/appointments', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(cuerpo)
            });
            if (!r.ok) {
              // 409 = esa hora ya está cogida. Antes se decía "error" a secas.
              var detalle = await r.json().catch(function () { return {}; });
              var texto = r.status === 409
                ? (detalle.message || 'Esa hora ya está ocupada. Elige otra o cambia de persona.')
                : 'No se pudo crear la cita.';
              if (errBox) { errBox.textContent = texto; errBox.classList.remove('crm-hidden'); }
              showToast(texto);
              return;
            }
            showToast('Cita creada ✅');
            if (aptModal instanceof HTMLDialogElement) aptModal.close();
            e.target.reset();
          } catch (_) { showToast('Error al crear la cita'); }
          await loadCalendar();
        });
      }

      loadCalendar();
    })();

    // ── Date + Time Pickers ───────────────────────────────────────────
    var DP_MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var dpYear = new Date().getFullYear();
    var dpMonth = new Date().getMonth();
    var dpSelected = null;
    var tpSelected = null;

    function renderDatePicker() {
      var dpGrid = document.getElementById('apt-dp-grid');
      var dpLabel = document.getElementById('apt-dp-month-label');
      var dpDisplay = document.getElementById('apt-date-display');
      var dpHidden = document.getElementById('apt-date-val');
      if (!dpGrid || !dpLabel) return;
      var pad2 = function (n) { return String(n).padStart(2, '0'); };
      dpLabel.textContent = DP_MONTHS[dpMonth] + ' ' + dpYear;
      var firstDay = new Date(dpYear, dpMonth, 1).getDay();
      var offset = (firstDay === 0 ? 6 : firstDay - 1);
      var daysInMonth = new Date(dpYear, dpMonth + 1, 0).getDate();
      var today = new Date(); today.setHours(0, 0, 0, 0);
      dpGrid.innerHTML = '';
      for (var i = 0; i < offset; i++) {
        var empty = document.createElement('span'); empty.className = 'apt-dp-cell empty'; dpGrid.appendChild(empty);
      }
      for (var d = 1; d <= daysInMonth; d++) {
        var cellDate = new Date(dpYear, dpMonth, d);
        var isPast = cellDate < today;
        var isTodayCell = cellDate.getTime() === today.getTime();
        var dateStr = dpYear + '-' + pad2(dpMonth + 1) + '-' + pad2(d);
        var isSelected = dpSelected === dateStr;
        var cell = document.createElement('button');
        cell.type = 'button';
        cell.textContent = String(d);
        cell.className = 'apt-dp-cell' + (isPast ? ' past' : '') + (isTodayCell ? ' today' : '') + (isSelected ? ' selected' : '');
        cell.disabled = isPast;
        if (!isPast) {
          (function (dd, ds) {
            cell.addEventListener('click', function () {
              dpSelected = ds;
              if (dpHidden) dpHidden.value = ds;
              if (dpDisplay) dpDisplay.textContent = dd + ' de ' + DP_MONTHS[dpMonth] + ' ' + dpYear;
              tpSelected = null;
              var th2 = document.getElementById('apt-time-val'); if (th2) th2.value = '';
              renderDatePicker();
              renderTimePicker();
            });
          })(d, dateStr);
        }
        dpGrid.appendChild(cell);
      }
    }

    function renderTimePicker() {
      var tpGrid = document.getElementById('apt-time-grid');
      var tpHidden = document.getElementById('apt-time-val');
      if (!tpGrid) return;
      tpGrid.innerHTML = '';
      var pad2 = function (n) { return String(n).padStart(2, '0'); };
      var dayStart = 8, dayEnd = 20, lunchClose = null, lunchOpen = null;
      if (dpSelected) {
        var sched2 = {};
        try { sched2 = JSON.parse(scheduleJson || '{}'); } catch (_) {}
        var dow = new Date(dpSelected + 'T12:00:00').getDay();
        var dowKey = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][dow];
        var ds = sched2[dowKey];
        if (ds) {
          dayStart = parseInt((ds.open || '08:00').split(':')[0], 10);
          dayEnd = parseInt((ds.close || '20:00').split(':')[0], 10);
          if (ds.lunch_close) lunchClose = ds.lunch_close;
          if (ds.lunch_open) lunchOpen = ds.lunch_open;
        }
      }
      for (var h = dayStart; h <= dayEnd; h++) {
        for (var mi = 0; mi < 2; mi++) {
          var m = mi * 30;
          if (h === dayEnd && m > 0) continue;
          var slot = pad2(h) + ':' + pad2(m);
          if (lunchClose && lunchOpen && slot >= lunchClose && slot < lunchOpen) continue;
          (function (sl) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = sl;
            btn.className = 'apt-time-slot' + (tpSelected === sl ? ' selected' : '');
            btn.addEventListener('click', function () { tpSelected = sl; if (tpHidden) tpHidden.value = sl; renderTimePicker(); });
            tpGrid.appendChild(btn);
          })(slot);
        }
      }
      if (!tpGrid.children.length) {
        tpGrid.innerHTML = '<span style="font-size:12px;color:var(--crm-muted)">Día cerrado o sin horario</span>';
      }
    }

    var dpPrev = document.getElementById('apt-dp-prev');
    var dpNext = document.getElementById('apt-dp-next');
    if (dpPrev) dpPrev.addEventListener('click', function () { dpMonth--; if (dpMonth < 0) { dpMonth = 11; dpYear--; } renderDatePicker(); });
    if (dpNext) dpNext.addEventListener('click', function () { dpMonth++; if (dpMonth > 11) { dpMonth = 0; dpYear++; } renderDatePicker(); });


    // ── Missed call ────────────────────────────────────────────────────
    var missedBtn = document.getElementById('btn-missed-call');
    if (missedBtn) {
      missedBtn.addEventListener('click', async function () {
        var phone = document.getElementById('missed-call-phone').value.trim().replace(/\s/g, '');
        if (!phone) { showToast('Introduce el teléfono'); return; }
        missedBtn.disabled = true; missedBtn.textContent = 'Enviando...';
        try {
          var r = await fetch('/portal-api/missed-call', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId, phone: phone }),
          });
          var d = await r.json();
          if (d.ok) {
            showToast(d.channel === 'whatsapp' ? '✅ Lara le ha escrito por WhatsApp' : '✅ Propietario notificado por Telegram');
            document.getElementById('missed-call-phone').value = '';
          } else { showToast('Error: ' + (d.error || 'no disponible')); }
        } catch (_) { showToast('Error de conexión'); }
        missedBtn.disabled = false; missedBtn.textContent = 'Enviar';
      });
    }

    // ── Regenerate web ─────────────────────────────────────────────────
    var regenBtn = document.getElementById('btn-regen-web');
    if (regenBtn) {
      regenBtn.addEventListener('click', async function () {
        regenBtn.disabled = true; regenBtn.textContent = 'Generando...';
        try {
          var r = await fetch('/portal-api/regenerate-web', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId }),
          });
          var d = await r.json();
          if (d.ok && d.url) {
            document.getElementById('web-url-display').innerHTML = '<a href="' + d.url + '" target="_blank" style="color:#4ECDC4">' + d.url + '</a>';
            showToast('✅ Mini-web generada');
          } else { showToast('Error generando la web: ' + (d.error || '')); }
        } catch (_) { showToast('Error de conexión'); }
        regenBtn.disabled = false; regenBtn.textContent = 'Generar web';
      });
    }

    // ── Billing portal button ──────────────────────────────────────────
    var billingBtn = document.getElementById('btn-billing-portal');
    if (billingBtn) {
      billingBtn.addEventListener('click', async function () {
        billingBtn.disabled = true;
        billingBtn.textContent = 'Cargando...';
        try {
          var r = await fetch('/portal-api/billing?clientId=' + encodeURIComponent(clientId));
          var d = await r.json();
          if (d.url) {
            window.location.href = d.url;
          } else {
            // Un "no se pudo" a secas deja al dueno sin saber si es culpa suya. Se
            // distingue el caso de no tener suscripcion del de Stripe fallando.
            showToast(d && d.error === 'billing_unavailable'
              ? 'Esta cuenta no tiene suscripción activa en Stripe'
              : 'No se pudo abrir el portal de facturación. Inténtalo en un minuto.');
            billingBtn.disabled = false;
            billingBtn.textContent = 'Gestionar suscripción';
          }
        } catch (_) {
          showToast('Error de conexión');
          billingBtn.disabled = false;
          billingBtn.textContent = 'Gestionar suscripción';
        }
      });
    }

    // ── Invoices loader ────────────────────────────────────────────────
    function loadInvoices() {
      var loading = document.getElementById('invoices-loading');
      var empty = document.getElementById('invoices-empty');
      var table = document.getElementById('invoices-table');
      var tbody = document.getElementById('invoices-tbody');
      if (!loading || !tbody) return;
      fetch('/portal-api/invoices?clientId=' + encodeURIComponent(clientId))
        .then(function(r) { return r.json(); })
        .then(function(d) {
          loading.classList.add('crm-hidden');
          if (!d.ok || !d.invoices || d.invoices.length === 0) {
            empty.classList.remove('crm-hidden');
            return;
          }
          d.invoices.forEach(function(inv) {
            var date = new Date(inv.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
            var amount = inv.amount.toFixed(2) + ' ' + inv.currency;
            var statusLabel = inv.status === 'paid' ? '<span class="inv-status paid">Pagada</span>' :
              inv.status === 'open' ? '<span class="inv-status open">Pendiente</span>' :
              '<span class="inv-status other">' + inv.status + '</span>';
            var downloadBtn = inv.pdf ? '<a href="' + inv.pdf + '" target="_blank" class="inv-dl-btn">PDF</a>' : '';
            var tr = document.createElement('tr');
            tr.innerHTML = '<td>' + date + '</td><td>' + (inv.description || 'Suscripción Nexux') + '</td><td>' + amount + '</td><td>' + statusLabel + '</td><td>' + downloadBtn + '</td>';
            tbody.appendChild(tr);
          });
          table.classList.remove('crm-hidden');
        })
        .catch(function() {
          loading.classList.add('crm-hidden');
          empty.classList.remove('crm-hidden');
        });
    }

    // Load invoices when billing nav button is clicked
    var billingNavBtn = document.querySelector('.crm-nav-btn[data-view=billing]');
    if (billingNavBtn) {
      billingNavBtn.addEventListener('click', function() {
        var table = document.getElementById('invoices-table');
        if (table && !table.classList.contains('inv-loaded')) {
          table.classList.add('inv-loaded');
          loadInvoices();
        }
      });
    }
    // Also load if billing is the initial view
    if ((localStorage.getItem('crm-view') || 'dashboard') === 'billing') {
      var table = document.getElementById('invoices-table');
      if (table) { table.classList.add('inv-loaded'); loadInvoices(); }
    }

  })();
  </script>

