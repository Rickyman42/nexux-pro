            <button type="button" id="apt-dp-next">→</button>
          </div>
          <div class="apt-dp-weekdays"><span>Lu</span><span>Ma</span><span>Mi</span><span>Ju</span><span>Vi</span><span>Sá</span><span>Do</span></div>
          <div class="apt-dp-grid" id="apt-dp-grid"></div>
        </div>
        <span class="apt-date-display" id="apt-date-display">Selecciona una fecha</span>
        <input type="hidden" name="date" id="apt-date-val" />
      </div>
      <div class="crm-field-grp">
        <span class="crm-field-lbl">Hora</span>
        <div class="apt-time-picker" id="apt-time-grid"></div>
        <input type="hidden" name="time" id="apt-time-val" />
      </div>
      <label class="crm-form-lbl">
        Duración (min)
        <input type="number" name="duration_min" value="60" min="15" step="15" class="crm-input" />
      </label>
      <label class="crm-form-lbl crm-hidden" id="apt-pro-wrap">
        Quién atiende
        <select name="professional_id" id="apt-pro" class="crm-input">
          <option value="">Quien esté libre</option>
        </select>
      </label>
      <p class="crm-apt-error crm-hidden" id="apt-error" role="alert"></p>
      <div class="crm-modal-actions">
        <button type="submit" class="crm-btn-primary">Reservar cita</button>
        <button type="button" id="close-apt-modal" class="crm-btn-ghost">Cancelar</button>
      </div>
    </form>
  </dialog>

  <dialog id="edit-apt-modal" class="crm-dialog">
    <form id="edit-apt-form" class="crm-modal-form">
      <h3>Editar cita</h3>
      <input type="hidden" name="apt_id" />
      <label class="crm-form-lbl">
        Nombre del cliente
        <input type="text" name="client_name" required maxlength="120" class="crm-input" />
      </label>
      <label class="crm-form-lbl">
        Teléfono
        <input type="tel" name="client_phone" maxlength="40" class="crm-input" />
      </label>
      <label class="crm-form-lbl">
        Servicio
        <input type="text" name="service" required maxlength="160" class="crm-input" list="svc-suggest" autocomplete="off" />
      </label>
      <div class="crm-edit-date-row">
        <label class="crm-form-lbl">
          Fecha
          <input type="date" name="date" required class="crm-input" />
        </label>
        <label class="crm-form-lbl">
          Hora
          <input type="time" name="time" required step="900" class="crm-input" />
        </label>
      </div>
      <label class="crm-form-lbl">
        Duración (min)
        <input type="number" name="duration_min" value="60" min="15" max="480" step="15" class="crm-input" />
      </label>
      <p class="crm-edit-hint">Antes de guardar te pediremos confirmación.</p>
      <div class="crm-modal-actions">
        <button type="submit" class="crm-btn-primary">Guardar cambios</button>
        <button type="button" id="close-edit-apt-modal" class="crm-btn-ghost">Cerrar</button>
      </div>
    </form>
  </dialog>

  <script define:vars={{ clientId, currentProvider: data.channels.whatsapp.provider, isStarter: !hasLegacyAdvancedTools, customerTelegramUrl, servicesJson: JSON.stringify(data.services ?? []), scheduleJson: JSON.stringify(data.schedule ?? {}) }}>
  (function () {

    // ── Theme ─────────────────────────────────────────────────────────
    const crm = document.getElementById('crm');
    const themeBtn = document.getElementById('crm-theme-btn');

    function applyTheme(t) {
      var cls = t === 'dark' ? 'crm-dark' : 'crm-light';
      crm.className = cls;
      // Los <dialog> viven fuera de #crm (top-layer): heredan el tema por su propia clase
      document.querySelectorAll('.crm-dialog').forEach(function (d) {
        d.classList.remove('crm-light', 'crm-dark');
        d.classList.add(cls);
      });
      localStorage.setItem('crm-theme', t);
    }
    applyTheme(localStorage.getItem('crm-theme') || 'light');

    themeBtn && themeBtn.addEventListener('click', function () {
      applyTheme(crm.classList.contains('crm-dark') ? 'light' : 'dark');
    });

    // ── Navigation ────────────────────────────────────────────────────
    const burger = document.getElementById('crm-burger');
    const overlay = document.getElementById('crm-overlay');
    const navBtns = document.querySelectorAll('.crm-nav-btn');
    const views = document.querySelectorAll('.crm-view');
    const viewStorageKey = 'crm-view:' + clientId;
    localStorage.setItem('crm-last-client', clientId);

    burger && burger.addEventListener('click', function () { crm.classList.toggle('sidebar-open'); });
    overlay && overlay.addEventListener('click', function () { crm.classList.remove('sidebar-open'); });

    function showView(viewId) {
      views.forEach(function (v) { v.classList.add('crm-hidden'); });
      navBtns.forEach(function (b) { b.classList.remove('active'); });
      var el = document.getElementById('v-' + viewId);
      if (el) el.classList.remove('crm-hidden');
      var nb = document.querySelector('.crm-nav-btn[data-view="' + viewId + '"]');
      if (nb) nb.classList.add('active');
      localStorage.setItem(viewStorageKey, viewId);
      crm.classList.remove('sidebar-open');
    }

    // Inbox iframe — lazy load on first click
    var inboxLoaded = false;
    var piBase = 'https://pi.nexux.pro';
    var inboxToken = document.getElementById('crm').dataset.inboxToken || '';
    var inboxUrl = piBase + '/client/' + clientId + '/inbox?t=' + encodeURIComponent(inboxToken);

    navBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        showView(btn.dataset.view);
        if (btn.dataset.view === 'clientes' && !clientesCargados) cargarClientes();
        if (btn.dataset.view === 'conversaciones' && !inboxLoaded) {
          var iframe = document.getElementById('inbox-iframe');
          if (iframe) { iframe.src = inboxUrl; inboxLoaded = true; }
        }
      });
    });

    showView(localStorage.getItem(viewStorageKey) || localStorage.getItem('crm-view') || 'dashboard');

    // ── Toast ─────────────────────────────────────────────────────────
    var toast = document.getElementById('portal-toast');
    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.hidden = false;
      toast.classList.add('crm-toast-show');
      setTimeout(function () { toast.classList.remove('crm-toast-show'); toast.hidden = true; }, 2200);
    }

    // ── Schedule ──────────────────────────────────────────────────────
    var scheduleForm = document.getElementById('schedule-form');

    function buildSchedulePayload(form) {
      var payload = {};
      ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'].forEach(function (day) {
        var closed = form.elements.namedItem(day + '_closed');
        if (closed instanceof HTMLInputElement && closed.checked) { payload[day] = null; return; }
        var open = form.elements.namedItem(day + '_open');
        var close = form.elements.namedItem(day + '_close');
        var lunchCheck = form.elements.namedItem(day + '_lunch');
        var lunchClose = form.elements.namedItem(day + '_lunch_close');
        var lunchOpen = form.elements.namedItem(day + '_lunch_open');
        var hasLunch = lunchCheck instanceof HTMLInputElement && lunchCheck.checked;
        payload[day] = {
          open: open instanceof HTMLInputElement ? open.value : '09:00',
          close: close instanceof HTMLInputElement ? close.value : '19:00',
        };
        if (hasLunch) {
          payload[day].lunch_close = lunchClose instanceof HTMLInputElement ? lunchClose.value : '14:00';
          payload[day].lunch_open = lunchOpen instanceof HTMLInputElement ? lunchOpen.value : '16:00';
        }
      });
      return payload;
    }

    if (scheduleForm) {
      scheduleForm.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
        input.addEventListener('change', function (event) {
          var target = event.currentTarget;
          if (!(target instanceof HTMLInputElement)) return;
          if (target.name.endsWith('_closed')) {
            var day = target.name.replace('_closed', '');
            var isClosed = target.checked;
            ['open','close','lunch_close','lunch_open'].forEach(function (f) {
              var el = scheduleForm.elements.namedItem(day + '_' + f);
              if (el instanceof HTMLInputElement) el.disabled = isClosed;
            });
            var lunchCheck = scheduleForm.elements.namedItem(day + '_lunch');
            if (lunchCheck instanceof HTMLInputElement) {
              lunchCheck.disabled = isClosed;
              if (!isClosed) {
                ['lunch_close','lunch_open'].forEach(function (f) {
                  var el = scheduleForm.elements.namedItem(day + '_' + f);
                  if (el instanceof HTMLInputElement) el.disabled = !lunchCheck.checked;
                });
              }
            }
          } else if (target.name.endsWith('_lunch')) {
            var day2 = target.name.replace('_lunch', '');
            ['lunch_close','lunch_open'].forEach(function (f) {
              var el = scheduleForm.elements.namedItem(day2 + '_' + f);
              if (el instanceof HTMLInputElement) el.disabled = !target.checked;
            });
          }
        });
      });

      scheduleForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        if (!(scheduleForm instanceof HTMLFormElement)) return;
        var response = await fetch('/portal-api/update-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId, config: { schedule: buildSchedulePayload(scheduleForm) } }),
        }).catch(function () { return null; });
        showToast(response && response.ok ? 'Guardado OK' : 'No se pudo guardar');
      });
    }

    // ── Services ──────────────────────────────────────────────────────
    var services = JSON.parse(servicesJson || '[]');

    function esc(s) { var d = document.createElement('div'); d.textContent = String(s != null ? s : ''); return d.innerHTML; }

    function renderServices() {
      var wrap = document.getElementById('services-list-wrap');
      if (!wrap) return;
      if (services.length === 0) {
        wrap.innerHTML = '<p class="crm-empty">Sin servicios. Añade el primero.</p>';
        return;
      }
      wrap.innerHTML = '<div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Servicio</th><th>Duración</th><th>Precio</th><th></th></tr></thead><tbody>' +
        services.map(function (s, i) {
          return '<tr><td>' + esc(s.name) + '</td><td>' + esc(s.duration) + ' min</td><td>' + esc(s.price) + ' €</td><td><button type="button" class="crm-btn-del" data-i="' + i + '">🗑</button></td></tr>';
        }).join('') + '</tbody></table></div>';
      wrap.querySelectorAll('.crm-btn-del').forEach(function (btn) {
        btn.addEventListener('click', function () { services.splice(parseInt(btn.dataset.i), 1); renderServices(); });
      });
    }
    renderServices();

    var svcAdd = document.getElementById('svc-add');
    if (svcAdd) {
      svcAdd.addEventListener('click', function () {
        var nameInput = document.getElementById('svc-name');
        var durInput = document.getElementById('svc-duration');
        var priceInput = document.getElementById('svc-price');
        var name = nameInput ? nameInput.value.trim() : '';
        var duration = parseInt(durInput ? durInput.value : '');
        var price = parseFloat(priceInput ? priceInput.value : '');
        if (!name) { showToast('Nombre obligatorio'); return; }
        if (!duration || duration <= 0) { showToast('Duración inválida'); return; }
        if (isNaN(price) || price < 0) { showToast('Precio inválido'); return; }
        services.push({ name: name, duration: duration, price: price });
        renderServices();
        if (nameInput) nameInput.value = '';
        if (durInput) durInput.value = '';
        if (priceInput) priceInput.value = '';
      });
    }

    var svcSave = document.getElementById('svc-save');
    if (svcSave) {
      svcSave.addEventListener('click', async function () {
        var response = await fetch('/portal-api/update-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId, config: { services: services } }),
        }).catch(function () { return null; });
        showToast(response && response.ok ? 'Guardado ✅' : 'No se pudo guardar');
      });
    }

    // ── Equipo (varias agendas) ───────────────────────────────────────
    // Con el modo equipo activo, cada persona tiene su agenda: puede haber dos
    // citas a la misma hora. Con una sola persona todo funciona como siempre.
    var COLORES_EQUIPO = ['#2A9D97', '#C2683F', '#5C6BC0', '#8E6BA8', '#4A8F5B', '#B5804A'];
    var equipo = [];
    var modoEquipo = false;
    // Agendas de Google donde el negocio puede escribir, y si su plan permite
    // dar una a cada persona. Lo segundo lo dice el servidor: aqui no se
    // duplica la tabla de planes.
    var calendariosGoogle = [];
    var puedeAgendaPropia = false;

    function colorDe(profesional, indice) {
      return (profesional && profesional.color) || COLORES_EQUIPO[indice % COLORES_EQUIPO.length];
    }

    /**
     * El desplegable de agenda de una persona.
     *
     * La opcion vacia --la agenda del negocio-- va primero y es la de siempre:
     * quien no elija nada sigue como hasta ahora, con todas las citas juntas.
     */
    function selectorAgenda(profesional, i) {
      if (!calendariosGoogle.length) {
        return '<span class="crm-empty">Conecta Google para poder elegir</span>';
      }
      var actual = profesional.calendar_id || '';
      return '<select class="crm-input crm-team-cal" data-i="' + i + '"'
        + ' aria-label="Agenda de ' + esc(profesional.name) + '">'
        + '<option value="">Agenda del negocio</option>'
        + calendariosGoogle.map(function (c) {
            return '<option value="' + esc(c.id) + '"' + (c.id === actual ? ' selected' : '') + '>'
              + esc(c.nombre) + (c.principal ? ' (principal)' : '') + '</option>';
          }).join('')
        + '</select>';
    }

    function renderEquipo() {
      var wrap = document.getElementById('team-list-wrap');
      if (!wrap) return;
      if (!equipo.length) {
        wrap.innerHTML = '<p class="crm-empty">Solo tú. Añade a alguien si atendéis a la vez.</p>';
        return;
      }
      var cabecera = puedeAgendaPropia
        ? '<thead><tr><th>Quién</th><th>Su agenda de Google</th><th></th></tr></thead>'
        : '';
      wrap.innerHTML = '<div class="crm-table-wrap"><table class="crm-table">' + cabecera + '<tbody>'
        + equipo.map(function (profesional, i) {
          return '<tr>'
            + '<td><span class="crm-team-dot" style="background:' + esc(colorDe(profesional, i)) + '"></span>'
            + esc(profesional.name) + '</td>'
            + (puedeAgendaPropia ? '<td>' + selectorAgenda(profesional, i) + '</td>' : '')
            + '<td><button type="button" class="crm-btn-del" data-i="' + i + '">🗑</button></td>'
            + '</tr>';
        }).join('') + '</tbody></table></div>';
      wrap.querySelectorAll('.crm-btn-del').forEach(function (btn) {
        btn.addEventListener('click', function () {
          equipo.splice(parseInt(btn.dataset.i, 10), 1);
          renderEquipo();
        });
      });
      wrap.querySelectorAll('.crm-team-cal').forEach(function (sel) {
        sel.addEventListener('change', function () {
          // Se guarda en memoria; al pulsar Guardar equipo viaja con el resto.
          equipo[parseInt(sel.dataset.i, 10)].calendar_id = sel.value || null;
        });
      });
    }

    async function cargarEquipo() {
      try {
        var res = await fetch('/portal-api/professionals?clientId=' + clientId);
        if (!res.ok) return;
        var data = await res.json();
        equipo = (data.professionals || []).map(function (profesional, i) {
          return {
            id: profesional.id,
            name: profesional.name,
            active: profesional.active !== false,
            color: colorDe(profesional, i),
            // Sin esto el desplegable se vaciaria al recargar: el objeto se
            // reconstruye aqui y lo que no se copie deja de existir.
            calendar_id: profesional.calendar_id || null,
          };
        });
        modoEquipo = data.mode === 'team';
        puedeAgendaPropia = !!(data.capacidades && data.capacidades.agenda_por_profesional);

        // Las agendas solo se piden si van a servir para algo.
        if (puedeAgendaPropia && !calendariosGoogle.length) {
          try {
            var resGoogle = await fetch('/portal-api/google?clientId=' + clientId);
            if (resGoogle.ok) {
              var google = await resGoogle.json();
              calendariosGoogle = google.calendarios || [];
            }
          } catch (_) { /* sin agendas, el desplegable lo dice */ }
        }
        var check = document.getElementById('team-mode');
        if (check) check.checked = modoEquipo;
        var colorInicial = document.getElementById('team-color');
        if (colorInicial) colorInicial.value = COLORES_EQUIPO[equipo.length % COLORES_EQUIPO.length];
        renderEquipo();
      } catch (_) { /* el portal sigue funcionando sin esto */ }
    }

    var teamAdd = document.getElementById('team-add');
    if (teamAdd) {
      teamAdd.addEventListener('click', function () {
        var nameInput = document.getElementById('team-name');
        var colorInput = document.getElementById('team-color');
        var nombre = nameInput ? nameInput.value.trim() : '';
        if (!nombre) { showToast('Escribe un nombre'); return; }
        equipo.push({ name: nombre, active: true, color: colorInput ? colorInput.value : null });
        renderEquipo();
        if (nameInput) nameInput.value = '';
        // Avanzar al siguiente color de la paleta: si no, todos salen del mismo
        // color y deja de servir para distinguirlos en el calendario.
        if (colorInput) colorInput.value = COLORES_EQUIPO[equipo.length % COLORES_EQUIPO.length];
      });
    }

    var teamSave = document.getElementById('team-save');
    if (teamSave) {
      teamSave.addEventListener('click', async function () {
        var check = document.getElementById('team-mode');
        var msg = document.getElementById('team-msg');
        var quiereEquipo = check ? check.checked : false;
        if (quiereEquipo && equipo.length < 2) {
          if (msg) msg.textContent = 'Para el modo equipo hacen falta al menos dos personas.';
          return;
        }
        if (msg) msg.textContent = '';
        teamSave.disabled = true;
        var res = await fetch('/portal-api/professionals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            clientId: clientId,
            mode: quiereEquipo ? 'team' : 'single',
            professionals: equipo,
          }),
        }).catch(function () { return null; });
        teamSave.disabled = false;

        if (res && res.ok) {
          modoEquipo = quiereEquipo;
          await cargarEquipo();
          await loadCalendar();
          showToast('Equipo guardado ✅');
          return;
        }
        // El backend responde 409 cuando pasar a equipo romperia las citas ya
        // guardadas. Se cuenta el motivo en vez de un "no se pudo" a secas.
        var detalle = res ? await res.json().catch(function () { return {}; }) : {};
        if (msg) {
          msg.textContent = detalle.message
            || 'No se pudo guardar. Revisa las citas ya existentes antes de activar el modo equipo.';
        }
        showToast('No se pudo guardar el equipo');
      });
    }

    cargarEquipo();

    // ── Clientes ──────────────────────────────────────────────────────────
    // La lista no se "rellena": se deduce de las citas que ya existen. Lo unico
    // que se guarda aparte es lo que escribe el dueno (nota y preferencias).
    var clientes = [];
    var clientesCargados = false;

    function fechaCorta(iso) {
      if (!iso) return '—';
      try {
        return new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
      } catch (_) { return '—'; }
    }

    function telefonoBonito(t) {
      return String(t || '').replace(/(\d{3})(?=\d)/g, '$1 ').trim();
    }

    function renderClientes() {
      var lista = document.getElementById('cli-lista');
      if (!lista) return;
      var filtro = (document.getElementById('cli-buscar') || {}).value || '';
      var q = filtro.trim().toLowerCase();
      var visibles = q
        ? clientes.filter(function (c) {
            return (c.nombre || '').toLowerCase().indexOf(q) !== -1
              || String(c.telefono || '').indexOf(q.replace(/\D/g, '')) !== -1;
          })
        : clientes;

      if (!clientes.length) {
        lista.innerHTML = '<p class="crm-empty">Aún no hay clientes. Aparecerán solos en cuanto alguien reserve con nombre y teléfono.</p>';
        return;
      }
      if (!visibles.length) {
        lista.innerHTML = '<p class="crm-empty">Nadie coincide con «' + esc(filtro) + '».</p>';
        return;
      }

      lista.innerHTML = '<div class="crm-table-wrap"><table class="crm-table">'
        + '<thead><tr><th>Cliente</th><th>Citas</th><th>Última</th><th>Próxima</th><th>Suele pedir</th></tr></thead><tbody>'
        + visibles.map(function (c) {
            return '<tr class="cli-fila" data-tel="' + esc(c.telefono) + '" style="cursor:pointer">'
              + '<td><strong>' + esc(c.nombre) + '</strong><br><span class="crm-empty">' + esc(telefonoBonito(c.telefono)) + '</span>'
              + (c.nota ? ' <span title="Tiene nota">📝</span>' : '') + '</td>'
              + '<td>' + c.citas + (c.canceladas ? ' <span class="crm-empty">(' + c.canceladas + ' canc.)</span>' : '') + '</td>'
              + '<td>' + esc(fechaCorta(c.ultima)) + '</td>'
              + '<td>' + (c.proxima ? '<strong>' + esc(fechaCorta(c.proxima)) + '</strong>' : '—') + '</td>'
              + '<td>' + esc(c.servicio_habitual || '—') + '</td>'
              + '</tr>';
          }).join('') + '</tbody></table></div>';

      lista.querySelectorAll('.cli-fila').forEach(function (fila) {
        fila.addEventListener('click', function () { abrirFicha(fila.dataset.tel); });
      });
    }

    async function abrirFicha(telefono) {
      var caja = document.getElementById('cli-ficha');
      if (!caja) return;
      caja.classList.remove('crm-hidden');
      caja.innerHTML = '<p class="crm-empty">Cargando ficha…</p>';
      try {
        var res = await fetch('/portal-api/customers?clientId=' + clientId + '&phone=' + encodeURIComponent(telefono));
        var data = await res.json();
        if (!res.ok || !data.cliente) {
          caja.innerHTML = '<p class="crm-empty">No se pudo abrir la ficha.</p>';
          return;
        }
        var c = data.cliente;
        caja.innerHTML = '<div class="crm-view-hdr"><h2 class="crm-view-title">' + esc(c.nombre) + '</h2>'
          + '<button type="button" class="crm-btn-ghost" id="cli-cerrar">Cerrar</button></div>'
          + '<p class="crm-empty">' + esc(telefonoBonito(c.telefono)) + ' · ' + c.citas + ' citas'
          + (c.profesional_habitual ? ' · suele atenderle ' + esc(c.profesional_habitual) : '') + '</p>'
          + '<label class="crm-team-help" for="cli-nota">Nota</label>'
          + '<textarea id="cli-nota" class="crm-input" rows="2" placeholder="Lo que convenga recordar de esta persona">' + esc(c.nota || '') + '</textarea>'
          + '<label class="crm-team-help" for="cli-pref">Preferencias</label>'
          + '<textarea id="cli-pref" class="crm-input" rows="2" placeholder="Cómo le gusta que le atiendan">' + esc(c.preferencias || '') + '</textarea>'
          + '<div class="crm-team-add-row"><button type="button" class="crm-btn-primary" id="cli-guardar">Guardar</button>'
          + '<span id="cli-msg" class="crm-empty"></span></div>'
          + '<h3 class="crm-team-help" style="margin-top:18px">Historial</h3>'
          + '<div class="crm-table-wrap"><table class="crm-table"><tbody>'
          + (c.historial || []).map(function (h) {
              return '<tr><td>' + esc(fechaCorta(h.datetime)) + '</td>'
                + '<td>' + esc(h.servicio || '—') + '</td>'
                + '<td>' + esc(h.profesional || '—') + '</td>'
                + '<td>' + (h.estado === 'cancelled' ? '<span class="crm-empty">cancelada</span>' : '') + '</td></tr>';
            }).join('') + '</tbody></table></div>';

        document.getElementById('cli-cerrar').addEventListener('click', function () {
          caja.classList.add('crm-hidden');
        });
        document.getElementById('cli-guardar').addEventListener('click', async function () {
          var msg = document.getElementById('cli-msg');
          msg.textContent = 'Guardando…';
          var guardado = await fetch('/portal-api/customers', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              clientId: clientId,
              phone: c.telefono,
              nota: document.getElementById('cli-nota').value,
              preferencias: document.getElementById('cli-pref').value,
            }),
          }).catch(function () { return null; });
          msg.textContent = guardado && guardado.ok ? 'Guardado ✅' : 'No se pudo guardar';
          if (guardado && guardado.ok) { clientesCargados = false; cargarClientes(); }
        });
      } catch (_) {
        caja.innerHTML = '<p class="crm-empty">No se pudo abrir la ficha.</p>';
      }
    }

    async function cargarClientes() {
      var lista = document.getElementById('cli-lista');
      if (!lista) return;
      try {
        var res = await fetch('/portal-api/customers?clientId=' + clientId);
        // El servidor es quien decide si el plan lo incluye: aqui solo se pinta
        // lo que conteste, sin repetir la tabla de planes en el navegador.
        if (res.status === 403) {
          lista.innerHTML = '<div class="crm-lock-card"><div class="crm-lock-icon">🔒</div>'
            + '<h2>Está en el plan Equipo</h2>'
            + '<p>Las fichas de clientes reúnen el historial de cada persona, con sus notas y preferencias, a partir de las citas que ya tienes.</p>'
            + '<a href="https://nexux.pro/paquetes/equipo" class="crm-btn-primary" target="_blank" rel="noopener">Ver el plan Equipo →</a></div>';
          clientesCargados = true;
          return;
        }
        var data = await res.json();
        clientes = (data && data.clientes) || [];
        clientesCargados = true;
        renderClientes();
      } catch (_) {
        lista.innerHTML = '<p class="crm-empty">No se pudo cargar la lista.</p>';
      }
    }

    var buscador = document.getElementById('cli-buscar');
    if (buscador) buscador.addEventListener('input', renderClientes);


    // ── Cabinas y equipamiento ────────────────────────────────────────
    // Un recurso es algo limitado que la cita ocupa. Dos personas pueden
    // atender a la vez, pero si solo hay una cabina no caben dos citas de
    // cabina a la misma hora aunque las den profesionales distintos.
    var recursos = [];
    var requisitos = {}; // nombre de servicio -> { resource_id, units } | null

    function renderRecursos() {
      var wrap = document.getElementById('res-list-wrap');
      if (!wrap) return;
      if (!recursos.length) {
        wrap.innerHTML = '<p class="crm-empty">Sin cabinas ni equipamiento limitado.</p>';
      } else {
        wrap.innerHTML = '<div class="crm-table-wrap"><table class="crm-table"><thead><tr>'
          + '<th>Nombre</th><th>A la vez</th><th></th></tr></thead><tbody>'
          + recursos.map(function (recurso, i) {
            return '<tr><td>' + esc(recurso.name) + '</td>'
              + '<td>' + esc(recurso.capacity) + '</td>'
              + '<td><button type="button" class="crm-btn-del" data-i="' + i + '">🗑</button></td></tr>';
          }).join('') + '</tbody></table></div>';
        wrap.querySelectorAll('.crm-btn-del').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var fuera = recursos.splice(parseInt(btn.dataset.i, 10), 1)[0];
            // Si un servicio dependia de esa cabina, deja de depender.
            Object.keys(requisitos).forEach(function (servicio) {
              if (requisitos[servicio] && fuera && requisitos[servicio].resource_id === fuera.id) {
                requisitos[servicio] = null;
              }
            });
            renderRecursos();
          });
        });
      }
      renderRequisitos();
    }

    function renderRequisitos() {
      var wrap = document.getElementById('res-requirements-wrap');
      if (!wrap) return;
      if (!recursos.length || !services.length) { wrap.innerHTML = ''; return; }
      wrap.innerHTML = '<p class="crm-res-sub">Qué necesita cada servicio</p>'
        + '<div class="crm-table-wrap"><table class="crm-table"><tbody>'
        + services.map(function (servicio) {
          var actual = requisitos[servicio.name];
          var opciones = '<option value="">No necesita nada</option>'
            + recursos.map(function (recurso) {
              var sel = actual && actual.resource_id === recurso.id ? ' selected' : '';
              return '<option value="' + esc(recurso.id || recurso.name) + '"' + sel + '>'
                + esc(recurso.name) + '</option>';
            }).join('');
          return '<tr><td>' + esc(servicio.name) + '</td>'
            + '<td><select class="crm-input crm-res-sel" data-svc="' + esc(servicio.name) + '">'
            + opciones + '</select></td></tr>';
        }).join('') + '</tbody></table></div>';

      wrap.querySelectorAll('.crm-res-sel').forEach(function (sel) {
        sel.addEventListener('change', function () {
          var servicio = sel.dataset.svc;
          requisitos[servicio] = sel.value ? { resource_id: sel.value, units: 1 } : null;
        });
      });
    }

    async function cargarRecursos() {
      try {
        var res = await fetch('/portal-api/resources?clientId=' + clientId);
        if (!res.ok) return;
        var data = await res.json();
        recursos = data.resources || [];
        requisitos = {};
        (data.services || []).forEach(function (servicio) {
          var req = (servicio.resource_requirements || [])[0];
          requisitos[servicio.name] = req && req.eligible_resource_ids && req.eligible_resource_ids[0]
            ? { resource_id: req.eligible_resource_ids[0], units: req.units || 1 }
            : null;
        });
        renderRecursos();
      } catch (_) { /* el portal sigue funcionando sin esto */ }
    }

    var resAdd = document.getElementById('res-add');
    if (resAdd) {
      resAdd.addEventListener('click', function () {
        var nameInput = document.getElementById('res-name');
        var capInput = document.getElementById('res-capacity');
        var nombre = nameInput ? nameInput.value.trim() : '';
        var capacidad = parseInt(capInput ? capInput.value : '1', 10);
        if (!nombre) { showToast('Escribe un nombre'); return; }
        if (!capacidad || capacidad < 1) { showToast('¿Cuántas caben a la vez?'); return; }
        recursos.push({ name: nombre, capacity: capacidad, active: true });
        renderRecursos();
        if (nameInput) nameInput.value = '';
        if (capInput) capInput.value = '1';
      });
    }

    var resSave = document.getElementById('res-save');
    if (resSave) {
      resSave.addEventListener('click', async function () {
        var msg = document.getElementById('res-msg');
        if (msg) msg.textContent = '';
        resSave.disabled = true;
        var res = await fetch('/portal-api/resources', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId: clientId, resources: recursos, requirements: requisitos }),
        }).catch(function () { return null; });
        resSave.disabled = false;

        if (res && res.ok) {
          await cargarRecursos();
          showToast('Guardado ✅');
          return;
        }
        var detalle = res ? await res.json().catch(function () { return {}; }) : {};
        if (msg) {
          msg.textContent = detalle.message
            || 'No se pudo guardar. Revisa las citas ya existentes.';
        }
        showToast('No se pudo guardar');
      });
    }

    cargarRecursos();

    // ── Google Calendar ───────────────────────────────────────────────
    // El cliente pincha, acepta en Google y elige calendario. Antes habia que
    // pedirle que compartiera el suyo a mano con un correo nuestro.
    function gcalPintar(estado) {
      var chip = document.getElementById('gcal-chip');
      var cuerpo = document.getElementById('gcal-body');
      if (!chip || !cuerpo) return;

      if (!estado || !estado.ok) {
        chip.textContent = 'No disponible';
        chip.className = 'crm-chip chip-red';
        cuerpo.innerHTML = '<p class="crm-empty">No se pudo comprobar la conexión.</p>';
        return;
      }
      if (!estado.disponible) {
        chip.textContent = 'Próximamente';
        chip.className = 'crm-chip';
        cuerpo.innerHTML = '<p class="crm-empty">Esta integración aún no está activada. Escríbenos y te la abrimos.</p>';
        return;
      }
      if (!estado.conectado || estado.revocado) {
        chip.textContent = estado.revocado ? 'Permiso retirado' : 'Sin conectar';
        chip.className = 'crm-chip ' + (estado.revocado ? 'chip-yellow' : 'chip-red');
        cuerpo.innerHTML = (estado.revocado
          ? '<p class="crm-empty">Se retiró el permiso desde Google. Vuelve a conectarlo para seguir sincronizando.</p>'
          : '')
          + '<button type="button" class="crm-btn-primary" id="gcal-connect">Conectar mi Google Calendar</button>';
        var btn = document.getElementById('gcal-connect');
        if (btn) btn.addEventListener('click', gcalConectar);
        return;
      }

      chip.textContent = estado.calendarId ? 'Conectado' : 'Falta elegir calendario';
      chip.className = 'crm-chip ' + (estado.calendarId ? 'chip-green' : 'chip-yellow');

      var opciones = (estado.calendarios || []).map(function (cal) {
        var sel = cal.id === estado.calendarId ? ' selected' : '';
        return '<option value="' + esc(cal.id) + '"' + sel + '>' + esc(cal.nombre)
          + (cal.principal ? ' (principal)' : '') + '</option>';
      }).join('');

      cuerpo.innerHTML =
        (estado.cuenta ? '<p class="crm-muted-p">Conectado como <strong>' + esc(estado.cuenta) + '</strong></p>' : '')
        + '<label class="crm-form-lbl">¿En qué calendario se apuntan las citas?'
        + '<select class="crm-input" id="gcal-select">'
        + '<option value="">— Elige uno —</option>' + opciones + '</select></label>'
        + '<div class="crm-gcal-actions">'
        + '<button type="button" class="crm-btn-ghost" id="gcal-off">Desconectar</button>'
        + '</div>'
        + '<p class="crm-team-msg" id="gcal-msg" role="status"></p>';

      var sel = document.getElementById('gcal-select');
      if (sel) {
        sel.addEventListener('change', async function () {
          var msg = document.getElementById('gcal-msg');
          var r = await fetch('/portal-api/google', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId, calendarId: sel.value, activo: !!sel.value }),
          }).catch(function () { return null; });
          if (r && r.ok) { showToast('Calendario guardado ✅'); gcalCargar(); }
          else if (msg) msg.textContent = 'No se pudo guardar el calendario.';
        });
      }
      var off = document.getElementById('gcal-off');
      if (off) {
        off.addEventListener('click', async function () {
          if (!window.confirm('¿Desconectar Google Calendar? Las citas dejarán de aparecer en tu calendario.')) return;
          off.disabled = true;
          var r = await fetch('/portal-api/google', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId, action: 'disconnect' }),
          }).catch(function () { return null; });
          off.disabled = false;
          if (r && r.ok) { showToast('Desconectado'); gcalCargar(); }
          else showToast('No se pudo desconectar');
        });
      }
    }

    async function gcalConectar() {
      var r = await fetch('/portal-api/google?action=connect&clientId=' + clientId).catch(function () { return null; });
      if (!r || !r.ok) { showToast('No se pudo iniciar la conexión'); return; }
      var d = await r.json().catch(function () { return {}; });
      if (d.url) window.location.href = d.url;
      else showToast('No se pudo iniciar la conexión');
    }

    async function gcalCargar() {
      try {
        var r = await fetch('/portal-api/google?clientId=' + clientId);
        gcalPintar(await r.json());
      } catch (_) { gcalPintar(null); }
    }

    // Al volver de Google se avisa de como fue.
    (function () {
      var p = new URLSearchParams(location.search).get('google');
      if (!p) return;
      var mensajes = {
        conectado: 'Google Calendar conectado ✅ Elige en qué calendario se apuntan las citas.',
        cancelado: 'Conexión cancelada.',
        sin_permiso_duradero: 'Google no dio permiso permanente. Vuelve a intentarlo y acepta todos los pasos.',
      };
      if (mensajes[p]) setTimeout(function () { showToast(mensajes[p]); }, 700);
      // Se quita de la barra de direcciones para que no se repita al recargar.
      history.replaceState(null, '', location.pathname);
    })();

    gcalCargar();

    // ── Reactivar WhatsApp tras caducar el QR ─────────────────────────
    var waReactivar = document.getElementById('wa-reactivar');
    if (waReactivar) {
      waReactivar.addEventListener('click', function () {
        waReactivar.disabled = true;
        waReactivar.textContent = 'Activando...';
        fetch('/portal-api/wa-reactivar?clientId=' + encodeURIComponent(clientId), { method: 'POST' })
          .then(function (r) { return r.json(); })
          .then(function (d) {
