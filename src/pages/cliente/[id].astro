          if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
        });
      }
      if (providerConfirm) {
        providerConfirm.addEventListener('click', async function () {
          var selected = document.querySelector('input[name="whatsapp_provider"]:checked');
          if (!(selected instanceof HTMLInputElement)) return;
          var response = await fetch('/portal-api/update-config', {
            method: 'POST',
