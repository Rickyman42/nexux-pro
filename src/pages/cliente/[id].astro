---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getClientData, type Appointment } from '../../lib/portal-client';

const { id: clientId } = Astro.params;
const token = Astro.cookies.get('nexux_token')?.value;

if (!clientId || !token) {
  return Astro.redirect(`/cliente/${clientId ?? ''}/login?reason=session`);
}

const data = await getClientData(clientId, token);
if (!data) {
  return Astro.redirect(`/cliente/${clientId}/login?reason=expired`);
}

const dateFormatter = new Intl.DateTimeFormat('es-ES', { weekday: 'short', day: 'numeric', month: 'long', timeZone: 'Europe/Madrid' });
const timeFormatter = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });

const todayKey = new Date().toDateString();
const todayAppointments = data.nextAppointments.filter(item => new Date(item.datetime).toDateString() === todayKey).length;
const limitedProgress = data.metrics.conversationLimit
  ? Math.min(100, Math.round((data.metrics.conversationCount / data.metrics.conversationLimit) * 100))
  : 100;
const planLabel = data.plan.charAt(0).toUpperCase() + data.plan.slice(1);
const qrImageSrc = data.qrPngBase64
  ? data.qrPngBase64.startsWith('data:image') ? data.qrPngBase64 : `data:image/png;base64,${data.qrPngBase64}`
  : null;
const ownerTelegramUrl = `https://t.me/NexuxProAssistantBot?start=${data.clientId}`;
const customerTelegramUrl = `https://t.me/NexuxProAssistantBot?start=c_${data.clientId}`;
const showWhatsApp = !!data.channels.whatsapp?.provider;

const booked = data.metrics.appointmentsBooked;
const avgPrice = data.services?.length
  ? data.services.reduce((s, sv) => s + (sv.price || 0), 0) / data.services.length
  : 30;
const roiRevenue = Math.round(booked * avgPrice);
const roiTimeSaved = booked * 5;
const nextApt = data.nextAppointments?.[0] ?? null;
const nextAptFormatted = nextApt
  ? { date: dateFormatter.format(new Date(nextApt.datetime)), time: timeFormatter.format(new Date(nextApt.datetime)) }
  : null;

const todayIndex = new Date().getDay();
const todayScheduleKey = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][todayIndex];
const todaySchedule = data.schedule?.[todayScheduleKey] ?? null;
const confirmedTodayAppointments = data.nextAppointments.filter(item => {
  const itemDate = new Date(item.datetime);
  return item.status !== 'cancelled' && itemDate.toDateString() === todayKey;
});
const defaultServiceDuration = data.services?.length
  ? Math.round(data.services.reduce((sum, service) => sum + (service.duration || 60), 0) / data.services.length)
  : 60;

function minutesFromTime(value?: string) {
  if (!value) return 0;
  const [hours, minutes] = value.split(':').map(Number);
  return (hours || 0) * 60 + (minutes || 0);
}

function estimateOpenMinutes(schedule: typeof todaySchedule) {
  if (!schedule) return 0;
  const open = minutesFromTime(schedule.open);
  const close = minutesFromTime(schedule.close);
  return Math.max(0, close - open);
}

const todayOpenMinutes = estimateOpenMinutes(todaySchedule);
const bookedTodayMinutes = confirmedTodayAppointments.reduce((sum, item) => sum + ((item as any).duration_min || defaultServiceDuration), 0);
const freeSlotsToday = todayOpenMinutes > 0
  ? Math.max(0, Math.floor((todayOpenMinutes - bookedTodayMinutes) / Math.max(defaultServiceDuration, 30)))
  : 0;
const manualReviewCount = data.active && (data.channels.whatsapp.connected || data.channels.telegram.ownerLinked) ? 0 : 1;
const manualReviewLabel = manualReviewCount === 0 ? 'Sin intervencion pendiente' : 'Revisar canales';
const freeSlotsLabel = todayOpenMinutes > 0 ? `${freeSlotsToday} hueco${freeSlotsToday === 1 ? '' : 's'}` : 'Cerrado hoy';

const weekdayLabels: [string, string][] = [
  ['monday','Lunes'],['tuesday','Martes'],['wednesday','Miercoles'],
  ['thursday','Jueves'],['friday','Viernes'],['saturday','Sabado'],['sunday','Domingo'],
];

function renderAppointmentDate(item: Appointment) {
  const date = new Date(item.datetime);
  return { date: dateFormatter.format(date), time: timeFormatter.format(date) };
}
---
<Layout
  title={`Portal - ${data.name}`}
  description={`Portal del cliente ${data.name} en Nexux Pro.`}
  canonical={`https://nexux.pro/cliente/${clientId}`}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <div id="crm" class="crm-light">

    <!-- SIDEBAR -->
    <aside class="crm-sidebar" id="crm-sidebar">
      <div class="crm-logo">
        <span class="crm-logo-mark">N</span>
        <div class="crm-logo-words">nexux<em>pro</em></div>
      </div>

      <nav class="crm-nav">
        <button class="crm-nav-btn active" data-view="dashboard">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          Dashboard
        </button>
        <button class="crm-nav-btn" data-view="citas">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Citas
        </button>
        <button class="crm-nav-btn" data-view="clientes">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Clientes
        </button>
        <button class="crm-nav-btn" data-view="canales">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Canales
        </button>
        <button class="crm-nav-btn" data-view="config">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M4.93 4.93l1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
          Configuración
        </button>
        <button class="crm-nav-btn" data-view="billing">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          Facturación
        </button>
      </nav>

      <div class="crm-sidebar-foot">
        <span class="crm-plan-chip">{planLabel}</span>
        <a href={`/cliente/${clientId}/onboarding`} class="crm-support-link crm-setup-link">⚙ Configuración inicial</a>
        <a href="https://t.me/nexux_soporte_bot" target="_blank" rel="noopener" class="crm-support-link">Soporte</a>
      </div>
    </aside>

    <div class="crm-overlay" id="crm-overlay"></div>

    <!-- BODY -->
    <div class="crm-body">
      <header class="crm-topbar">
        <button class="crm-burger" id="crm-burger" aria-label="Menu">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="crm-topbar-info">
          <span class="crm-topbar-name">{data.name}</span>
          <span class={`crm-topbar-badge ${data.active ? 'badge-live' : 'badge-off'}`}>
            <span class="crm-dot"></span>
            {data.active ? 'Activo' : 'Inactivo'}
          </span>
        </div>
        <button class="crm-theme-btn" id="crm-theme-btn" title="Cambiar tema">
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </header>

      <main class="crm-main">

        <section class="crm-ops-strip" aria-label="Resumen operativo de hoy">
          <div class="crm-ops-item">
            <span class="crm-ops-label">Citas hoy</span>
            <strong class="crm-ops-value">{todayAppointments}</strong>
            <span class="crm-ops-note">{nextAptFormatted ? `Proxima ${nextAptFormatted.time}` : 'Sin proximas citas'}</span>
          </div>
          <div class="crm-ops-item">
            <span class="crm-ops-label">Mensajes a revisar</span>
            <strong class="crm-ops-value">{manualReviewCount}</strong>
            <span class="crm-ops-note">{manualReviewLabel}</span>
          </div>
          <div class="crm-ops-item">
            <span class="crm-ops-label">Huecos libres</span>
            <strong class="crm-ops-value">{freeSlotsLabel}</strong>
            <span class="crm-ops-note">Estimado segun horario y duracion media</span>
          </div>
        </section>

        <!-- ── DASHBOARD ──────────────────────────────────── -->
        <section class="crm-view" id="v-dashboard">
          <div class="crm-view-hdr">
            <h1 class="crm-view-title">Dashboard</h1>
          </div>

          <div class="crm-kpi-grid">
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Citas hoy</span>
              <strong class="crm-kpi-val">{todayAppointments}</strong>
            </div>
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Total reservadas</span>
              <strong class="crm-kpi-val">{data.metrics.appointmentsBooked}</strong>
            </div>
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Conversaciones</span>
              <strong class="crm-kpi-val">{data.metrics.conversationCount}{data.metrics.conversationLimit ? `/${data.metrics.conversationLimit}` : ''}</strong>
              {data.plan === 'starter' && data.metrics.conversationLimit && (
                <div class="crm-progress"><div class="crm-progress-bar" style={`width:${limitedProgress}%`}></div></div>
              )}
            </div>
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Cancelaciones</span>
              <strong class="crm-kpi-val">{data.metrics.appointmentsCancelled}</strong>
            </div>
          </div>

          <div class="crm-dash-row">
            <div class="crm-card crm-status-card">
              <h2 class="crm-card-title">Estado</h2>
              <div class="crm-status-list">
                {showWhatsApp && (
                  <div class="crm-status-item">
                    <span class="crm-status-lbl">WhatsApp</span>
                    <span class="crm-status-val">
                      <span class={`crm-dot ${data.channels.whatsapp.connected ? 'dot-green' : data.botStatus === 'pending_qr' ? 'dot-yellow' : 'dot-red'}`}></span>
                      {data.channels.whatsapp.connected ? `Conectado` : data.botStatus === 'pending_qr' ? 'Pendiente QR' : 'Desconectado'}
                    </span>
                  </div>
                )}
                <div class="crm-status-item">
                  <span class="crm-status-lbl">Telegram</span>
                  <span class="crm-status-val">
                    <span class={`crm-dot ${data.channels.telegram.ownerLinked ? 'dot-green' : 'dot-yellow'}`}></span>
                    {data.channels.telegram.ownerLinked ? 'Vinculado' : 'Pendiente'}
                  </span>
                </div>
                <div class="crm-status-item">
                  <span class="crm-status-lbl">Bot</span>
                  <span class="crm-status-val">
                    <span class={`crm-dot ${data.active ? 'dot-green' : 'dot-red'}`}></span>
                    {data.active ? 'Activo' : 'Inactivo'}
                  </span>
                </div>
              </div>
            </div>

            <div class="crm-card crm-apts-card">
              <div class="crm-card-head">
                <h2 class="crm-card-title">Próximas citas</h2>
                <span class="crm-chip chip-accent">{todayAppointments} hoy</span>
              </div>
              {data.nextAppointments.length ? (
                <div class="crm-table-wrap">
                  <table class="crm-table">
                    <thead><tr><th>Fecha</th><th>Hora</th><th>Cliente</th><th>Servicio</th><th>Estado</th></tr></thead>
                    <tbody>
                      {data.nextAppointments.slice(0, 6).map(item => {
                        const row = renderAppointmentDate(item);
                        return (
                          <tr>
                            <td>{row.date}</td>
                            <td>{row.time}</td>
                            <td>{item.clientName || item.clientPhone}</td>
                            <td>{item.service}</td>
                            <td><span class={`crm-chip ${item.status === 'confirmed' ? 'chip-green' : 'chip-red'}`}>{item.status === 'confirmed' ? 'Confirmada' : 'Cancelada'}</span></td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="crm-empty">Las citas reservadas por tu bot aparecerán aquí.</p>
              )}
            </div>
          </div>

          <!-- Próxima cita + ROI -->
          <div class="crm-dash-row2">
            <div class="crm-card crm-next-apt-card">
              <h2 class="crm-card-title">Próxima cita</h2>
              {nextAptFormatted && nextApt ? (
                <div class="crm-next-apt-content">
                  <div class="crm-next-apt-time">
                    <span class="crm-next-apt-date">{nextAptFormatted.date}</span>
                    <strong class="crm-next-apt-hour">{nextAptFormatted.time}</strong>
                  </div>
                  <div>
                    <div style="font-size:14px;font-weight:600;color:var(--crm-text)">{nextApt.clientName || nextApt.clientPhone}</div>
                    <div class="crm-muted-p">{nextApt.service}</div>
                  </div>
                </div>
              ) : (
                <p class="crm-empty">Sin citas próximas</p>
              )}
            </div>
            <div class="crm-card crm-roi-card">
              <h2 class="crm-card-title">ROI del bot</h2>
              <div class="crm-roi-grid">
                <div class="crm-roi-item">
                  <span class="crm-kpi-lbl">Ingresos generados</span>
                  <strong class="crm-roi-val crm-roi-green">~{roiRevenue}€</strong>
                  <span class="crm-roi-sub">{booked} cita{booked !== 1 ? 's' : ''} × ~{Math.round(avgPrice)}€ ticket medio</span>
                </div>
                <div class="crm-roi-item">
                  <span class="crm-kpi-lbl">Tiempo ahorrado</span>
                  <strong class="crm-roi-val">{roiTimeSaved} min</strong>
                  <span class="crm-roi-sub">~5 min de llamada por reserva</span>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Herramientas rápidas ─────────────────────────────── -->
          <div class="crm-dash-row" style="margin-top:1.5rem">
            <div class="crm-card" style="flex:1">
              <h2 class="crm-card-title">⚡ Herramientas rápidas</h2>
              <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:0.75rem">

                {data.plan === 'starter' ? (
                  <>
                    <!-- Llamada perdida — bloqueado en Starter -->
                    <div style="background:#1a1d2e;border-radius:10px;padding:1rem;opacity:0.6;position:relative">
                      <div style="position:absolute;top:0.6rem;right:0.75rem;font-size:0.75rem;background:#2d3148;color:#94a3b8;padding:0.2rem 0.5rem;border-radius:99px">Plan Pro</div>
                      <p style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.5rem">📞 <strong style="color:#e2e8f0">Llamada perdida</strong> — Lara contacta al cliente automáticamente</p>
                      <a href="https://nexux.pro/planes" target="_blank" rel="noopener" style="display:inline-block;font-size:0.8rem;color:#4ECDC4;font-weight:600;text-decoration:none;margin-top:0.25rem">Actualizar a Pro para activar →</a>
                    </div>

                    <!-- Mini-web — bloqueado en Starter -->
                    <div style="background:#1a1d2e;border-radius:10px;padding:1rem;opacity:0.6;position:relative">
                      <div style="position:absolute;top:0.6rem;right:0.75rem;font-size:0.75rem;background:#2d3148;color:#94a3b8;padding:0.2rem 0.5rem;border-radius:99px">Plan Pro</div>
                      <p style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.5rem">🌐 <strong style="color:#e2e8f0">Mini-web</strong> — Página con tus servicios y horarios optimizada para Google</p>
                      <a href="https://nexux.pro/planes" target="_blank" rel="noopener" style="display:inline-block;font-size:0.8rem;color:#4ECDC4;font-weight:600;text-decoration:none;margin-top:0.25rem">Actualizar a Pro para activar →</a>
                    </div>
                  </>
                ) : (
                  <>
                    <!-- Llamada perdida — activo en Pro/Total -->
                    <div style="background:#1a1d2e;border-radius:10px;padding:1rem">
                      <p style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.5rem">📞 <strong style="color:#e2e8f0">Llamada perdida</strong> — Lara contacta al cliente automáticamente</p>
                      <div style="display:flex;gap:0.5rem">
                        <input id="missed-call-phone" type="tel" placeholder="Teléfono (ej: 666123456)" style="flex:1;background:#0b0d12;border:1px solid #2d3148;border-radius:6px;padding:0.4rem 0.75rem;color:#e2e8f0;font-size:0.85rem" />
                        <button id="btn-missed-call" style="background:#4ECDC4;color:#0b0d12;font-weight:600;border:none;border-radius:6px;padding:0.4rem 1rem;cursor:pointer;font-size:0.85rem">Enviar</button>
                      </div>
                    </div>

                    <!-- Mini-web — activo en Pro/Total -->
                    <div style="background:#1a1d2e;border-radius:10px;padding:1rem">
                      <p style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.5rem">🌐 <strong style="color:#e2e8f0">Mini-web</strong> — Página con tus servicios y horarios optimizada para Google</p>
                      <div style="display:flex;gap:0.5rem;align-items:center">
                        <span id="web-url-display" style="flex:1;font-size:0.82rem;color:#64748b;font-style:italic">No generada aún</span>
                        <button id="btn-regen-web" style="background:#2d3148;color:#e2e8f0;font-weight:600;border:none;border-radius:6px;padding:0.4rem 1rem;cursor:pointer;font-size:0.85rem">Generar web</button>
                      </div>
                    </div>
                  </>
                )}

              </div>
            </div>
          </div>
        </section>

        <!-- ── CITAS ──────────────────────────────────────── -->
        <section class="crm-view crm-hidden" id="v-citas">
          <div class="crm-view-hdr">
            <h1 class="crm-view-title">Citas</h1>
            <button class="crm-btn-primary" id="open-apt-modal">+ Nueva cita</button>
          </div>
          <div class="crm-card">
            <div class="crm-cal-nav">
              <button id="cal-prev" class="crm-btn-ghost">← Anterior</button>
              <span id="cal-week-label" class="crm-cal-label"></span>
              <button id="cal-next" class="crm-btn-ghost">Siguiente →</button>
            </div>
            <div class="crm-cal-grid" id="cal-grid">
              <p class="crm-empty">Cargando...</p>
            </div>
          </div>
        </section>

        <!-- ── CLIENTES ───────────────────────────────────── -->
        <section class="crm-view crm-hidden" id="v-clientes">
          <div class="crm-view-hdr">
            <h1 class="crm-view-title">Clientes</h1>
          </div>
          {data.plan === 'starter' ? (
            <div class="crm-lock-card">
              <div class="crm-lock-icon">🔒</div>
              <h2>Función del Plan Pro</h2>
              <p>La sección de Clientes incluye historial completo, notas y preferencias de cada cliente que haya reservado con tu bot.</p>
              <a href="https://nexux.pro/planes" class="crm-btn-primary" target="_blank" rel="noopener">Actualizar a Pro →</a>
            </div>
          ) : (
            <div class="crm-card">
              <p class="crm-empty">Los clientes que reserven citas a través de tu bot aparecerán aquí.</p>
            </div>
          )}
        </section>

        <!-- ── CANALES ────────────────────────────────────── -->
        <section class="crm-view crm-hidden" id="v-canales">
          <div class="crm-view-hdr">
            <h1 class="crm-view-title">Canales</h1>
          </div>

          {showWhatsApp && (
            <div class="crm-card crm-mb">
              <div class="crm-card-head">
                <h2 class="crm-card-title">WhatsApp</h2>
                <span class={`crm-chip ${data.channels.whatsapp.connected ? 'chip-green' : data.botStatus === 'pending_qr' ? 'chip-yellow' : 'chip-red'}`}>
                  {data.channels.whatsapp.connected ? 'Conectado' : data.botStatus === 'pending_qr' ? 'Pendiente QR' : 'Desconectado'}
                </span>
              </div>
              {data.botStatus === 'pending_qr' && (
                <div class="crm-qr-block">
                  <p>{data.qrPngBase64 ? 'Escanea el QR desde tu móvil.' : 'Te enviaremos un QR válido en breve desde soporte.'}</p>
                  {qrImageSrc && <img src={qrImageSrc} alt="QR WhatsApp" class="crm-qr-img" />}
                </div>
              )}
              {data.plan !== 'starter' && (
                <div class="crm-provider-wrap">
                  <h3 class="crm-section-lbl">Proveedor</h3>
                  <div class="crm-provider-opts">
                    <label class="crm-provider-opt">
                      <input type="radio" name="whatsapp_provider" value="baileys" checked={data.channels.whatsapp.provider === 'baileys'} />
                      <span><strong>Baileys</strong><small>Tu número actual — Gratis</small></span>
                    </label>
                    <label class="crm-provider-opt">
                      <input type="radio" name="whatsapp_provider" value="twilio" checked={data.channels.whatsapp.provider === 'twilio'} />
                      <span><strong>Twilio Business</strong><small>Número dedicado — +10€/mes</small></span>
                    </label>
                  </div>
                  <button id="provider-trigger" type="button" class="crm-btn-ghost">Cambiar proveedor →</button>
                </div>
              )}
            </div>
          )}

          <div class="crm-card">
            <div class="crm-card-head">
              <h2 class="crm-card-title">Telegram</h2>
              <span class={`crm-chip ${data.channels.telegram.ownerLinked ? 'chip-green' : 'chip-yellow'}`}>
                {data.channels.telegram.ownerLinked ? 'Vinculado' : 'No vinculado'}
              </span>
            </div>
            {!data.channels.telegram.ownerLinked && (
              <div class="crm-tg-owner">
                <p>Vincula tu Telegram para recibir avisos de citas y actividad del bot.</p>
                <a href={ownerTelegramUrl} class="crm-btn-primary" target="_blank" rel="noopener">Vincular mi Telegram →</a>
              </div>
            )}
            <div class="crm-tg-customer">
              <strong class="crm-section-lbl">Enlace para tus clientes</strong>
              <p class="crm-muted-p">Compártelo para que reserven en Telegram.</p>
              <div class="crm-copy-row">
                <input id="telegram-customer-link" type="text" value={customerTelegramUrl} readonly class="crm-input" />
                <button id="telegram-copy" type="button" class="crm-btn-ghost">Copiar</button>
              </div>
            </div>
          </div>
        </section>

        <!-- ── CONFIGURACIÓN ──────────────────────────────── -->
        <section class="crm-view crm-hidden" id="v-config">
          <div class="crm-view-hdr">
            <h1 class="crm-view-title">Configuración</h1>
          </div>

          <div class="crm-card crm-mb">
            <h2 class="crm-card-title">Mis servicios</h2>
            <div id="services-list-wrap"></div>
            <div class="crm-svc-add-row">
              <input type="text" id="svc-name" placeholder="Nombre del servicio" class="crm-input" />
              <input type="number" id="svc-duration" placeholder="Duración (min)" min="1" class="crm-input" />
              <input type="number" id="svc-price" placeholder="Precio (€)" min="0" step="0.01" class="crm-input" />
              <button type="button" id="svc-add" class="crm-btn-ghost">+ Añadir</button>
            </div>
            <button type="button" id="svc-save" class="crm-btn-primary">Guardar servicios</button>
          </div>

          <div class="crm-card">
            <h2 class="crm-card-title">Horario</h2>
            <form id="schedule-form" class="crm-schedule-form">
              {weekdayLabels.map(([key, label]) => {
                const slot = data.schedule[key];
                const hasLunch = !!(slot as any)?.lunch_close;
                return (
                  <div class="crm-schedule-row">
                    <div class="crm-schedule-day">{label}</div>
                    <label class="crm-toggle-lbl">
                      <input type="checkbox" name={`${key}_closed`} checked={!slot} />
                      <span>Cerrado</span>
                    </label>
                    <div class="crm-schedule-times">
                      <input type="time" name={`${key}_open`} value={slot?.open ?? '09:00'} disabled={!slot} class="crm-input-time" />
                      <input type="time" name={`${key}_lunch_close`} value={(slot as any)?.lunch_close ?? '14:00'} disabled={!slot || !hasLunch} data-lunch class="crm-input-time" />
                      <input type="time" name={`${key}_lunch_open`} value={(slot as any)?.lunch_open ?? '16:00'} disabled={!slot || !hasLunch} data-lunch class="crm-input-time" />
                      <input type="time" name={`${key}_close`} value={slot?.close ?? '19:00'} disabled={!slot} class="crm-input-time" />
                    </div>
                    <label class="crm-toggle-lbl">
                      <input type="checkbox" name={`${key}_lunch`} checked={hasLunch} disabled={!slot} />
                      <span>Comer</span>
                    </label>
                  </div>
                );
              })}
              <button type="submit" class="crm-btn-primary">Guardar horario</button>
            </form>
          </div>
        </section>

        <!-- ── BILLING ──────────────────────────────────────────────────────────────── -->
        <section class="crm-view crm-hidden" id="v-billing">
          <h1 class="crm-view-title">Facturación</h1>
          <div class="crm-section">
            <span class="crm-section-lbl">Plan activo</span>
            <div class="billing-plan-row">
              <div class="billing-plan-badge">
                <span class="billing-plan-name">{planLabel}</span>
                <span class="billing-plan-sub">{data.plan === 'starter' ? '249€/mes' : data.plan === 'pro' ? '449€/mes' : '749€/mes'}</span>
              </div>
              <button id="btn-billing-portal" class="crm-btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Gestionar suscripción
              </button>
            </div>
            <p class="billing-hint">Cambia de plan, actualiza tu método de pago o cancela desde el portal de Stripe.</p>
          </div>

          <div class="crm-section">
            <span class="crm-section-lbl">Planes disponibles</span>
            <div class="billing-plans-grid">
              <div class={`billing-plan-card ${data.plan === 'starter' ? 'current' : ''}`}>
                <div class="bpc-header">
                  <span class="bpc-name">Starter</span>
                  <span class="bpc-price">249€<small>/mes</small></span>
                </div>
                <ul class="bpc-features">
                  <li>✅ Bot WhatsApp IA</li>
                  <li>✅ Hasta 200 conversaciones/mes</li>
                  <li>✅ Portal de gestión</li>
                  <li>✅ Citas automáticas</li>
                </ul>
                {data.plan === 'starter' && <span class="bpc-current-tag">Plan actual</span>}
              </div>
              <div class={`billing-plan-card ${data.plan === 'pro' ? 'current' : ''}`}>
                <div class="bpc-header">
                  <span class="bpc-name">Pro</span>
                  <span class="bpc-price">449€<small>/mes</small></span>
                </div>
                <ul class="bpc-features">
                  <li>✅ Todo lo de Starter</li>
                  <li>✅ Hasta 600 conversaciones/mes</li>
                  <li>✅ Recordatorios automáticos</li>
                  <li>✅ Soporte prioritario</li>
                </ul>
                {data.plan === 'pro' && <span class="bpc-current-tag">Plan actual</span>}
              </div>
              <div class={`billing-plan-card ${data.plan === 'total' ? 'current' : ''}`}>
                <div class="bpc-header">
                  <span class="bpc-name">Total</span>
                  <span class="bpc-price">749€<small>/mes</small></span>
                </div>
                <ul class="bpc-features">
                  <li>✅ Todo lo de Pro</li>
                  <li>✅ Conversaciones ilimitadas</li>
                  <li>✅ Bot Telegram incluido</li>
                  <li>✅ Onboarding dedicado</li>
                </ul>
                {data.plan === 'total' && <span class="bpc-current-tag">Plan actual</span>}
              </div>
            </div>
            <p class="billing-hint" style="margin-top:16px">Para cambiar de plan usa el botón “Gestionar suscripción” arriba — Stripe te mostrará las opciones disponibles.</p>
          </div>

          <div class="crm-section">
            <span class="crm-section-lbl">Historial de facturas</span>
            <div id="invoices-loading" class="invoices-loading">Cargando facturas…</div>
            <div id="invoices-empty" class="invoices-empty crm-hidden">Sin facturas todavía.</div>
            <table id="invoices-table" class="invoices-table crm-hidden">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Descripción</th>
                  <th>Importe</th>
                  <th>Estado</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="invoices-tbody"></tbody>
            </table>
          </div>
        </section>

      </main>
    </div>
  </div>

  <div id="portal-toast" class="crm-toast" hidden></div>

  {data.plan !== 'starter' && (
    <dialog id="provider-dialog" class="crm-dialog">
      <div class="crm-dialog-card">
        <h3>Cambiar a Twilio WhatsApp Business</h3>
        <ul>
          <li>Tu número actual dejará de recibir mensajes del bot.</li>
          <li>Recibirás un número de Twilio en 24-48h.</li>
          <li>El coste adicional se aplicará en la próxima factura.</li>
        </ul>
        <div class="crm-dialog-actions">
          <button type="button" id="provider-confirm" class="crm-btn-primary">Confirmar cambio</button>
          <button type="button" id="provider-cancel" class="crm-btn-ghost">Cancelar</button>
        </div>
      </div>
    </dialog>
  )}

  <dialog id="new-apt-modal" class="crm-dialog">
    <form id="new-apt-form" class="crm-modal-form">
      <h3>Nueva cita</h3>
      <label class="crm-form-lbl">
        Nombre cliente
        <input type="text" name="client_name" required placeholder="Nombre del cliente" class="crm-input" />
      </label>
      <label class="crm-form-lbl">
        Servicio
        <input type="text" name="service" required placeholder="Corte, tinte…" class="crm-input" list="svc-suggest" autocomplete="off" />
        <datalist id="svc-suggest"></datalist>
      </label>
      <div class="crm-field-grp">
        <span class="crm-field-lbl">Fecha</span>
        <div class="apt-date-picker">
          <div class="apt-dp-nav">
            <button type="button" id="apt-dp-prev">←</button>
            <span id="apt-dp-month-label"></span>
            <button type="button" id="apt-dp-next">→</button>
          </div>
          <div class="apt-dp-weekdays"><span>Lu</span><span>Ma</span><span>Mi</span><span>Ju</span><span>Vi</span><span>Sá</span><span>Do</span></div>
          <div class="apt-dp-grid" id="apt-dp-grid"></div>
        </div>
        <span class="apt-date-display" id="apt-date-display">Selecciona una fecha</span>
        <input type="hidden" name="date" id="apt-date-val" />
      </div>
      <div class="crm-field-grp">
        <span class="crm-field-lbl">Hora</span>
        <div class="apt-time-picker" id="apt-time-grid"></div>
        <input type="hidden" name="time" id="apt-time-val" />
      </div>
      <label class="crm-form-lbl">
        Duración (min)
        <input type="number" name="duration_min" value="60" min="15" step="15" class="crm-input" />
      </label>
      <div class="crm-modal-actions">
        <button type="submit" class="crm-btn-primary">Reservar cita</button>
        <button type="button" id="close-apt-modal" class="crm-btn-ghost">Cancelar</button>
      </div>
    </form>
  </dialog>

  <script define:vars={{ clientId, currentProvider: data.channels.whatsapp.provider, isStarter: data.plan === 'starter', customerTelegramUrl, servicesJson: JSON.stringify(data.services ?? []), scheduleJson: JSON.stringify(data.schedule ?? {}) }}>
  (function () {

    // ── Theme ─────────────────────────────────────────────────────────
    const crm = document.getElementById('crm');
    const themeBtn = document.getElementById('crm-theme-btn');

    function applyTheme(t) {
      crm.className = t === 'dark' ? 'crm-dark' : 'crm-light';
      localStorage.setItem('crm-theme', t);
    }
    applyTheme(localStorage.getItem('crm-theme') || 'light');

    themeBtn && themeBtn.addEventListener('click', function () {
      applyTheme(crm.classList.contains('crm-dark') ? 'light' : 'dark');
    });

    // ── Navigation ────────────────────────────────────────────────────
    const burger = document.getElementById('crm-burger');
    const overlay = document.getElementById('crm-overlay');
    const navBtns = document.querySelectorAll('.crm-nav-btn');
    const views = document.querySelectorAll('.crm-view');
    const viewStorageKey = 'crm-view:' + clientId;
    localStorage.setItem('crm-last-client', clientId);

    burger && burger.addEventListener('click', function () { crm.classList.toggle('sidebar-open'); });
    overlay && overlay.addEventListener('click', function () { crm.classList.remove('sidebar-open'); });

    function showView(viewId) {
      views.forEach(function (v) { v.classList.add('crm-hidden'); });
      navBtns.forEach(function (b) { b.classList.remove('active'); });
      var el = document.getElementById('v-' + viewId);
      if (el) el.classList.remove('crm-hidden');
      var nb = document.querySelector('.crm-nav-btn[data-view="' + viewId + '"]');
      if (nb) nb.classList.add('active');
      localStorage.setItem(viewStorageKey, viewId);
      crm.classList.remove('sidebar-open');
    }

    navBtns.forEach(function (btn) {
      btn.addEventListener('click', function () { showView(btn.dataset.view); });
    });

    showView(localStorage.getItem(viewStorageKey) || localStorage.getItem('crm-view') || 'dashboard');

    // ── Toast ─────────────────────────────────────────────────────────
    var toast = document.getElementById('portal-toast');
    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.hidden = false;
      toast.classList.add('crm-toast-show');
      setTimeout(function () { toast.classList.remove('crm-toast-show'); toast.hidden = true; }, 2200);
    }

    // ── Schedule ──────────────────────────────────────────────────────
    var scheduleForm = document.getElementById('schedule-form');

    function buildSchedulePayload(form) {
      var payload = {};
      ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'].forEach(function (day) {
        var closed = form.elements.namedItem(day + '_closed');
        if (closed instanceof HTMLInputElement && closed.checked) { payload[day] = null; return; }
        var open = form.elements.namedItem(day + '_open');
        var close = form.elements.namedItem(day + '_close');
        var lunchCheck = form.elements.namedItem(day + '_lunch');
        var lunchClose = form.elements.namedItem(day + '_lunch_close');
        var lunchOpen = form.elements.namedItem(day + '_lunch_open');
        var hasLunch = lunchCheck instanceof HTMLInputElement && lunchCheck.checked;
        payload[day] = {
          open: open instanceof HTMLInputElement ? open.value : '09:00',
          close: close instanceof HTMLInputElement ? close.value : '19:00',
        };
        if (hasLunch) {
          payload[day].lunch_close = lunchClose instanceof HTMLInputElement ? lunchClose.value : '14:00';
          payload[day].lunch_open = lunchOpen instanceof HTMLInputElement ? lunchOpen.value : '16:00';
        }
      });
      return payload;
    }

    if (scheduleForm) {
      scheduleForm.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
        input.addEventListener('change', function (event) {
          var target = event.currentTarget;
          if (!(target instanceof HTMLInputElement)) return;
          if (target.name.endsWith('_closed')) {
            var day = target.name.replace('_closed', '');
            var isClosed = target.checked;
            ['open','close','lunch_close','lunch_open'].forEach(function (f) {
              var el = scheduleForm.elements.namedItem(day + '_' + f);
              if (el instanceof HTMLInputElement) el.disabled = isClosed;
            });
            var lunchCheck = scheduleForm.elements.namedItem(day + '_lunch');
            if (lunchCheck instanceof HTMLInputElement) {
              lunchCheck.disabled = isClosed;
              if (!isClosed) {
                ['lunch_close','lunch_open'].forEach(function (f) {
                  var el = scheduleForm.elements.namedItem(day + '_' + f);
                  if (el instanceof HTMLInputElement) el.disabled = !lunchCheck.checked;
                });
              }
            }
          } else if (target.name.endsWith('_lunch')) {
            var day2 = target.name.replace('_lunch', '');
            ['lunch_close','lunch_open'].forEach(function (f) {
              var el = scheduleForm.elements.namedItem(day2 + '_' + f);
              if (el instanceof HTMLInputElement) el.disabled = !target.checked;
            });
          }
        });
      });

      scheduleForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        if (!(scheduleForm instanceof HTMLFormElement)) return;
        var response = await fetch('/portal-api/update-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId, config: { schedule: buildSchedulePayload(scheduleForm) } }),
        }).catch(function () { return null; });
        showToast(response && response.ok ? 'Guardado OK' : 'No se pudo guardar');
      });
    }

    // ── Services ──────────────────────────────────────────────────────
    var services = JSON.parse(servicesJson || '[]');

    function esc(s) { var d = document.createElement('div'); d.textContent = String(s != null ? s : ''); return d.innerHTML; }

    function renderServices() {
      var wrap = document.getElementById('services-list-wrap');
      if (!wrap) return;
      if (services.length === 0) {
        wrap.innerHTML = '<p class="crm-empty">Sin servicios. Añade el primero.</p>';
        return;
      }
      wrap.innerHTML = '<div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Servicio</th><th>Duración</th><th>Precio</th><th></th></tr></thead><tbody>' +
        services.map(function (s, i) {
          return '<tr><td>' + esc(s.name) + '</td><td>' + esc(s.duration) + ' min</td><td>' + esc(s.price) + ' €</td><td><button type="button" class="crm-btn-del" data-i="' + i + '">🗑</button></td></tr>';
        }).join('') + '</tbody></table></div>';
      wrap.querySelectorAll('.crm-btn-del').forEach(function (btn) {
        btn.addEventListener('click', function () { services.splice(parseInt(btn.dataset.i), 1); renderServices(); });
      });
    }
    renderServices();

    var svcAdd = document.getElementById('svc-add');
    if (svcAdd) {
      svcAdd.addEventListener('click', function () {
        var nameInput = document.getElementById('svc-name');
        var durInput = document.getElementById('svc-duration');
        var priceInput = document.getElementById('svc-price');
        var name = nameInput ? nameInput.value.trim() : '';
        var duration = parseInt(durInput ? durInput.value : '');
        var price = parseFloat(priceInput ? priceInput.value : '');
        if (!name) { showToast('Nombre obligatorio'); return; }
        if (!duration || duration <= 0) { showToast('Duración inválida'); return; }
        if (isNaN(price) || price < 0) { showToast('Precio inválido'); return; }
        services.push({ name: name, duration: duration, price: price });
        renderServices();
        if (nameInput) nameInput.value = '';
        if (durInput) durInput.value = '';
        if (priceInput) priceInput.value = '';
      });
    }

    var svcSave = document.getElementById('svc-save');
    if (svcSave) {
      svcSave.addEventListener('click', async function () {
        var response = await fetch('/portal-api/update-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId, config: { services: services } }),
        }).catch(function () { return null; });
        showToast(response && response.ok ? 'Guardado ✅' : 'No se pudo guardar');
      });
    }

    // ── Telegram copy ─────────────────────────────────────────────────
    var telegramCopy = document.getElementById('telegram-copy');
    var telegramCustomerLink = document.getElementById('telegram-customer-link');

    if (telegramCopy) {
      telegramCopy.addEventListener('click', async function () {
        try {
          await navigator.clipboard.writeText(customerTelegramUrl);
          showToast('¡Copiado!');
        } catch (_) {
          if (telegramCustomerLink instanceof HTMLInputElement) {
            telegramCustomerLink.focus(); telegramCustomerLink.select();
            document.execCommand('copy');
            showToast('¡Copiado!');
          }
        }
      });
    }

    // ── Provider dialog ───────────────────────────────────────────────
    if (!isStarter) {
      var providerTrigger = document.getElementById('provider-trigger');
      var providerDialog = document.getElementById('provider-dialog');
      var providerCancel = document.getElementById('provider-cancel');
      var providerConfirm = document.getElementById('provider-confirm');

      if (providerTrigger) {
        providerTrigger.addEventListener('click', function () {
          var selected = document.querySelector('input[name="whatsapp_provider"]:checked');
          if (!(selected instanceof HTMLInputElement)) return;
          if (selected.value === currentProvider) { showToast('No hay cambios pendientes'); return; }
          if (providerDialog instanceof HTMLDialogElement) providerDialog.showModal();
        });
      }
      if (providerCancel) {
        providerCancel.addEventListener('click', function () {
          if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
        });
      }
      if (providerConfirm) {
        providerConfirm.addEventListener('click', async function () {
          var selected = document.querySelector('input[name="whatsapp_provider"]:checked');
          if (!(selected instanceof HTMLInputElement)) return;
          var response = await fetch('/portal-api/update-config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId, config: { channels: { whatsapp: { provider: selected.value } } } }),
          }).catch(function () { return null; });
          if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
          showToast(response && response.ok ? 'Cambio solicitado OK' : 'No se pudo solicitar el cambio');
        });
      }
    }

    // ── Calendar ──────────────────────────────────────────────────────
    (function () {
      var currentWeekOffset = 0;
      var DAY_NAMES = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
      var HIDE_ON_MOBILE = [3, 4, 5, 6];

      function getMondayOfWeek(offset) {
        var now = new Date();
        var day = now.getDay();
        var diffToMon = (day === 0 ? -6 : 1 - day);
        var mon = new Date(now);
        mon.setDate(now.getDate() + diffToMon + offset * 7);
        mon.setHours(0, 0, 0, 0);
        return mon;
      }

      function pad(n) { return String(n).padStart(2, '0'); }
      function fmtDate(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
      function fmtTime(iso) { if (!iso) return ''; var d = new Date(iso); return pad(d.getHours()) + ':' + pad(d.getMinutes()); }
      function isToday(d) { var t = new Date(); return d.getFullYear() === t.getFullYear() && d.getMonth() === t.getMonth() && d.getDate() === t.getDate(); }

      async function loadCalendar() {
        var grid = document.getElementById('cal-grid');
        var label = document.getElementById('cal-week-label');
        if (!grid) return;
        grid.innerHTML = '<p class="crm-empty">Cargando…</p>';
        var apts = [];
        try {
          var res = await fetch('/portal-api/appointments?clientId=' + clientId);
          if (res.ok) apts = await res.json();
        } catch (e) {
          grid.innerHTML = '<p class="crm-empty">Error al cargar citas</p>';
          return;
        }
        var monday = getMondayOfWeek(currentWeekOffset);
        var mStr = (monday.getMonth() + 1);
        var sunday = new Date(monday);
        sunday.setDate(monday.getDate() + 6);
        if (label) label.textContent = monday.getDate() + '/' + mStr + ' – ' + sunday.getDate() + '/' + (sunday.getMonth() + 1) + '/' + sunday.getFullYear();

        var schedObj = {};
        try { schedObj = JSON.parse(scheduleJson || '{}'); } catch (_) {}
        var dayKeyList = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
        var minH = 9, maxH = 20;
        dayKeyList.forEach(function(k) {
          var s = schedObj[k];
          if (!s) return;
          var o = parseInt((s.open || '09:00').split(':')[0], 10);
          var c = parseInt((s.close || '20:00').split(':')[0], 10);
          if (o < minH) minH = o;
          if (c > maxH) maxH = c;
        });
        var SLOT_H = 52;
        var totalH = (maxH - minH) * SLOT_H;

        grid.innerHTML = '';
        grid.className = 'crm-tac';

        var hdrEl = document.createElement('div');
        hdrEl.className = 'crm-tac-header';
        var corner = document.createElement('div');
        corner.className = 'crm-tac-corner';
        hdrEl.appendChild(corner);
        for (var di = 0; di < 7; di++) {
          var dDay = new Date(monday);
          dDay.setDate(monday.getDate() + di);
          var dh2 = document.createElement('div');
          dh2.className = 'crm-tac-day-hdr' + (isToday(dDay) ? ' today' : '');
          dh2.innerHTML = '<span class="crm-tac-dn">' + DAY_NAMES[di] + '</span><span class="crm-tac-dd">' + dDay.getDate() + '</span>';
          hdrEl.appendChild(dh2);
        }
        grid.appendChild(hdrEl);

        var scrollEl = document.createElement('div');
        scrollEl.className = 'crm-tac-scroll';

        var innerEl = document.createElement('div');
        innerEl.className = 'crm-tac-inner';
        innerEl.style.height = totalH + 'px';

        var timeColEl = document.createElement('div');
        timeColEl.className = 'crm-tac-time-col';
        timeColEl.style.height = totalH + 'px';
        for (var th3 = minH; th3 <= maxH; th3++) {
          var tl = document.createElement('div');
          tl.className = 'crm-tac-time-lbl';
          tl.style.top = ((th3 - minH) * SLOT_H) + 'px';
          tl.textContent = pad(th3) + ':00';
          timeColEl.appendChild(tl);
        }
        innerEl.appendChild(timeColEl);

        var colsEl = document.createElement('div');
        colsEl.className = 'crm-tac-cols';
        colsEl.style.height = totalH + 'px';
        colsEl.style.position = 'relative';

        for (var ci = 0; ci < 7; ci++) {
          var cDay = new Date(monday);
          cDay.setDate(monday.getDate() + ci);
          var cStr = fmtDate(cDay);
          var cApts = apts.filter(function(a) { return fmtDate(new Date(a.datetime)) === cStr; });

          var col = document.createElement('div');
          col.className = 'crm-tac-col' + (isToday(cDay) ? ' today' : '');

          cApts.forEach(function(apt) {
            var aptD2 = new Date(apt.datetime);
            var fracH = aptD2.getHours() + aptD2.getMinutes() / 60;
            var dur = (apt.duration_min || 60) / 60;
            var top = (fracH - minH) * SLOT_H;
            var height = Math.max(dur * SLOT_H, 26);
            if (fracH < minH || fracH >= maxH) return;
            var st2 = (apt.status || 'confirmed').toLowerCase();
            var blk = document.createElement('div');
            blk.className = 'crm-tac-apt ' + st2;
            blk.style.top = top + 'px';
            blk.style.height = height + 'px';
            blk.innerHTML =
              '<span class="crm-tac-apt-t">' + fmtTime(apt.datetime) + '</span>' +
              '<span class="crm-tac-apt-n">' + esc(apt.clientName || apt.client_name || '') + '</span>' +
              '<span class="crm-tac-apt-s">' + esc(apt.service || '') + '</span>';
            if (st2 !== 'cancelled') {
              var cb = document.createElement('button');
              cb.className = 'crm-cal-apt-cancel';
              cb.textContent = '×';
              (function(aa, bb) {
                bb.addEventListener('click', async function() {
                  bb.disabled = true;
                  try { await fetch('/portal-api/appointments', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({clientId, action:'cancel', aptId:aa.id}) }); } catch(_){}
                  await loadCalendar();
                });
              })(apt, cb);
              blk.appendChild(cb);
            }
            col.appendChild(blk);
          });
          colsEl.appendChild(col);
        }

        var nowD = new Date(); var nowFrac = nowD.getHours() + nowD.getMinutes() / 60;
        if (nowFrac >= minH && nowFrac <= maxH) {
          var nowLine = document.createElement('div');
          nowLine.className = 'crm-tac-now-line';
          nowLine.style.top = ((nowFrac - minH) * SLOT_H) + 'px';
          colsEl.appendChild(nowLine);
        }
        innerEl.appendChild(colsEl);
        scrollEl.appendChild(innerEl);
        grid.appendChild(scrollEl);
      }

      var calPrev = document.getElementById('cal-prev');
      var calNext = document.getElementById('cal-next');
      if (calPrev) calPrev.addEventListener('click', function () { currentWeekOffset--; loadCalendar(); });
      if (calNext) calNext.addEventListener('click', function () { currentWeekOffset++; loadCalendar(); });

      var aptModal = document.getElementById('new-apt-modal');
      var openBtn = document.getElementById('open-apt-modal');
      var closeBtn = document.getElementById('close-apt-modal');
      if (openBtn) {
        openBtn.addEventListener('click', function () {
          dpYear = new Date().getFullYear(); dpMonth = new Date().getMonth();
          dpSelected = null; tpSelected = null;
          var dh = document.getElementById('apt-date-val'); if (dh) dh.value = '';
          var th = document.getElementById('apt-time-val'); if (th) th.value = '';
          var dd = document.getElementById('apt-date-display'); if (dd) dd.textContent = 'Selecciona una fecha';
          var svcList = document.getElementById('svc-suggest');
          if (svcList) svcList.innerHTML = services.map(function(s) { return '<option value="' + esc(s.name) + '">'; }).join('');
          renderDatePicker(); renderTimePicker();
          if (aptModal instanceof HTMLDialogElement) aptModal.showModal();
        });
      }
      if (closeBtn) closeBtn.addEventListener('click', function () { if (aptModal instanceof HTMLDialogElement) aptModal.close(); });

      var aptForm = document.getElementById('new-apt-form');
      if (aptForm) {
        aptForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          var fd = new FormData(e.target);
          var date = fd.get('date'); var time = fd.get('time');
          if (!date || !time) { showToast('Selecciona fecha y hora'); return; }
          try {
            var r = await fetch('/portal-api/appointments', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ clientId, client_name: fd.get('client_name'), service: fd.get('service'), datetime: date + 'T' + time + ':00', duration_min: parseInt(fd.get('duration_min'), 10) || 60 })
            });
            if (!r.ok) throw new Error('api error');
            showToast('Cita creada ✅');
            if (aptModal instanceof HTMLDialogElement) aptModal.close();
            e.target.reset();
          } catch (_) { showToast('Error al crear la cita'); }
          await loadCalendar();
        });
      }

      loadCalendar();
    })();

    // ── Date + Time Pickers ───────────────────────────────────────────
    var DP_MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var dpYear = new Date().getFullYear();
    var dpMonth = new Date().getMonth();
    var dpSelected = null;
    var tpSelected = null;

    function renderDatePicker() {
      var dpGrid = document.getElementById('apt-dp-grid');
      var dpLabel = document.getElementById('apt-dp-month-label');
      var dpDisplay = document.getElementById('apt-date-display');
      var dpHidden = document.getElementById('apt-date-val');
      if (!dpGrid || !dpLabel) return;
      var pad2 = function (n) { return String(n).padStart(2, '0'); };
      dpLabel.textContent = DP_MONTHS[dpMonth] + ' ' + dpYear;
      var firstDay = new Date(dpYear, dpMonth, 1).getDay();
      var offset = (firstDay === 0 ? 6 : firstDay - 1);
      var daysInMonth = new Date(dpYear, dpMonth + 1, 0).getDate();
      var today = new Date(); today.setHours(0, 0, 0, 0);
      dpGrid.innerHTML = '';
      for (var i = 0; i < offset; i++) {
        var empty = document.createElement('span'); empty.className = 'apt-dp-cell empty'; dpGrid.appendChild(empty);
      }
      for (var d = 1; d <= daysInMonth; d++) {
        var cellDate = new Date(dpYear, dpMonth, d);
        var isPast = cellDate < today;
        var isTodayCell = cellDate.getTime() === today.getTime();
        var dateStr = dpYear + '-' + pad2(dpMonth + 1) + '-' + pad2(d);
        var isSelected = dpSelected === dateStr;
        var cell = document.createElement('button');
        cell.type = 'button';
        cell.textContent = String(d);
        cell.className = 'apt-dp-cell' + (isPast ? ' past' : '') + (isTodayCell ? ' today' : '') + (isSelected ? ' selected' : '');
        cell.disabled = isPast;
        if (!isPast) {
          (function (dd, ds) {
            cell.addEventListener('click', function () {
              dpSelected = ds;
              if (dpHidden) dpHidden.value = ds;
              if (dpDisplay) dpDisplay.textContent = dd + ' de ' + DP_MONTHS[dpMonth] + ' ' + dpYear;
              tpSelected = null;
              var th2 = document.getElementById('apt-time-val'); if (th2) th2.value = '';
              renderDatePicker();
              renderTimePicker();
            });
          })(d, dateStr);
        }
        dpGrid.appendChild(cell);
      }
    }

    function renderTimePicker() {
      var tpGrid = document.getElementById('apt-time-grid');
      var tpHidden = document.getElementById('apt-time-val');
      if (!tpGrid) return;
      tpGrid.innerHTML = '';
      var pad2 = function (n) { return String(n).padStart(2, '0'); };
      var dayStart = 8, dayEnd = 20, lunchClose = null, lunchOpen = null;
      if (dpSelected) {
        var sched2 = {};
        try { sched2 = JSON.parse(scheduleJson || '{}'); } catch (_) {}
        var dow = new Date(dpSelected + 'T12:00:00').getDay();
        var dowKey = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][dow];
        var ds = sched2[dowKey];
        if (ds) {
          dayStart = parseInt((ds.open || '08:00').split(':')[0], 10);
          dayEnd = parseInt((ds.close || '20:00').split(':')[0], 10);
          if (ds.lunch_close) lunchClose = ds.lunch_close;
          if (ds.lunch_open) lunchOpen = ds.lunch_open;
        }
      }
      for (var h = dayStart; h <= dayEnd; h++) {
        for (var mi = 0; mi < 2; mi++) {
          var m = mi * 30;
          if (h === dayEnd && m > 0) continue;
          var slot = pad2(h) + ':' + pad2(m);
          if (lunchClose && lunchOpen && slot >= lunchClose && slot < lunchOpen) continue;
          (function (sl) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = sl;
            btn.className = 'apt-time-slot' + (tpSelected === sl ? ' selected' : '');
            btn.addEventListener('click', function () { tpSelected = sl; if (tpHidden) tpHidden.value = sl; renderTimePicker(); });
            tpGrid.appendChild(btn);
          })(slot);
        }
      }
      if (!tpGrid.children.length) {
        tpGrid.innerHTML = '<span style="font-size:12px;color:var(--crm-muted)">Día cerrado o sin horario</span>';
      }
    }

    var dpPrev = document.getElementById('apt-dp-prev');
    var dpNext = document.getElementById('apt-dp-next');
    if (dpPrev) dpPrev.addEventListener('click', function () { dpMonth--; if (dpMonth < 0) { dpMonth = 11; dpYear--; } renderDatePicker(); });
    if (dpNext) dpNext.addEventListener('click', function () { dpMonth++; if (dpMonth > 11) { dpMonth = 0; dpYear++; } renderDatePicker(); });


    // ── Missed call ────────────────────────────────────────────────────
    var missedBtn = document.getElementById('btn-missed-call');
    if (missedBtn) {
      missedBtn.addEventListener('click', async function () {
        var phone = document.getElementById('missed-call-phone').value.trim().replace(/\s/g, '');
        if (!phone) { showToast('Introduce el teléfono'); return; }
        missedBtn.disabled = true; missedBtn.textContent = 'Enviando...';
        try {
          var r = await fetch('/portal-api/missed-call', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId, phone: phone }),
          });
          var d = await r.json();
          if (d.ok) {
            showToast(d.channel === 'whatsapp' ? '✅ Lara le ha escrito por WhatsApp' : '✅ Propietario notificado por Telegram');
            document.getElementById('missed-call-phone').value = '';
          } else { showToast('Error: ' + (d.error || 'no disponible')); }
        } catch (_) { showToast('Error de conexión'); }
        missedBtn.disabled = false; missedBtn.textContent = 'Enviar';
      });
    }

    // ── Regenerate web ─────────────────────────────────────────────────
    var regenBtn = document.getElementById('btn-regen-web');
    if (regenBtn) {
      regenBtn.addEventListener('click', async function () {
        regenBtn.disabled = true; regenBtn.textContent = 'Generando...';
        try {
          var r = await fetch('/portal-api/regenerate-web', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId }),
          });
          var d = await r.json();
          if (d.ok && d.url) {
            document.getElementById('web-url-display').innerHTML = '<a href="' + d.url + '" target="_blank" style="color:#4ECDC4">' + d.url + '</a>';
            showToast('✅ Mini-web generada');
          } else { showToast('Error generando la web: ' + (d.error || '')); }
        } catch (_) { showToast('Error de conexión'); }
        regenBtn.disabled = false; regenBtn.textContent = 'Generar web';
      });
    }

    // ── Billing portal button ──────────────────────────────────────────
    var billingBtn = document.getElementById('btn-billing-portal');
    if (billingBtn) {
      billingBtn.addEventListener('click', async function () {
        billingBtn.disabled = true;
        billingBtn.textContent = 'Cargando...';
        try {
          var r = await fetch('/portal-api/billing?clientId=' + encodeURIComponent(clientId));
          var d = await r.json();
          if (d.url) {
            window.location.href = d.url;
          } else {
            showToast('Error al abrir el portal de facturación');
            billingBtn.disabled = false;
            billingBtn.textContent = 'Gestionar suscripción';
          }
        } catch (_) {
          showToast('Error de conexión');
          billingBtn.disabled = false;
          billingBtn.textContent = 'Gestionar suscripción';
        }
      });
    }

    // ── Invoices loader ────────────────────────────────────────────────
    function loadInvoices() {
      var loading = document.getElementById('invoices-loading');
      var empty = document.getElementById('invoices-empty');
      var table = document.getElementById('invoices-table');
      var tbody = document.getElementById('invoices-tbody');
      if (!loading || !tbody) return;
      fetch('/portal-api/invoices?clientId=' + encodeURIComponent(clientId))
        .then(function(r) { return r.json(); })
        .then(function(d) {
          loading.classList.add('crm-hidden');
          if (!d.ok || !d.invoices || d.invoices.length === 0) {
            empty.classList.remove('crm-hidden');
            return;
          }
          d.invoices.forEach(function(inv) {
            var date = new Date(inv.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
            var amount = inv.amount.toFixed(2) + ' ' + inv.currency;
            var statusLabel = inv.status === 'paid' ? '<span class="inv-status paid">Pagada</span>' :
              inv.status === 'open' ? '<span class="inv-status open">Pendiente</span>' :
              '<span class="inv-status other">' + inv.status + '</span>';
            var downloadBtn = inv.pdf ? '<a href="' + inv.pdf + '" target="_blank" class="inv-dl-btn">PDF</a>' : '';
            var tr = document.createElement('tr');
            tr.innerHTML = '<td>' + date + '</td><td>' + (inv.description || 'Suscripción Nexux') + '</td><td>' + amount + '</td><td>' + statusLabel + '</td><td>' + downloadBtn + '</td>';
            tbody.appendChild(tr);
          });
          table.classList.remove('crm-hidden');
        })
        .catch(function() {
          loading.classList.add('crm-hidden');
          empty.classList.remove('crm-hidden');
        });
    }

    // Load invoices when billing nav button is clicked
    var billingNavBtn = document.querySelector('.crm-nav-btn[data-view=billing]');
    if (billingNavBtn) {
      billingNavBtn.addEventListener('click', function() {
        var table = document.getElementById('invoices-table');
        if (table && !table.classList.contains('inv-loaded')) {
          table.classList.add('inv-loaded');
          loadInvoices();
        }
      });
    }
    // Also load if billing is the initial view
    if ((localStorage.getItem('crm-view') || 'dashboard') === 'billing') {
      var table = document.getElementById('invoices-table');
      if (table) { table.classList.add('inv-loaded'); loadInvoices(); }
    }

  })();
  </script>

  <style>
    /* ── CRM Reset & Layout ─────────────────────────────────────────── */
    #crm {
      position: fixed;
      inset: 0;
      z-index: 999;
      display: flex;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Theme tokens ───────────────────────────────────────────────── */
    .crm-light {
      --crm-bg: #F5F5F7;
      --crm-surface: #FFFFFF;
      --crm-sidebar-bg: #FFFFFF;
      --crm-topbar-bg: rgba(255,255,255,0.88);
      --crm-text: #1d1d1f;
      --crm-muted: #6e6e73;
      --crm-accent: #2a9d97;
      --crm-accent-hi: #4ECDC4;
      --crm-line: rgba(0,0,0,0.09);
      --crm-shadow: 0 1px 3px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04);
      --crm-shadow-card: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.05);
      --crm-nav-hover: rgba(0,0,0,0.05);
      --crm-nav-active-bg: rgba(42,157,151,0.1);
      --crm-nav-active-text: #1a7a76;
      --crm-input-bg: rgba(0,0,0,0.04);
      --crm-input-border: rgba(0,0,0,0.14);
      --crm-input-text: #1d1d1f;
      --crm-dp-text: rgba(29,29,31,0.9);
      --crm-dp-past: rgba(29,29,31,0.25);
      --crm-dp-bg: rgba(0,0,0,0.03);
      --crm-slot-bg: rgba(0,0,0,0.04);
      --crm-slot-border: rgba(0,0,0,0.12);
    }

    .crm-dark {
      --crm-bg: #0A0A0F;
      --crm-surface: #12121A;
      --crm-sidebar-bg: #0d0d14;
      --crm-topbar-bg: rgba(10,10,15,0.88);
      --crm-text: #F2F2EC;
      --crm-muted: rgba(242,242,236,0.5);
      --crm-accent: #4ECDC4;
      --crm-accent-hi: #4ECDC4;
      --crm-line: rgba(242,242,236,0.08);
      --crm-shadow: 0 1px 3px rgba(0,0,0,0.3), 0 4px 16px rgba(0,0,0,0.2);
      --crm-shadow-card: 0 1px 3px rgba(0,0,0,0.3), 0 4px 16px rgba(0,0,0,0.15);
      --crm-nav-hover: rgba(242,242,236,0.05);
      --crm-nav-active-bg: rgba(78,205,196,0.12);
      --crm-nav-active-text: #4ECDC4;
      --crm-input-bg: rgba(11,13,18,0.6);
      --crm-input-border: rgba(242,242,236,0.12);
      --crm-input-text: #F2F2EC;
      --crm-dp-text: rgba(242,242,236,0.9);
      --crm-dp-past: rgba(242,242,236,0.22);
      --crm-dp-bg: rgba(11,13,18,0.55);
      --crm-slot-bg: rgba(242,242,236,0.05);
      --crm-slot-border: rgba(242,242,236,0.15);
    }

    #crm { background: var(--crm-bg); color: var(--crm-text); }

    /* ── Sidebar ────────────────────────────────────────────────────── */
    .crm-sidebar {
      width: 220px;
      flex-shrink: 0;
      background: var(--crm-sidebar-bg);
      border-right: 1px solid var(--crm-line);
      display: flex;
      flex-direction: column;
      padding: 1.25rem 0.75rem;
      transition: transform 0.25s cubic-bezier(0.4,0,0.2,1);
      z-index: 20;
      gap: 0.5rem;
    }

    .crm-logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0 0.5rem 1rem;
      border-bottom: 1px solid var(--crm-line);
      margin-bottom: 0.5rem;
    }

    .crm-logo-mark {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: var(--crm-accent);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .crm-logo-words {
      font-size: 15px;
      font-weight: 600;
      color: var(--crm-text);
      letter-spacing: -0.02em;
    }

    .crm-logo-words em { color: var(--crm-accent); font-style: normal; }

    .crm-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      flex: 1;
    }

    .crm-nav-btn {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 0.75rem;
      border-radius: 10px;
      border: none;
      background: none;
      color: var(--crm-muted);
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      text-align: left;
      transition: background 0.14s, color 0.14s;
      width: 100%;
    }

    .crm-nav-btn:hover { background: var(--crm-nav-hover); color: var(--crm-text); }
    .crm-nav-btn.active { background: var(--crm-nav-active-bg); color: var(--crm-nav-active-text); font-weight: 600; }
    .crm-nav-btn svg { flex-shrink: 0; opacity: 0.75; }
    .crm-nav-btn.active svg { opacity: 1; }

    .crm-sidebar-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.75rem;
      border-top: 1px solid var(--crm-line);
      margin-top: 0.5rem;
    }

    .crm-plan-chip {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--crm-accent);
      background: var(--crm-nav-active-bg);
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
    }

    .crm-support-link {
      font-size: 12px;
      color: var(--crm-muted);
      text-decoration: none;
    }

    .crm-support-link:hover { color: var(--crm-accent); }

    /* ── Mobile overlay + burger ────────────────────────────────────── */
    .crm-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      z-index: 15;
      backdrop-filter: blur(2px);
    }

    .crm-burger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--crm-text);
      padding: 0.25rem;
      flex-shrink: 0;
    }

    @media (max-width: 768px) {
      .crm-burger { display: flex; }
      .crm-sidebar {
        position: fixed;
        top: 0; left: 0; bottom: 0;
        transform: translateX(-100%);
        box-shadow: 4px 0 24px rgba(0,0,0,0.15);
      }
      #crm.sidebar-open .crm-sidebar { transform: translateX(0); }
      #crm.sidebar-open .crm-overlay { display: block; }
    }

    /* ── Body + Topbar ──────────────────────────────────────────────── */
    .crm-body {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .crm-topbar {
      height: 54px;
      display: flex;
      align-items: center;
