    // ── Provider dialog ───────────────────────────────────────────────
    if (!isStarter) {
      var providerTrigger = document.getElementById('provider-trigger');
      var providerDialog = document.getElementById('provider-dialog');
      var providerCancel = document.getElementById('provider-cancel');
      var providerConfirm = document.getElementById('provider-confirm');

      if (providerTrigger) {
        providerTrigger.addEventListener('click', function () {
          var selected = document.querySelector('input[name="whatsapp_provider"]:checked');
          if (!(selected instanceof HTMLInputElement)) return;
          if (selected.value === currentProvider) { showToast('No hay cambios pendientes'); return; }
          if (providerDialog instanceof HTMLDialogElement) providerDialog.showModal();
        });
      }
      if (providerCancel) {
