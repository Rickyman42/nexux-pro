    // ── Telegram copy ─────────────────────────────────────────────────
    // ── Telegram QR ───────────────────────────────────────────────────────────
    (function () {
      var canvas = document.getElementById('tg-qr-canvas');
      var dlLink = document.getElementById('tg-qr-download');
      if (!canvas || !customerTelegramUrl) return;
      function renderTgQr() {
        if (typeof QRCode === 'undefined') { setTimeout(renderTgQr, 300); return; }
        QRCode.toCanvas(canvas, customerTelegramUrl, { width: 180, margin: 1, color: { dark: '#0a0a0f', light: '#ffffff' } }, function (err) {
          if (!err && dlLink) { dlLink.href = canvas.toDataURL('image/png'); }
        });
      }
      renderTgQr();
    })();

    // ── WhatsApp live QR ──────────────────────────────────────────────────────
    (function () {
      var qrBlock = document.getElementById('wa-qr-block');
      if (!qrBlock) return;
      var qrSpinner = document.getElementById('wa-qr-spinner');
      var qrImg    = document.getElementById('wa-qr-img');
      var qrOk     = document.getElementById('wa-qr-connected');
      var pollTimer = null;
      var pollInterval = 5000;

      function pollWaQr() {
        fetch('/portal-api/wa-qr?clientId=' + encodeURIComponent(clientId))
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.status === 'connected') {
              if (qrSpinner) qrSpinner.style.display = 'none';
              if (qrImg)     qrImg.style.display = 'none';
              if (qrOk)      qrOk.style.display = '';
              var waChip = document.querySelector('#v-canales .crm-card-head .chip-yellow, #v-canales .crm-card-head .chip-red');
              if (waChip) { waChip.textContent = 'Conectado'; waChip.className = waChip.className.replace(/chip-yellow|chip-red/g, 'chip-green'); }
              return;
            }
            if (d.status === 'qr' && d.qr) {
              if (qrSpinner) qrSpinner.style.display = 'none';
              if (qrImg) { qrImg.src = 'data:image/png;base64,' + d.qr; qrImg.style.display = ''; }
            } else {
              if (qrSpinner) qrSpinner.style.display = '';
              if (qrImg) qrImg.style.display = 'none';
            }
            pollTimer = setTimeout(pollWaQr, d.status === 'qr' ? 30000 : pollInterval);
          })
          .catch(function () { pollTimer = setTimeout(pollWaQr, pollInterval); });
      }

      var canalSection = document.getElementById('v-canales');
      var observer = new MutationObserver(function () {
        var visible = canalSection && !canalSection.classList.contains('crm-hidden');
        if (visible && !pollTimer) { pollWaQr(); }
        if (!visible && pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
      });
      if (canalSection) observer.observe(canalSection, { attributes: true, attributeFilter: ['class'] });
      if (canalSection && !canalSection.classList.contains('crm-hidden')) pollWaQr();
    })();

        var telegramCopy = document.getElementById('telegram-copy');
    var telegramCustomerLink = document.getElementById('telegram-customer-link');

    if (telegramCopy) {
      telegramCopy.addEventListener('click', async function () {
        try {
          await navigator.clipboard.writeText(customerTelegramUrl);
          showToast('¡Copiado!');
        } catch (_) {
          if (telegramCustomerLink instanceof HTMLInputElement) {
            telegramCustomerLink.focus(); telegramCustomerLink.select();
            document.execCommand('copy');
            showToast('¡Copiado!');
          }
        }
      });
