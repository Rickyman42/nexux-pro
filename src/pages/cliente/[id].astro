---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getClientData, type Appointment } from '../../lib/portal-client';

const { id: clientId } = Astro.params;
const token = Astro.cookies.get('nexux_token')?.value;

if (!clientId || !token) {
  return Astro.redirect(`/cliente/${clientId ?? ''}/login?reason=session`);
}

const data = await getClientData(clientId, token);

// Senales de confianza: que el dueno vea de un vistazo que el sistema esta vivo,
// sin tener que preguntarselo a nadie. Si el dato no llega, se dice; no se maquilla.
const _conf = (data as any).confianza || {};
const _lara = _conf.lara || null;
const _backup = _conf.backup || null;
const _tzCrm = data.timezone || 'Europe/Madrid';

function _haceCuanto(iso: string | null): string {
  if (!iso) return '';
  const min = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
  if (min < 1) return 'ahora mismo';
  if (min < 60) return `hace ${min} min`;
  const h = Math.round(min / 60);
  if (h < 24) return `hace ${h} h`;
  return `hace ${Math.round(h / 24)} d`;
}
function _horaCorta(iso: string | null): string {
  if (!iso) return '';
  return new Date(iso).toLocaleString('es-ES', {
    timeZone: _tzCrm, day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
  });
}

const laraHoy = _lara?.conversacionesHoy ?? null;
const laraUltima = _lara?.ultimaRespuesta ?? null;
// Verde solo si ha contestado en las ultimas 24 h: un verde permanente no informa de nada.
const laraViva = !!laraUltima && (Date.now() - new Date(laraUltima).getTime()) < 86400000;
const laraTexto = !_lara
  ? 'Sin datos'
  : laraHoy > 0
    ? `${laraHoy} conversacion${laraHoy === 1 ? '' : 'es'} hoy`
    : laraUltima ? `Ultima ${_haceCuanto(laraUltima)}` : 'Sin conversaciones aun';

// La copia se hace cada noche: si la ultima tiene mas de 36 h, algo va mal.
const backupAlDia = !!_backup && (Date.now() - new Date(_backup.fecha).getTime()) < 129600000;
const backupTexto = _backup ? _horaCorta(_backup.fecha) : 'Sin copia';
if (!data) {
  return Astro.redirect(`/cliente/${clientId}/login?reason=expired`);
}

const dateFormatter = new Intl.DateTimeFormat('es-ES', { weekday: 'short', day: 'numeric', month: 'long', timeZone: data.timezone || 'Europe/Madrid' });
const timeFormatter = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: data.timezone || 'Europe/Madrid' });

const todayKey = new Date().toDateString();
const todayAppointments = data.nextAppointments.filter(item => new Date(item.datetime).toDateString() === todayKey).length;
const limitedProgress = data.metrics.conversationLimit
  ? Math.min(100, Math.round((data.metrics.conversationCount / data.metrics.conversationLimit) * 100))
  : 100;
const isRecepcionista = data.plan === 'recepcionista';
const hasLegacyAdvancedTools = data.plan === 'pro' || data.plan === 'total';
const planLabel = isRecepcionista
  ? 'Recepcionista IA'
  : data.plan.charAt(0).toUpperCase() + data.plan.slice(1);
const planPriceLabel = isRecepcionista
  ? '29€/mes'
  : data.plan === 'starter'
    ? '249€/mes'
    : data.plan === 'pro'
      ? '449€/mes'
      : '749€/mes';
const qrImageSrc = data.qrPngBase64
  ? data.qrPngBase64.startsWith('data:image') ? data.qrPngBase64 : `data:image/png;base64,${data.qrPngBase64}`
  : null;
const ownerTelegramUrl = `https://t.me/NexuxProAssistantBot?start=${data.clientId}`;
const customerTelegramUrl = `https://t.me/NexuxProAssistantBot?start=c_${data.clientId}`;
const showWhatsApp = !!data.channels.whatsapp?.provider;

const booked = data.metrics.appointmentsBooked;
const avgPrice = data.services?.length
  ? data.services.reduce((s, sv) => s + (sv.price || 0), 0) / data.services.length
  : 30;
const roiRevenue = Math.round(booked * avgPrice);
const roiTimeSaved = booked * 5;

// Contador regresivo de conversaciones (plan starter)
const convCount = data.metrics.conversationCount ?? 0;
const convLimit = data.metrics.conversationLimit;
const convRemaining = convLimit != null ? Math.max(0, convLimit - convCount) : null;

// Renovacion / prueba
const _renewISO = data.billing?.trialEndsAt || data.billing?.expiresAt || null;
const renewDaysLeft = _renewISO
  ? Math.max(0, Math.ceil((new Date(_renewISO).getTime() - Date.now()) / 86400000))
  : null;
const renewLabel = data.billing?.isTrial ? 'Días de prueba' : 'Renueva en';
const renewDate = _renewISO
  ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', timeZone: data.timezone || 'Europe/Madrid' }).format(new Date(_renewISO))
  : null;
const nextApt = data.nextAppointments?.[0] ?? null;
const nextAptFormatted = nextApt
  ? { date: dateFormatter.format(new Date(nextApt.datetime)), time: timeFormatter.format(new Date(nextApt.datetime)) }
  : null;

const todayIndex = new Date().getDay();
const todayScheduleKey = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'][todayIndex];
const todaySchedule = data.schedule?.[todayScheduleKey] ?? null;
const confirmedTodayAppointments = data.nextAppointments.filter(item => {
  const itemDate = new Date(item.datetime);
  return item.status !== 'cancelled' && itemDate.toDateString() === todayKey;
});
const defaultServiceDuration = data.services?.length
  ? Math.round(data.services.reduce((sum, service) => sum + (service.duration || 60), 0) / data.services.length)
  : 60;

function minutesFromTime(value?: string) {
  if (!value) return 0;
  const [hours, minutes] = value.split(':').map(Number);
  return (hours || 0) * 60 + (minutes || 0);
}

function estimateOpenMinutes(schedule: typeof todaySchedule) {
  if (!schedule) return 0;
  const open = minutesFromTime(schedule.open);
  const close = minutesFromTime(schedule.close);
  return Math.max(0, close - open);
}

const todayOpenMinutes = estimateOpenMinutes(todaySchedule);
const bookedTodayMinutes = confirmedTodayAppointments.reduce((sum, item) => sum + ((item as any).duration_min || defaultServiceDuration), 0);
const freeSlotsToday = todayOpenMinutes > 0
  ? Math.max(0, Math.floor((todayOpenMinutes - bookedTodayMinutes) / Math.max(defaultServiceDuration, 30)))
  : 0;
const manualReviewCount = data.active && (data.channels.whatsapp.connected || data.channels.telegram.ownerLinked) ? 0 : 1;
const manualReviewLabel = manualReviewCount === 0 ? 'Sin intervencion pendiente' : 'Revisar canales';
const freeSlotsLabel = todayOpenMinutes > 0 ? `${freeSlotsToday} hueco${freeSlotsToday === 1 ? '' : 's'}` : 'Cerrado hoy';

const weekdayLabels: [string, string][] = [
  ['monday','Lunes'],['tuesday','Martes'],['wednesday','Miercoles'],
  ['thursday','Jueves'],['friday','Viernes'],['saturday','Sabado'],['sunday','Domingo'],
];

function renderAppointmentDate(item: Appointment) {
  const date = new Date(item.datetime);
  return { date: dateFormatter.format(date), time: timeFormatter.format(date) };
}
---
<Layout
  title={`Portal - ${data.name}`}
  description={`Portal del cliente ${data.name} en Nexux Pro.`}
  canonical={`https://nexux.pro/cliente/${clientId}`}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
    <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
  </Fragment>

  <div id="crm" class="crm-light" data-clientid={clientId} data-inbox-token={token}>

    <!-- SIDEBAR -->
    <aside class="crm-sidebar" id="crm-sidebar">
      <div class="crm-logo">
        <span class="crm-logo-mark">N</span>
        <div class="crm-logo-words">nexux<em>pro</em></div>
      </div>

      <nav class="crm-nav">
        <button class="crm-nav-btn active" data-view="dashboard">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          Dashboard
        </button>
        <button class="crm-nav-btn" data-view="citas">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Citas
        </button>
        <button class="crm-nav-btn" data-view="conversaciones">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Chats
        </button>
        <button class="crm-nav-btn" data-view="clientes">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Clientes
        </button>
        <button class="crm-nav-btn" data-view="canales">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Canales
        </button>
        <button class="crm-nav-btn" data-view="config">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M4.93 4.93l1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
          Configuración
        </button>
        <button class="crm-nav-btn" data-view="billing">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          Facturación
        </button>
      </nav>

      <div class="crm-sidebar-foot">
        <span class="crm-plan-chip">{planLabel}</span>
        <a href={`/cliente/${clientId}/onboarding`} class="crm-support-link crm-setup-link">⚙ Configuración inicial</a>
        <a href="https://t.me/nexux_soporte_bot" target="_blank" rel="noopener" class="crm-support-link">Soporte</a>
      </div>
    </aside>

    <div class="crm-overlay" id="crm-overlay"></div>

    <!-- BODY -->
    <div class="crm-body">
      <header class="crm-topbar">
        <button class="crm-burger" id="crm-burger" aria-label="Menu">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="crm-topbar-info">
          <span class="crm-topbar-name">{data.name}</span>
          <span class={`crm-topbar-badge ${data.active ? 'badge-live' : 'badge-off'}`}>
            <span class="crm-dot"></span>
            {data.active ? 'Activo' : 'Inactivo'}
          </span>
        </div>
        <button class="crm-theme-btn" id="crm-theme-btn" title="Cambiar tema">
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </header>

      <main class="crm-main">
        <script>
          (function(){
            try {
              var cid = document.getElementById('crm')?.dataset?.clientid;
              if (!cid) return;
              if (!localStorage.getItem('nx_ob_' + cid)) {
                window.location.replace('/cliente/' + cid + '/onboarding');
              }
            } catch(e){}
          })();
        </script>

        <section class="crm-ops-strip" aria-label="Resumen operativo de hoy">
          <div class="crm-ops-item">
            <span class="crm-ops-label">Citas hoy</span>
            <strong class="crm-ops-value">{todayAppointments}</strong>
            <span class="crm-ops-note">{nextAptFormatted ? `Proxima ${nextAptFormatted.time}` : 'Sin proximas citas'}</span>
          </div>
          <div class="crm-ops-item">
            <span class="crm-ops-label">Mensajes a revisar</span>
            <strong class="crm-ops-value">{manualReviewCount}</strong>
            <span class="crm-ops-note">{manualReviewLabel}</span>
          </div>
          <div class="crm-ops-item">
            <span class="crm-ops-label">Huecos libres</span>
            <strong class="crm-ops-value">{freeSlotsLabel}</strong>
            <span class="crm-ops-note">Estimado segun horario y duracion media</span>
          </div>
        </section>

        <!-- ── DASHBOARD ──────────────────────────────────── -->
        <section class="crm-view" id="v-dashboard">
          <div class="crm-view-hdr">
            <h1 class="crm-view-title">Dashboard</h1>
          </div>

          <div class="crm-kpi-grid">
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Citas hoy</span>
              <strong class="crm-kpi-val">{todayAppointments}</strong>
            </div>
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Total reservadas</span>
              <strong class="crm-kpi-val">{data.metrics.appointmentsBooked}</strong>
            </div>
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">{convRemaining != null ? 'Conversaciones restantes' : 'Conversaciones'}</span>
              <strong class="crm-kpi-val">{convRemaining != null ? convRemaining : convCount}{convLimit != null && (<span class="crm-kpi-sub">de {convLimit}</span>)}</strong>
              {convLimit != null && (
                <div class="crm-progress"><div class="crm-progress-bar" style={`width:${limitedProgress}%`}></div></div>
              )}
            </div>
            <div class="crm-kpi">
              <span class="crm-kpi-lbl">Cancelaciones</span>
              <strong class="crm-kpi-val">{data.metrics.appointmentsCancelled}</strong>
            </div>
            {renewDaysLeft != null && (
              <div class="crm-kpi">
                <span class="crm-kpi-lbl">{renewLabel}</span>
                <strong class="crm-kpi-val">{renewDaysLeft}<span class="crm-kpi-sub">{renewDate ? renewDate : ''}</span></strong>
              </div>
            )}
          </div>

          <div class="crm-dash-row">
            <div class="crm-card crm-status-card">
              <h2 class="crm-card-title">Estado</h2>
              <div class="crm-status-list">
                {showWhatsApp && (
                  <div class="crm-status-item">
                    <span class="crm-status-lbl">WhatsApp</span>
                    <span class="crm-status-val">
                      <span class={`crm-dot ${data.channels.whatsapp.connected ? 'dot-green' : data.botStatus === 'pending_qr' ? 'dot-yellow' : 'dot-red'}`}></span>
                      {data.channels.whatsapp.connected ? `Conectado` : data.botStatus === 'pending_qr' ? 'Pendiente QR' : data.botStatus === 'reconnecting' ? 'Reconectando' : 'Desconectado'}
                    </span>
                  </div>
                )}
                <div class="crm-status-item">
                  <span class="crm-status-lbl">Telegram</span>
                  <span class="crm-status-val">
                    <span class={`crm-dot ${data.channels.telegram.ownerLinked ? 'dot-green' : 'dot-yellow'}`}></span>
                    {data.channels.telegram.ownerLinked ? 'Vinculado' : 'Pendiente'}
                  </span>
                </div>
                <div class="crm-status-item">
                  <span class="crm-status-lbl">Bot</span>
                  <span class="crm-status-val">
                    <span class={`crm-dot ${data.active ? 'dot-green' : 'dot-red'}`}></span>
                    {data.active ? 'Activo' : 'Inactivo'}
                  </span>
                </div>
                <div class="crm-status-item">
                  <span class="crm-status-lbl">Lara</span>
                  <span class="crm-status-val">
                    <span class={`crm-dot ${laraViva ? 'dot-green' : 'dot-yellow'}`}></span>
                    {laraTexto}
                  </span>
                </div>
                <div class="crm-status-item">
                  <span class="crm-status-lbl">Copia de seguridad</span>
                  <span class="crm-status-val">
                    <span class={`crm-dot ${backupAlDia ? 'dot-green' : 'dot-red'}`}></span>
                    {backupTexto}
                  </span>
                </div>
              </div>
            </div>

            <div class="crm-card crm-apts-card">
              <div class="crm-card-head">
                <h2 class="crm-card-title">Próximas citas</h2>
                <span class="crm-chip chip-accent">{todayAppointments} hoy</span>
              </div>
              {data.nextAppointments.length ? (
                <div class="crm-table-wrap">
                  <table class="crm-table">
                    <thead><tr><th>Fecha</th><th>Hora</th><th>Cliente</th><th>Servicio</th><th>Estado</th></tr></thead>
                    <tbody>
                      {data.nextAppointments.slice(0, 6).map(item => {
                        const row = renderAppointmentDate(item);
                        return (
                          <tr>
                            <td>{row.date}</td>
                            <td>{row.time}</td>
                            <td>{item.clientName || item.clientPhone}</td>
                            <td>{item.service}</td>
                            <td><span class={`crm-chip ${item.status === 'confirmed' ? 'chip-green' : 'chip-red'}`}>{item.status === 'confirmed' ? 'Confirmada' : 'Cancelada'}</span></td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="crm-empty">Las citas reservadas por tu bot aparecerán aquí.</p>
              )}
            </div>
          </div>

          <!-- Próxima cita + ROI -->
          <div class="crm-dash-row2">
            <div class="crm-card crm-next-apt-card">
              <h2 class="crm-card-title">Próxima cita</h2>
              {nextAptFormatted && nextApt ? (
                <div class="crm-next-apt-content">
                  <div class="crm-next-apt-time">
                    <span class="crm-next-apt-date">{nextAptFormatted.date}</span>
                    <strong class="crm-next-apt-hour">{nextAptFormatted.time}</strong>
                  </div>
                  <div>
                    <div style="font-size:14px;font-weight:600;color:var(--crm-text)">{nextApt.clientName || nextApt.clientPhone}</div>
                    <div class="crm-muted-p">{nextApt.service}</div>
                  </div>
                </div>
              ) : (
                <p class="crm-empty">Sin citas próximas</p>
              )}
            </div>
            <div class="crm-card crm-roi-card">
              <h2 class="crm-card-title">ROI del bot</h2>
              <div class="crm-roi-grid">
                <div class="crm-roi-item">
                  <span class="crm-kpi-lbl">Ingresos generados</span>
                  <strong class="crm-roi-val crm-roi-green">~{roiRevenue}€</strong>
                  <span class="crm-roi-sub">{booked} cita{booked !== 1 ? 's' : ''} × ~{Math.round(avgPrice)}€ ticket medio</span>
                </div>
                <div class="crm-roi-item">
                  <span class="crm-kpi-lbl">Tiempo ahorrado</span>
                  <strong class="crm-roi-val">{roiTimeSaved} min</strong>
                  <span class="crm-roi-sub">~5 min de llamada por reserva</span>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Herramientas rápidas ─────────────────────────────── -->
          {!isRecepcionista && <div class="crm-dash-row" style="margin-top:1.5rem">
            <div class="crm-card" style="flex:1">
              <h2 class="crm-card-title">⚡ Herramientas rápidas</h2>
              <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:0.75rem">

                {data.plan === 'starter' ? (
                  <>
                    <!-- Llamada perdida — bloqueado en Starter -->
                    <div style="background:#1a1d2e;border-radius:10px;padding:1rem;opacity:0.6;position:relative">
                      <div style="position:absolute;top:0.6rem;right:0.75rem;font-size:0.75rem;background:#2d3148;color:#94a3b8;padding:0.2rem 0.5rem;border-radius:99px">Plan Pro</div>
                      <p style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.5rem">📞 <strong style="color:#e2e8f0">Llamada perdida</strong> — Lara contacta al cliente automáticamente</p>
                      <a href="https://nexux.pro/paquetes/pro" target="_blank" rel="noopener" style="display:inline-block;font-size:0.8rem;color:#4ECDC4;font-weight:600;text-decoration:none;margin-top:0.25rem">Actualizar a Pro para activar →</a>
                    </div>

                    <!-- Mini-web — bloqueado en Starter -->
                    <div style="background:#1a1d2e;border-radius:10px;padding:1rem;opacity:0.6;position:relative">
                      <div style="position:absolute;top:0.6rem;right:0.75rem;font-size:0.75rem;background:#2d3148;color:#94a3b8;padding:0.2rem 0.5rem;border-radius:99px">Plan Pro</div>
                      <p style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.5rem">🌐 <strong style="color:#e2e8f0">Mini-web</strong> — Página con tus servicios y horarios optimizada para Google</p>
                      <a href="https://nexux.pro/paquetes/pro" target="_blank" rel="noopener" style="display:inline-block;font-size:0.8rem;color:#4ECDC4;font-weight:600;text-decoration:none;margin-top:0.25rem">Actualizar a Pro para activar →</a>
                    </div>
                  </>
                ) : (
                  <>
