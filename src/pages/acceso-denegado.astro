---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Acceso denegado | Nexux Pro"
  description="No hemos podido validar tu acceso al portal de cliente."
  canonical="https://nexux.pro/acceso-denegado"
>
  <section class="error-page">
    <div class="container-nx">
      <div class="error-page-inner">
        <h1>Acceso no autorizado</h1>
        <p>
          No tienes permiso para ver esta pagina. Si crees que es un error, solicita un nuevo enlace de acceso.
        </p>
        <div class="error-actions">
          <a href="/" class="btn-primary">Volver al inicio -></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
