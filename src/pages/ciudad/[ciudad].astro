---
import CheckoutModal from '../../components/CheckoutModal.astro';
import CityHero from '../../components/CityHero.astro';
import Pricing from '../../components/Pricing.astro';
import { ciudades, type CiudadData } from '../../data/ciudades';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;
export function getStaticPaths() {
  return ciudades.map(ciudad => ({
    params: { ciudad: ciudad.slug },
    props: { ciudad },
  }));
}

const { ciudad } = Astro.props as { ciudad: CiudadData };
const canonical = `https://nexux.pro/ciudad/${ciudad.slug}`;
const title = `Asistente IA para peluquerias en ${ciudad.name} | Nexux Pro`;
const description = `Lara, la asistente IA para salones en ${ciudad.name}. Responde WhatsApp 24h, agenda citas y reduce no-shows. ${ciudad.keywords}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Nexux Pro - Asistente IA para peluquerias en ${ciudad.name}`,
  description,
  areaServed: {
    '@type': 'City',
    name: ciudad.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: ciudad.region },
  },
  provider: {
    '@type': 'Organization',
    name: 'Nexux Innovacion Digital S.L.',
    url: 'https://nexux.pro',
  },
  offers: [
    { '@type': 'Offer', name: 'Starter', price: '249', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Pro', price: '449', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Total', price: '749', priceCurrency: 'EUR' },
  ],
};
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)}></script>
  </Fragment>
  <CityHero ciudad={ciudad} />
  <Pricing />
  <CheckoutModal />
  <script>
    import '../../scripts/checkout.ts';
  </script>
</Layout>
