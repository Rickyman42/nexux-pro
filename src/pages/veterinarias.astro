---
// Página de aterrizaje para clínicas veterinarias. Existe por una razón concreta:
//
// Estamos escribiendo a veterinarias por WhatsApp. Cuando una nos busca, caía en una
// web que le hablaba de peluquerías y se caía la conversación. Esta página es el
// aterrizaje de ese mensaje, no una jugada de posiciones en Google (veterinaria tiene
// 10-100 búsquedas al mes: por SEO no compensaría).
//
// EL DATO ES REAL Y ES PEQUEÑO, Y SE DICE ASÍ. Leímos 921 reseñas de 20 clínicas
// veterinarias de Móstoles y solo 3 personas dicen que no les cogieron el teléfono.
// Publicar "el 67% de las veterinarias no contesta" habría sido mentira: ese número
// salía de contar como queja de contacto cualquier reseña que mencionara la palabra
// "cita", incluidas las de precio. Una página que exagera no la cita ninguna IA, y
// con razón.
//
// Las reseñas van SIN nombre de clínica y sin nombres de personas. Son públicas, pero
// señalar a un negocio concreto para venderle a otro es una guarrada.
//
// Si se vuelve a medir, se actualiza AQUÍ y en lib/bot-prompt-lara.js.
import Layout from '../layouts/Layout.astro';

const MEDIDO = '22 de septiembre de 2026';
const MUESTRA = {
  clinicas: 20,
  resenas: 921,
  malas: 423,
  deContacto: 3,
};

// Literales de reseñas públicas de Google, recortados y anonimizados.
const vocesReales = [
  {
    texto: 'La web está en construcción, el mail que aparece allí no funciona, y llevo ' +
           'intentando llamar dos días y no me es posible; ayer no lo cogían…',
    que: 'Tres puertas cerradas a la vez: web, correo y teléfono.',
  },
  {
    texto: 'Desde hace un tiempo, no te cogen el teléfono, no te contestan al WhatsApp ' +
           'hasta los tres días…',
    que: 'El WhatsApp existe. Lo que falla es cuándo se contesta.',
  },
  {
    texto: 'He llamado a primera hora de la mañana pidiendo por favor que atiendan a mi ' +
           'perro, que estaba vomitando…',
    que: 'La llamada que no puedes coger es la que más te importa.',
  },
];

const cuandoNo = [
  {
    caso: 'Si buscas un programa de gestión veterinaria',
    porque: 'Lara no lleva historia clínica, ni vacunas, ni recetas, ni inventario de ' +
            'fármacos. Para eso están Qvet, Clinicloud o Geswin, y lo hacen mejor que ' +
            'nosotros porque llevan años en ello. Nexux se ocupa del mensaje que entra, ' +
            'no de la ficha del animal.',
  },
  {
    caso: 'Si tu volumen de mensajes es bajo',
    porque: 'Si recibes tres o cuatro mensajes al día y los contestas sin agobio, esto no ' +
            'te va a cambiar la vida. Tiene sentido cuando el móvil suena mientras tienes ' +
            'un animal en la mesa.',
  },
  {
    caso: 'Si esperas que decida urgencias',
    porque: 'Lara no hace triaje. No dice si un vómito puede esperar a mañana ni si hay ' +
            'que venir corriendo. Esa decisión es del veterinario, siempre. Lo que hace es ' +
            'recoger el caso, dar cita y avisarte.',
  },
  {
    caso: 'Si quieres que suene como un veterinario',
    porque: 'No va a hablar de sintomatología ni de dosis. Contesta horarios, precios de ' +
            'consulta, qué llevar y cuándo venir. Si el cliente pregunta algo clínico, lo ' +
            'pasa a una persona.',
  },
];

const faq = [
  {
    q: '¿Lara puede diagnosticar o dar consejo clínico a los dueños?',
    a: 'No, y está puesto a propósito. Lara coge la cita, responde horarios y precios y ' +
       'avisa al veterinario. Cualquier pregunta sobre síntomas, medicación o urgencia la ' +
       'deriva a una persona. En salud animal el criterio es del veterinario.',
  },
  {
    q: '¿Sustituye al programa de gestión de mi clínica?',
    a: 'No. No lleva historia clínica, vacunas, recetas ni inventario. Convive con el ' +
       'programa que ya uses: Lara se ocupa del WhatsApp y de la agenda de citas.',
  },
  {
    q: '¿Cuántas clínicas veterinarias tienen de verdad problemas para contestar?',
    a: `Menos de las que se suele decir. Leímos ${MUESTRA.resenas} reseñas de ` +
       `${MUESTRA.clinicas} clínicas veterinarias de Móstoles el ${MEDIDO}: ` +
       `${MUESTRA.malas} eran de tres estrellas o menos, y en ${MUESTRA.deContacto} de ` +
       'ellas el cliente dice que no le cogieron el teléfono o que tardaron días en ' +
       'contestarle. Son pocas. Lo que no sabemos —y no vamos a fingir que sí— es cuánta ' +
       'gente se va a otra clínica sin dejar reseña.',
  },
  {
    q: '¿Qué pasa fuera del horario de la clínica?',
    a: 'Es cuando más sirve. Lara contesta a las once de la noche y deja la cita puesta ' +
       'para el día siguiente, en vez de que ese mensaje espere a que abráis.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: '29 € al mes la recepcionista, con todo el equipo incluido. Hay 7 días de prueba ' +
       'sin tarjeta.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': 'https://nexux.pro/veterinarias#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'WebPage',
      '@id': 'https://nexux.pro/veterinarias',
      url: 'https://nexux.pro/veterinarias',
      name: 'Recepcionista IA para clínicas veterinarias',
      description:
        'Quién contesta el WhatsApp de tu clínica veterinaria cuando estás con un animal ' +
        'en la mesa. Con datos medidos sobre reseñas reales y lo que Nexux no hace.',
      inLanguage: 'es',
      isPartOf: { '@id': 'https://nexux.pro/#website' },
      about: { '@type': 'Thing', name: 'Recepcionista IA para clínicas veterinarias' },
    },
  ],
};
---

<Layout
  title="Recepcionista IA para clínicas veterinarias | Nexux"
  description="¿Quién contesta el WhatsApp de tu clínica cuando estás con un animal en la mesa? Lara coge la cita por ti — y no opina del animal. Con el dato medido sobre 921 reseñas reales."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="max-w-4xl mx-auto px-6 py-16">

    <h1 class="text-4xl font-bold mb-6">
      ¿Quién contesta el WhatsApp de tu clínica cuando estás con un animal en la mesa?
    </h1>
    <p class="text-xl text-gray-600 mb-4">
      No es una pregunta retórica. Es el momento exacto en que se pierde una cita: tienes
      las manos ocupadas, el móvil suena, y el que escribe no espera.
    </p>
    <p class="text-sm text-gray-500 mb-12">
      Los datos de esta página salen de leer reseñas públicas de Google el {MEDIDO}.
      Abajo está la muestra exacta para que la puedas comprobar.
    </p>

    <!-- ── Lo que NO vamos a decirte ────────────────────────────────── -->
    <section class="mb-16 bg-gray-50 p-8 rounded-lg">
      <h2 class="text-2xl font-bold mb-4">Lo que no te vamos a decir</h2>
      <p class="text-gray-700 mb-4">
        Que las clínicas veterinarias no cogen el teléfono. <strong>No es verdad</strong>, y
        lo hemos medido: de <span class="tabular-nums">{MUESTRA.resenas}</span> reseñas de
        <span class="tabular-nums">{MUESTRA.clinicas}</span> clínicas veterinarias de
        Móstoles — <span class="tabular-nums">{MUESTRA.malas}</span> de ellas de tres
        estrellas o menos — solo <strong class="tabular-nums">{MUESTRA.deContacto}</strong>
        personas se quejan de que no las atendieran por teléfono o por WhatsApp.
      </p>
      <p class="text-gray-700">
        Son pocas. Lo decimos aunque juegue en nuestra contra, porque una página que
        exagera no vale para nada. Ahora bien: <strong>el que no consigue hablar contigo
        casi nunca escribe una reseña. Se va a otra clínica y ya está.</strong> Eso no lo
        hemos medido y no vamos a fingir que sí — pero es la razón por la que estas tres
        reseñas importan más de lo que parece.
      </p>
    </section>

    <!-- ── Las tres voces ───────────────────────────────────────────── -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-2">Las tres, enteras</h2>
      <p class="text-gray-600 mb-6">
        Reseñas públicas de Google, recortadas y sin el nombre de la clínica. No vamos a
        señalar a un negocio para venderle a otro.
      </p>
      <div class="space-y-6">
        {vocesReales.map((v) => (
          <figure class="border-l-4 border-blue-600 pl-6 py-2">
            <blockquote class="text-lg text-gray-800 italic">“{v.texto}”</blockquote>
            <figcaption class="text-sm text-gray-500 mt-2">{v.que}</figcaption>
          </figure>
        ))}
      </div>
      <p class="text-gray-700 mt-8">
        Fíjate en lo que tienen en común: <strong>ninguna dice que no haya canal.</strong>
        El teléfono está, el WhatsApp está, la web está. Lo que falla es
        <strong>cuándo</strong> se contesta — dos días, tres días, o a primera hora
        cuando ya no sirve.
      </p>
    </section>

    <!-- ── Qué hace Lara ────────────────────────────────────────────── -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-6">Qué hace exactamente</h2>
      <ul class="space-y-4 text-gray-700">
        <li class="flex gap-3">
          <span class="text-blue-600 font-bold">1.</span>
          <span>Contesta el WhatsApp de la clínica en segundos, a cualquier hora, también
          el domingo por la noche.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-600 font-bold">2.</span>
          <span>Pregunta lo que necesitas saber —qué animal, qué le pasa, desde cuándo— y
          <strong>deja la cita puesta</strong> en el calendario de la clínica.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-600 font-bold">3.</span>
          <span>Responde horarios, precio de consulta, dónde estáis y qué hay que traer.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-600 font-bold">4.</span>
          <span>Si la pregunta es clínica o suena a urgencia, <strong>para y te avisa.</strong>
          No opina del animal.</span>
        </li>
      </ul>
    </section>

    <!-- ── Cuándo NO ────────────────────────────────────────────────── -->
    <section class="mb-16 border border-gray-200 rounded-lg p-8">
      <h2 class="text-2xl font-bold mb-2">Cuándo Nexux no es tu opción</h2>
      <p class="text-gray-600 mb-6">
        Cuatro casos en los que te decimos que no. Preferimos eso a que lo pruebes y te
        lleves un chasco.
      </p>
      <dl class="space-y-6">
        {cuandoNo.map((c) => (
          <div>
            <dt class="font-semibold text-gray-900 mb-1">{c.caso}</dt>
            <dd class="text-gray-700">{c.porque}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ── FAQ ──────────────────────────────────────────────────────── -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-6">Preguntas frecuentes</h2>
      <dl class="space-y-6">
        {faq.map((f) => (
          <div class="border-b border-gray-200 pb-6">
            <dt class="font-semibold text-lg text-gray-900 mb-2">{f.q}</dt>
            <dd class="text-gray-700">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ── CTA ──────────────────────────────────────────────────────── -->
    <section class="bg-blue-600 text-white p-10 rounded-lg text-center">
      <h2 class="text-2xl font-bold mb-3">Pruébala antes de decidir</h2>
      <p class="mb-6 text-blue-50">
        Escríbele como si fueras un cliente tuyo con un perro con vómitos y mira qué
        contesta. Sin registrarte.
      </p>
      <a
        href="/demo?sector=veterinaria"
        class="inline-block bg-white text-blue-600 font-semibold px-8 py-4 rounded-lg hover:bg-blue-50"
      >
        Probar la demo para veterinarias
      </a>
      <p class="mt-6 text-sm text-blue-100">
        29 € al mes, todo el equipo incluido · 7 días de prueba sin tarjeta
      </p>
    </section>

  </main>
</Layout>
