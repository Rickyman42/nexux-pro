---
// Aterrizaje del WhatsApp que Ricardo manda a las clinicas veterinarias.
//
// Esto NO es un documento. Es lo que ve un veterinario en el movil cuando toca el
// enlace de un mensaje, con cinco segundos de paciencia y las manos a medias. La
// primera version era un muro de texto con el sistema de diseno equivocado: azul de
// Tailwind en una web verde menta, sin cabecera y sin un boton a la vista. Parecia
// de otra empresa.
//
// Lo que manda en el orden: primero se entiende QUE es (la conversacion de ejemplo
// se lee sola, sin leer), luego se prueba, y solo despues viene la letra. Lo honesto
// -la muestra, lo que NO hace, las preguntas- sigue entero en la pagina, pero
// plegado: asi lo encuentra quien lo busca y no aplasta al que solo quiere ver si
// esto es real.
//
// El dato es real y es pequeno, y se dice asi: 921 resenas de 20 clinicas de
// Mostoles, y solo 3 personas dicen que no les cogieron el telefono. Publicar "el
// 67% no contesta" habria sido mentira: contaba como queja de contacto cualquier
// resena con la palabra "cita", incluidas las de precio.
//
// Las resenas van SIN nombre de clinica ni de persona.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const MEDIDO = '22 de septiembre de 2026';
const MUESTRA = { clinicas: 20, resenas: 921, malas: 423, deContacto: 3 };

const conversacion = [
  { de: 'cliente', hora: '23:14', texto: 'Hola, mi perra lleva dos días vomitando. ¿Tenéis hueco mañana?' },
  { de: 'lara', hora: '23:14', texto: 'Buenas noches. Siento lo de tu perra. Mañana tengo a las 10:30 y a las 17:00 — ¿cuál te viene mejor?' },
  { de: 'cliente', hora: '23:15', texto: 'A las 10:30' },
  { de: 'lara', hora: '23:15', texto: 'Hecho. Te espero mañana a las 10:30. ¿Me dices su nombre y la edad, para dejarlo apuntado?' },
];

const loQueHace = [
  { n: '01', q: 'Contesta en segundos', d: 'A cualquier hora. También el domingo por la noche, que es cuando más mensajes se pierden.' },
  { n: '02', q: 'Deja la cita puesta', d: 'Pregunta qué animal, qué le pasa y desde cuándo, y lo escribe en el calendario de la clínica.' },
  { n: '03', q: 'Para cuando toca', d: 'Si la pregunta es clínica o suena a urgencia, no improvisa: te avisa. No opina del animal.' },
];

const noHace = [
  ['No lleva historia clínica', 'Ni vacunas, ni recetas, ni inventario. Para eso está tu programa de gestión, y lo hace mejor.'],
  ['No hace triaje', 'No decide si un vómito espera a mañana. Esa decisión es tuya, siempre.'],
  ['No habla de medicina', 'Horarios, precio de consulta, qué traer y cuándo venir. Lo demás lo pasa a una persona.'],
  ['No te sirve si tienes poco lío', 'Si contestas tus mensajes sin agobio, esto no te cambia la vida.'],
];

const faq = [
  {
    q: '¿Puede diagnosticar o dar consejo clínico a los dueños?',
    a: 'No, y está puesto a propósito. Coge la cita, responde horarios y precios y te avisa. ' +
       'Cualquier pregunta sobre síntomas, medicación o urgencia la deriva a una persona. ' +
       'En salud animal el criterio es del veterinario.',
  },
  {
    q: '¿Sustituye al programa de gestión de mi clínica?',
    a: 'No. No lleva historia clínica, vacunas, recetas ni inventario. Convive con el que ya ' +
       'uses: Lara se ocupa del WhatsApp y de la agenda de citas.',
  },
  {
    q: '¿Cuántas clínicas veterinarias tienen de verdad problemas para contestar?',
    a: `Menos de las que se suele decir. Leímos ${MUESTRA.resenas} reseñas de ${MUESTRA.clinicas} ` +
       `clínicas veterinarias de Móstoles el ${MEDIDO}: ${MUESTRA.malas} eran de tres estrellas ` +
       `o menos, y en ${MUESTRA.deContacto} de ellas el cliente dice que no le cogieron el ` +
       'teléfono o que tardaron días en contestarle. Son pocas. Lo que no sabemos —y no vamos ' +
       'a fingir que sí— es cuánta gente se va a otra clínica sin dejar reseña.',
  },
  {
    q: '¿Qué pasa fuera del horario de la clínica?',
    a: 'Es cuando más sirve. Contesta a las once de la noche y deja la cita puesta para el día ' +
       'siguiente, en vez de que ese mensaje espere a que abráis.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: '29 € al mes, con todo el equipo incluido. Siete días de prueba sin tarjeta.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': 'https://nexux.pro/veterinarias#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'WebPage',
      '@id': 'https://nexux.pro/veterinarias',
      url: 'https://nexux.pro/veterinarias',
      name: 'Recepcionista IA para clínicas veterinarias',
      description:
        'Lara contesta el WhatsApp de tu clínica veterinaria y deja la cita puesta, ' +
        'mientras tú estás con un animal en la mesa. No opina del animal.',
      inLanguage: 'es',
      isPartOf: { '@id': 'https://nexux.pro/#website' },
      about: { '@type': 'Thing', name: 'Recepcionista IA para clínicas veterinarias' },
    },
  ],
};
---

<Layout
  title="El WhatsApp de tu clínica veterinaria, contestado | Nexux"
  description="Lara coge la cita mientras tú estás con un animal en la mesa. Contesta a las once de la noche, deja la cita puesta y no opina del animal. 29 €/mes, 7 días de prueba."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Nav />

  <main>

    <!-- ── Lo primero que se ve en el móvil ─────────────────────────── -->
    <section class="hero">
      <div class="container-nx hero-in">
        <span class="eyebrow">Para clínicas veterinarias</span>
        <h1 class="h-display">El WhatsApp de tu clínica, <em>contestado.</em></h1>
        <p class="hero-sub">
          Lara coge la cita mientras tú estás con un animal en la mesa.
          También a las once de la noche.
        </p>
        <div class="acciones">
          <a class="btn-primary" href="/demo?sector=veterinaria">Ver cómo contesta →</a>
          <a class="btn-ghost" href="#que-no-hace">Qué no hace</a>
        </div>
        <p class="bajo-boton">29 € al mes · 7 días de prueba sin tarjeta</p>
      </div>
    </section>

    <!-- ── Se entiende sin leer ─────────────────────────────────────── -->
    <section class="section bg-deep">
      <div class="container-nx">
        <p class="eyebrow centrado">Un martes a las 23:14</p>
        <div class="chat">
          {conversacion.map((m) => (
            <div class={`burbuja ${m.de}`}>
              <p>{m.texto}</p>
              <span class="hora">{m.hora}</span>
            </div>
          ))}
          <div class="confirmado">Cita del jueves 10:30 puesta en el calendario</div>
        </div>
        <p class="pie-chat">Ese mensaje, sin Lara, lo lees mañana a las nueve.</p>
      </div>
    </section>

    <!-- ── Tres cosas ───────────────────────────────────────────────── -->
    <section class="section">
      <div class="container-nx">
        <div class="tres">
          {loQueHace.map((c) => (
            <div class="tarjeta">
              <span class="num">{c.n}</span>
              <h3>{c.q}</h3>
              <p>{c.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Una sola voz real ────────────────────────────────────────── -->
    <section class="section bg-deep">
      <div class="container-nx estrecho">
        <blockquote class="cita">
          “Desde hace un tiempo, no te cogen el teléfono, no te contestan al WhatsApp
          hasta los tres días…”
        </blockquote>
        <p class="fuente">
          Reseña pública de Google sobre una clínica veterinaria de Móstoles, leída el
          {' '}{MEDIDO}. Sin el nombre de la clínica: no señalamos a un negocio para
          venderle a otro.
        </p>
      </div>
    </section>

    <!-- ── Qué NO hace ──────────────────────────────────────────────── -->
    <section class="section" id="que-no-hace">
      <div class="container-nx estrecho">
        <h2 class="h-section">Lo que no hace</h2>
        <p class="intro">Te lo decimos antes, no después de que lo pruebes.</p>
        <dl class="nohace">
          {noHace.map(([t, d]) => (
            <div>
              <dt>{t}</dt>
              <dd>{d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ── Cerrar ───────────────────────────────────────────────────── -->
    <section class="section cierre">
      <div class="container-nx estrecho centrado">
        <h2 class="h-section">Escríbele como si fueras un cliente tuyo</h2>
        <p class="intro">
          Un perro con vómitos, un domingo por la noche. Mira qué contesta.
          Sin registrarte.
        </p>
        <a class="btn-primary grande" href="/demo?sector=veterinaria">
          Probar la demo para veterinarias →
        </a>
        <p class="bajo-boton">29 € al mes, todo el equipo incluido · 7 días de prueba sin tarjeta</p>
      </div>
    </section>

    <!-- ── La letra, para quien la busque ───────────────────────────── -->
    <section class="section letra">
      <div class="container-nx estrecho">
        <h2 class="h-section">Preguntas</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}

        <details class="muestra">
          <summary>De dónde sale el dato de esta página</summary>
          <p>
            El {MEDIDO} leímos las reseñas de {MUESTRA.clinicas} clínicas veterinarias de
            Móstoles donde conseguimos ordenarlas por las peores:
            {' '}<strong>{MUESTRA.resenas}</strong> reseñas distintas, de las cuales
            {' '}<strong>{MUESTRA.malas}</strong> son de tres estrellas o menos. En
            {' '}<strong>{MUESTRA.deContacto}</strong> de esas {MUESTRA.clinicas} clínicas
            un cliente dice que no le cogieron el teléfono o que tardaron días en
            contestarle.
          </p>
          <p>
            Son pocas, y lo decimos aunque juegue en nuestra contra: no vamos a escribir
            que las clínicas veterinarias no cogen el teléfono, porque lo hemos medido y
            no es verdad. Lo que no sabemos es cuánta gente no consigue hablar contigo y
            se va a otra clínica sin escribir nada. Eso no lo hemos medido y no vamos a
            fingir que sí.
          </p>
        </details>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .hero { padding: 4.5rem 0 3.5rem; }
  @media (min-width: 768px) { .hero { padding: 7rem 0 5rem; } }
  .hero-in { max-width: 760px; }
  .hero h1 { margin: 1rem 0 1.25rem; }
  .hero-sub {
    font-size: 1.15rem;
    color: var(--nx-ink-muted);
    max-width: 34ch;
    line-height: 1.55;
  }
  @media (min-width: 768px) { .hero-sub { font-size: 1.3rem; max-width: 46ch; } }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .bajo-boton {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--nx-ink-faint);
  }
  .btn-primary.grande { padding: 1.1rem 2rem; font-size: 1.05rem; }

  .estrecho { max-width: 640px; }
  .centrado { text-align: center; }

  /* ── conversación ─────────────────────────────────────────────── */
  .chat {
    max-width: 440px;
    margin: 1.5rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .burbuja {
    padding: 0.8rem 1rem 1.4rem;
    border-radius: 1rem;
    position: relative;
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 85%;
  }
  .burbuja.cliente {
    background: var(--nx-surface);
    border: 1px solid var(--nx-line);
    border-bottom-left-radius: 0.25rem;
    align-self: flex-start;
  }
  .burbuja.lara {
    background: var(--nx-magnet);
    color: #fff;
    border-bottom-right-radius: 0.25rem;
    align-self: flex-end;
  }
  .burbuja .hora {
    position: absolute;
    right: 0.9rem;
    bottom: 0.5rem;
    font-size: 0.68rem;
    opacity: 0.65;
    font-family: var(--nx-font-mono);
  }
  .confirmado {
    align-self: center;
    margin-top: 0.5rem;
    background: var(--nx-magnet-halo);
    border: 1px solid var(--nx-magnet);
    color: var(--nx-magnet-deep);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .pie-chat {
    text-align: center;
    margin-top: 2rem;
    color: var(--nx-ink-muted);
    font-size: 1.05rem;
  }

  /* ── tres tarjetas ────────────────────────────────────────────── */
  .tres { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .tres { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .tarjeta {
    border-top: 2px solid var(--nx-magnet);
    padding-top: 1.1rem;
  }
  .tarjeta .num {
    font-family: var(--nx-font-mono);
    font-size: 0.7rem;
    color: var(--nx-magnet);
    letter-spacing: 0.15em;
  }
  .tarjeta h3 {
    font-family: var(--nx-font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    margin: 0.35rem 0 0.5rem;
  }
  .tarjeta p { color: var(--nx-ink-muted); font-size: 0.95rem; }

  /* ── cita ─────────────────────────────────────────────────────── */
  .cita {
    font-family: var(--nx-font-serif);
    font-size: 1.5rem;
    line-height: 1.4;
    border-left: 3px solid var(--nx-magnet);
    padding-left: 1.25rem;
  }
  @media (min-width: 768px) { .cita { font-size: 1.9rem; } }
  .fuente {
    margin-top: 1.25rem;
    padding-left: 1.25rem;
    font-size: 0.85rem;
    color: var(--nx-ink-faint);
    line-height: 1.5;
  }

  /* ── qué no hace ──────────────────────────────────────────────── */
  .intro { color: var(--nx-ink-muted); margin: 0.75rem 0 2rem; }
  .nohace { display: grid; gap: 1.4rem; }
  .nohace dt {
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .nohace dt::before {
    content: '—';
    color: var(--nx-magnet);
    margin-right: 0.5rem;
  }
  .nohace dd { color: var(--nx-ink-muted); font-size: 0.95rem; padding-left: 1.4rem; }

  .cierre { background: var(--nx-deep); }
  .cierre .intro { margin-bottom: 2rem; }

  /* ── la letra ─────────────────────────────────────────────────── */
  .letra details {
    border-bottom: 1px solid var(--nx-line);
    padding: 1.1rem 0;
  }
  .letra summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .letra summary::-webkit-details-marker { display: none; }
  .letra summary::after { content: '+'; color: var(--nx-magnet); font-size: 1.3rem; line-height: 1; }
  .letra details[open] summary::after { content: '–'; }
  .letra details p {
    margin-top: 0.8rem;
    color: var(--nx-ink-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .letra details p + p { margin-top: 0.8rem; }
  .letra .muestra { border-bottom: none; }
</style>
