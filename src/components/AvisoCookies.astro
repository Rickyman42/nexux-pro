---
// Aviso de cookies. Vivia incrustado dentro de Layout.astro, asi que /demo —que no usa esa
// plantilla— no tenia ninguno: quien entraba directo por el QR de las octavillas no podia
// aceptar, y por eso Meta y GA4 no se activaban nunca para ese trafico.
// (auditoria 3-sept-2026, area E)
---

<div id="nx-cookie-banner" class="cookie-banner" role="dialog" aria-label="Consentimiento de cookies" hidden>
  <div class="cookie-text">
    <strong>🍪 Cookies de analítica y publicidad.</strong><br/>
    Sólo si las aceptas: GA4 y Meta. <a href="/privacidad" class="cookie-mas">Más info</a>
  </div>
  <div class="cookie-actions">
    <button id="cookie-reject" class="btn-ghost cookie-btn">Sólo necesarias</button>
    <button id="cookie-accept" class="btn-primary cookie-btn">Aceptar todo</button>
  </div>
</div>

<script is:inline>
  (function() {
    var banner = document.getElementById('nx-cookie-banner');
    var stored = localStorage.getItem('nx_cookie_consent');

    // Umami llega con retraso (el script va con defer). Sin esperarlo, los
    // avisos que se enseñan nada mas cargar no se contarian nunca, y el
    // porcentaje saldria inflado: solo quedarian los de la gente que tarda.
    function medir(evento, datos) {
      var intentos = 0;
      (function reintenta() {
        if (window.umami && typeof window.umami.track === 'function') {
          window.umami.track(evento, datos || {});
          return;
        }
        if (intentos++ < 40) window.setTimeout(reintenta, 500);
      })();
    }

    if (!stored) {
      banner.removeAttribute('hidden');
      // Sin esto no hay porcentaje posible: se verian respuestas sueltas sin
      // saber sobre cuanta gente. Y los que no contestan nada --que son la
      // mayoria-- no dejarian ni rastro, cuando son justo los que mas cuentan:
      // no contestar es que no, y el pixel del anuncio no se carga.
      medir('cookies_mostrado', { pagina: location.pathname });
    }

    document.getElementById('cookie-accept').addEventListener('click', function() {
      localStorage.setItem('nx_cookie_consent', 'accepted');
      document.dispatchEvent(new CustomEvent('nx:consent-granted'));
      banner.setAttribute('hidden', '');
      medir('cookies_respondido', { respuesta: 'acepta', pagina: location.pathname });
    });
    document.getElementById('cookie-reject').addEventListener('click', function() {
      localStorage.setItem('nx_cookie_consent', 'rejected');
      banner.setAttribute('hidden', '');
      medir('cookies_respondido', { respuesta: 'solo_necesarias', pagina: location.pathname });
    });
  })();
</script>
