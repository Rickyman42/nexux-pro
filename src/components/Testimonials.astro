---
const testimonials = [
  {
    name: 'Carmen Lopez',
    role: 'Peluqueria Carmen, Madrid',
    avatar: 'CL',
    rating: 5,
    text: 'Antes perdia 3-4 citas al dia porque no podia coger el telefono mientras trabajaba. Ahora Lara lo gestiona todo y yo solo aparezco. El primer mes recupere lo que costo el plan.',
  },
  {
    name: 'Silvia Martinez',
    role: 'Centro de estetica Silvia, Barcelona',
    avatar: 'SM',
    rating: 5,
    text: 'Mis clientas flipan cuando les responde a las 11 de la noche. Pensaban que era yo. El calendario lleno solo me da tranquilidad que no tenia antes.',
  },
  {
    name: 'Ana Garcia',
    role: 'Peluqueria Ana Style, Valencia',
    avatar: 'AG',
    rating: 5,
    text: 'Los no-shows bajaron un 60% con los recordatorios automaticos. Eso solo ya vale lo que cuesta. Y el resumen diario me ayuda a planificar mejor la semana.',
  },
  {
    name: 'Rosa Fernandez',
    role: 'Salon Rosa, Sevilla',
    avatar: 'RF',
    rating: 5,
    text: 'Tengo 2 empleadas y antes la agenda era un caos. Ahora cada una ve su calendario y Lara asigna correctamente. Sin WhatsApps internos, sin confusiones.',
  },
  {
    name: 'Laura Jimenez',
    role: 'Beauty Studio Laura, Bilbao',
    avatar: 'LJ',
    rating: 5,
    text: 'Empece con el plan Starter pensando que era demasiado para mi salon pequeno. Al mes subi a Pro. Las clientas nuevas que llegan solas del SEO son un bonus que no esperaba.',
  },
  {
    name: 'Marta Ruiz',
    role: 'Estetica Marta, Zaragoza',
    avatar: 'MR',
    rating: 5,
    text: 'Contrate por los recordatorios. Me quede por todo lo demas. La configuracion fue en un dia, Ricardo nos ayudo con todo y ya no necesito tocar nada.',
  },
];
---
<section class="testimonials">
  <div class="container-nx">
    <div class="testimonials-header">
      <div class="eyebrow">Lo que dicen nuestras clientas</div>
      <h2 class="h-section">
        Resultados reales, <em>no promesas</em>
      </h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map(({ name, role, avatar, rating, text }) => (
        <article class="testimonial-card">
          <div class="testimonial-stars" aria-label={`${rating} de 5 estrellas`}>
            {'★'.repeat(rating)}
          </div>

          <blockquote class="testimonial-text">{text}</blockquote>

          <div class="testimonial-author">
            <div class="testimonial-avatar" aria-hidden="true">{avatar}</div>
            <div>
              <strong>{name}</strong>
              <span>{role}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials { padding: 7rem 0; }
  @media (max-width: 768px) { .testimonials { padding: 4rem 0; } }

  .testimonials-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .testimonials-header .eyebrow { margin-bottom: 1rem; }

  .testimonials-header .h-section {
    max-width: 600px;
    margin: 0 auto;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 700px) {
    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .testimonials-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .testimonial-card {
    background: var(--nx-deep);
    border: 1px solid var(--nx-line);
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color 0.3s var(--nx-ease), transform 0.3s var(--nx-ease);
  }

  .testimonial-card:hover {
    border-color: rgba(78, 205, 196, 0.3);
    transform: translateY(-4px);
  }

  .testimonial-stars {
    color: var(--nx-magnet);
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .testimonial-text {
    color: var(--nx-ink-muted);
    font-size: 0.95rem;
    line-height: 1.75;
    flex: 1;
    margin: 0;
    font-style: italic;
  }

  .testimonial-text::before { content: '"'; }
  .testimonial-text::after { content: '"'; }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .testimonial-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--nx-magnet-halo);
    border: 1px solid rgba(78, 205, 196, 0.3);
    color: var(--nx-magnet);
    font-size: 0.8rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .testimonial-author strong {
    display: block;
    color: var(--nx-ink);
    font-size: 0.9rem;
  }

  .testimonial-author span {
    color: var(--nx-ink-muted);
    font-size: 0.78rem;
  }
</style>
