---
---
<section class="hero">
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <div class="container-nx hero-grid">
    <div class="hero-copy">
      <div class="eyebrow hero-eyebrow">
        <span class="dot"></span> Para peluquerías y centros de estética
      </div>

      <h1 class="h-display hero-title">
        Tu agenda <em>se llena sola</em><br/>
        mientras tú trabajas.
      </h1>

      <p class="hero-sub">
        Lara es la asistente de IA que responde llamadas, mensajes de Instagram y
        WhatsApp, agenda citas y cuida a tus clientas las <strong>24 horas del día</strong>.
        Tú no levantas el teléfono. Ni una vez.
      </p>

      <div class="hero-ctas">
        <a href="#hablar" class="btn-primary" data-track="hero_cta_primary">
          Habla con Lara ahora
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="#calculadora" class="btn-ghost" data-track="hero_cta_secondary">
          Calcular cuánto pierdo
        </a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <div class="trust-num">24<span>h</span></div>
          <div class="trust-label">Sin descanso</div>
        </div>
        <div class="trust-sep"></div>
        <div class="trust-item">
          <div class="trust-num">&lt;5<span>seg</span></div>
          <div class="trust-label">Respuesta media</div>
        </div>
        <div class="trust-sep"></div>
        <div class="trust-item">
          <div class="trust-num">0<span>€</span></div>
          <div class="trust-label">De compromiso</div>
        </div>
      </div>
    </div>

    <div class="hero-chat-wrap" aria-label="Demostración: Lara agendando una cita real">
      <div class="phone">
        <div class="phone-screen">
          <div class="chat-header">
            <div class="chat-avatar">L</div>
            <div class="chat-meta">
              <div class="chat-name">Lara · Peluquería</div>
              <div class="chat-status"><span class="online-dot"></span> en línea</div>
            </div>
            <div class="chat-actions" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
          </div>
          <div class="chat-body" id="chat-stage"></div>
          <div class="chat-input" aria-hidden="true">
            <span>Escribe un mensaje...</span>
          </div>
        </div>
        <div class="phone-notch" aria-hidden="true"></div>
      </div>

      <div class="float-tag float-tag-1">
        <span class="tag-emoji">📅</span>
        <div>
          <div class="tag-title">Cita agendada</div>
          <div class="tag-time">hace 3 segundos</div>
        </div>
      </div>
      <div class="float-tag float-tag-2">
        <span class="tag-emoji">💚</span>
        <div>
          <div class="tag-title">+€42 facturados</div>
          <div class="tag-time">sin coger el teléfono</div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-fadeline" aria-hidden="true"></div>
</section>

<script is:inline>
  (function() {
    const messages = [
      { who: 'user',  text: 'Hola, ¿tenéis hueco el sábado para corte y color?', delay: 600 },
      { who: 'bot',   text: '¡Hola! 😊 Claro que sí. ¿A qué hora te viene mejor, por la mañana o por la tarde?', delay: 1400, typing: 1100 },
      { who: 'user',  text: 'Por la mañana mejor', delay: 1600 },
      { who: 'bot',   text: 'Tengo libre a las 10:00 y a las 11:30. ¿Cuál prefieres?', delay: 1500, typing: 1000 },
      { who: 'user',  text: 'Las 10 perfecto', delay: 1300 },
      { who: 'bot',   text: '✨ Reservada cita para el sábado a las 10:00 con María.<br/>Corte + color con tu tinte habitual. ¡Hasta el sábado!', delay: 1400, typing: 1200 },
    ];

    function el(tag, cls, html) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (html !== undefined) e.innerHTML = html;
      return e;
    }

    async function playSequence() {
      const stage = document.getElementById('chat-stage');
      if (!stage) return;
      stage.innerHTML = '';

      for (const m of messages) {
        await new Promise(r => setTimeout(r, m.delay));

        if (m.who === 'bot' && m.typing) {
          const typing = el('div', 'msg msg-bot msg-typing',
            '<span></span><span></span><span></span>');
          stage.appendChild(typing);
          stage.scrollTop = stage.scrollHeight;
          await new Promise(r => setTimeout(r, m.typing));
          typing.remove();
        }

        const bubble = el('div', 'msg msg-' + m.who, m.text);
        bubble.style.animation = 'fade-in-up 0.4s var(--nx-ease) forwards';
        stage.appendChild(bubble);
        stage.scrollTop = stage.scrollHeight;
      }

      await new Promise(r => setTimeout(r, 4000));
      playSequence();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', playSequence);
    } else {
      playSequence();
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    padding: 9rem 0 6rem;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  @media (max-width: 768px) {
    .hero { padding: 7rem 0 4rem; min-height: auto; }
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }
  .orb-1 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(78,205,196,0.18) 0%, transparent 70%);
    top: -100px; left: -150px;
  }
  .orb-2 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(232,165,152,0.10) 0%, transparent 70%);
    bottom: -200px; right: -200px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: 5rem; }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    padding: 0.4rem 0.85rem;
    background: var(--nx-magnet-halo);
    border: 1px solid rgba(78, 205, 196, 0.18);
    border-radius: 999px;
  }
  .hero-eyebrow .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-magnet);
    animation: pulse-glow 2s infinite;
  }

  .hero-title { margin-bottom: 1.75rem; }
  .hero-sub {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--nx-ink-muted);
    max-width: 540px;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }
  .hero-sub strong { color: var(--nx-ink); font-weight: 600; }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--nx-line);
    flex-wrap: wrap;
  }
  .trust-item .trust-num {
    font-family: var(--nx-font-serif);
    font-size: 1.65rem;
    line-height: 1;
    color: var(--nx-magnet);
  }
  .trust-item .trust-num span {
    font-size: 0.95rem;
    color: var(--nx-ink-muted);
    margin-left: 0.15rem;
  }
  .trust-item .trust-label {
    font-size: 0.78rem;
    color: var(--nx-ink-muted);
    margin-top: 0.35rem;
    letter-spacing: 0.02em;
  }
  .trust-sep {
    width: 1px; height: 32px;
    background: var(--nx-line);
  }

  .hero-chat-wrap {
    position: relative;
    perspective: 1200px;
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }

  .phone {
    width: 320px;
    height: 580px;
    background: linear-gradient(155deg, #1c2029, #0f1218);
    border-radius: 38px;
    padding: 12px;
    box-shadow:
      0 60px 80px -30px rgba(0,0,0,0.7),
      0 0 0 1px rgba(78, 205, 196, 0.18),
      inset 0 0 0 1px rgba(255,255,255,0.05);
    position: relative;
    transform: rotate(-3deg);
    animation: phone-float 6s ease-in-out infinite;
  }
  @keyframes phone-float {
    0%, 100% { transform: rotate(-3deg) translateY(0); }
    50% { transform: rotate(-3deg) translateY(-12px); }
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: #0d1015;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .phone-notch {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 22px;
    background: #000;
    border-radius: 999px;
    z-index: 2;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 2.6rem 1rem 0.8rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    background: linear-gradient(180deg, rgba(78,205,196,0.05), transparent);
  }
  .chat-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    display: grid;
    place-items: center;
    font-family: var(--nx-font-serif);
    font-style: italic;
    font-size: 1.15rem;
    font-weight: 500;
  }
  .chat-meta { flex: 1; min-width: 0; }
  .chat-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--nx-ink);
    line-height: 1.2;
  }
  .chat-status {
    font-size: 0.7rem;
    color: var(--nx-ink-muted);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }
  .online-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-success);
    box-shadow: 0 0 6px var(--nx-success);
  }
  .chat-actions { color: var(--nx-ink-muted); }

  .chat-body {
    flex: 1;
    padding: 1rem 0.85rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    scroll-behavior: smooth;
  }
  .chat-body::-webkit-scrollbar { width: 0; }

  .msg {
    padding: 0.55rem 0.85rem;
    border-radius: 16px;
    font-size: 0.82rem;
    line-height: 1.45;
    max-width: 80%;
    word-wrap: break-word;
    opacity: 0;
    transform: translateY(8px);
  }
  .msg-user {
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    font-weight: 500;
  }
  .msg-bot {
    background: rgba(255,255,255,0.06);
    color: var(--nx-ink);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .msg-typing {
    background: rgba(255,255,255,0.06);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    padding: 0.7rem 0.95rem;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    opacity: 1;
    transform: translateY(0);
  }
  .msg-typing span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-ink-muted);
    animation: typing-bounce 1.2s infinite;
  }
  .msg-typing span:nth-child(2) { animation-delay: 0.2s; }
  .msg-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .chat-input {
    padding: 0.7rem 0.95rem;
    border-top: 1px solid rgba(255,255,255,0.04);
    color: var(--nx-ink-faint);
    font-size: 0.78rem;
  }

  .float-tag {
    position: absolute;
    background: var(--nx-deep);
    border: 1px solid var(--nx-line-hover);
    border-radius: 14px;
    padding: 0.65rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    backdrop-filter: blur(20px);
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.5);
    animation: float-bob 4s ease-in-out infinite;
  }
  .float-tag-1 { top: 12%; right: -8%; animation-delay: 0s; }
  .float-tag-2 { bottom: 14%; left: -10%; animation-delay: 2s; }
  @keyframes float-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .tag-emoji { font-size: 1.2rem; }
  .tag-title {
    font-size: 0.78rem;
    color: var(--nx-ink);
    font-weight: 600;
    line-height: 1.2;
  }
  .tag-time {
    font-size: 0.68rem;
    color: var(--nx-ink-muted);
    margin-top: 0.1rem;
  }

  .hero-fadeline {
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--nx-magnet), transparent);
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .phone { width: 280px; height: 510px; }
    .float-tag-1 { right: -4%; top: 8%; }
    .float-tag-2 { left: -4%; bottom: 12%; }
    .hero-trust { gap: 0.9rem; }
    .trust-sep { display: none; }
  }
</style>
