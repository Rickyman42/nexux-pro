---
import { LAUNCH_PRICE, REGULAR_PRICE, EQUIPO_PRICE } from '../data/plans';

const incluye = [
  'Contesta por WhatsApp, Telegram o tu web las 24 horas',
  'Mira tu calendario, propone hueco y deja la cita puesta',
  'Recuerda la cita al cliente 24 h y 1 h antes',
  'Te manda un resumen cada tarde',
  'Hasta 1.000 conversaciones al mes',
  'Sin comisiones y sin pagar por empleado',
];

// Agenda de ejemplo: un martes cualquiera, lleno.
const agenda = [
  { hora: '09:00', nombre: 'Ana G.', servicio: 'Corte + color', via: 'wa' },
  { hora: '10:30', nombre: 'Marta R.', servicio: 'Tinte', via: 'tg' },
  { hora: '11:45', nombre: 'Lucía P.', servicio: 'Mechas', via: 'wa' },
  { hora: '13:00', nombre: 'Carmen S.', servicio: 'Corte', via: 'web' },
  { hora: '16:15', nombre: 'Pablo M.', servicio: 'Barba', via: 'wa' },
  { hora: '17:30', nombre: 'Sara L.', servicio: 'Peinado', via: 'tg' },
  { hora: '18:45', nombre: 'Nuria C.', servicio: 'Corte + color', via: 'wa' },
];

const etiquetaCanal = { wa: 'WhatsApp', tg: 'Telegram', web: 'Web' };
---
<section class="pricing" id="paquetes">
  <div class="container-nx">
    <div class="pricing-header">
      <div class="eyebrow">Precio</div>
      <h2 class="h-section">
        Las apps te enseñan la agenda.
        <em>Lara te ayuda a llenarla.</em>
      </h2>
      <p class="pricing-sub">
        Una recepcionista IA por 29 € al mes para responder mensajes y gestionar citas por WhatsApp, Telegram y web.
        Sin comisión por cita. Sin permanencia.
      </p>
    </div>

    <div class="offer">
      <div class="offer-deal">
        <div class="offer-badge">Precio de lanzamiento</div>

        <div class="offer-price">
          <span class="offer-num">{LAUNCH_PRICE}</span>
          <span class="offer-unit">€<span>/mes</span></span>
        </div>
        <p class="offer-price-note">
          Todo incluido. Subirá a {REGULAR_PRICE} €, pero si entras ahora te quedas
          en {LAUNCH_PRICE} € mientras sigas de alta.
        </p>

        <ul class="offer-list">
          {incluye.map(f => (
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>

        <a href="/paquetes/recepcionista" class="btn-primary offer-cta" data-track="pricing_recepcionista">
          Empezar por {LAUNCH_PRICE} € al mes
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>

        <div class="offer-trust">
          <span>Sin permanencia</span>
          <span class="dot-sep"></span>
          <span>30 días de garantía</span>
          <span class="dot-sep"></span>
          <span>Listo en 5 minutos</span>
        </div>

        <p class="plan-equipo-link">
          ¿Atendéis varias personas y cada una necesita ver <em>su</em> agenda?
          <a href="/paquetes/equipo" data-track="pricing_equipo">
            Nexux Recepcionista Equipo, {EQUIPO_PRICE} € al mes →
          </a>
        </p>
      </div>

      <div class="offer-agenda" aria-label="Ejemplo ilustrativo de una agenda con citas reservadas por el asistente">
        <div class="agenda-top">
          <div>
            <div class="agenda-day">Martes</div>
            <div class="agenda-sub">Ejemplo de citas gestionadas</div>
          </div>
          <div class="agenda-live"><span class="live-dot"></span> ejemplo</div>
        </div>

        <div class="agenda-list">
          {agenda.map(c => (
            <div class="agenda-row">
              <span class="agenda-hora">{c.hora}</span>
              <span class="agenda-info">
                <span class="agenda-nombre">{c.nombre}</span>
                <span class="agenda-serv">{c.servicio}</span>
              </span>
              <span class={'agenda-via via-' + c.via}>{etiquetaCanal[c.via]}</span>
            </div>
          ))}
        </div>

        <div class="agenda-foot">
          Así puede verse una agenda gestionada por Lara
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing { padding: 6rem 0; }
  .pricing-header { text-align: center; max-width: 42rem; margin: 0 auto 3.5rem; }
  .pricing-sub {
    color: var(--nx-ink-muted);
    margin-top: 1rem;
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .offer {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 62rem;
    margin: 0 auto;
    border: 1px solid var(--nx-line-hover);
    border-radius: 28px;
    overflow: hidden;
    background: var(--nx-surface);
    box-shadow: 0 30px 70px -40px rgba(20, 22, 26, 0.3);
  }

  .offer-deal { padding: 2.5rem 2.25rem; }
  .offer-badge {
    display: inline-block;
    font-family: var(--nx-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nx-magnet-deep);
    background: var(--nx-magnet-halo);
    border: 1px solid rgba(78, 205, 196, 0.25);
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }
  .offer-price { display: flex; align-items: baseline; gap: 0.4rem; }
  .offer-num {
    font-family: var(--nx-font-serif);
    font-size: 4.5rem;
    line-height: 0.9;
    color: var(--nx-ink);
  }
  .offer-unit { font-size: 1.3rem; color: var(--nx-ink-muted); }
  .offer-unit span { font-size: 0.95rem; }
  .offer-price-note {
    color: var(--nx-ink-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    margin-top: 0.85rem;
    max-width: 30rem;
  }

  .offer-list {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    margin: 1.75rem 0;
    padding: 1.75rem 0 0;
    border-top: 1px solid var(--nx-line);
  }
  .offer-list li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .offer-list svg { color: var(--nx-magnet-deep); flex-shrink: 0; margin-top: 0.2rem; }

  .offer-cta { width: 100%; justify-content: center; }
  .offer-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--nx-ink-muted);
  }
  .dot-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--nx-ink-faint); }

  .offer-agenda {
    padding: 2.25rem 2rem;
    background: var(--nx-deep);
    border-top: 1px solid var(--nx-line-hover);
    display: flex;
    flex-direction: column;
  }
  .agenda-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--nx-line);
    margin-bottom: 0.35rem;
  }
  .agenda-day {
    font-family: var(--nx-font-serif);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--nx-ink);
  }
  .agenda-sub { font-size: 0.8rem; color: var(--nx-ink-muted); margin-top: 0.15rem; }
  .agenda-live {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--nx-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nx-magnet-deep);
    white-space: nowrap;
  }
  .live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--nx-magnet);
    box-shadow: 0 0 0 3px rgba(78, 205, 196, 0.18);
    animation: live-pulse 2s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .agenda-list { display: flex; flex-direction: column; }
  .agenda-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--nx-line);
  }
  .agenda-row:last-child { border-bottom: none; }
  .agenda-hora {
    font-family: var(--nx-font-mono);
    font-size: 0.78rem;
    color: var(--nx-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .agenda-info { display: flex; flex-direction: column; min-width: 0; }
  .agenda-nombre { font-size: 0.9rem; font-weight: 500; color: var(--nx-ink); }
  .agenda-serv { font-size: 0.76rem; color: var(--nx-ink-muted); }
  .agenda-via {
    font-family: var(--nx-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .via-wa { background: rgba(37, 211, 102, 0.12); color: #128C4A; }
  .via-tg { background: rgba(42, 139, 132, 0.12); color: var(--nx-magnet-deep); }
  .via-web { background: rgba(20, 22, 26, 0.07); color: var(--nx-ink-muted); }

  .agenda-foot {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.86rem;
    color: var(--nx-ink-muted);
    text-align: center;
  }
  .agenda-foot strong { color: var(--nx-magnet-deep); }

  @media (min-width: 900px) {
    .offer { grid-template-columns: 1.05fr 0.95fr; }
    .offer-agenda { border-top: none; border-left: 1px solid var(--nx-line-hover); }
    .offer-deal { padding: 3rem 2.75rem; }
  }

  .plan-equipo-link {
    margin: 18px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--nx-text-soft, #8B92A8);
    text-align: center;
  }
  .plan-equipo-link a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .plan-equipo-link a:hover { color: var(--nx-accent, #2A9D97); }
</style>
