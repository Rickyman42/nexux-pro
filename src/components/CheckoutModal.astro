<div id="checkout-modal" class="checkout-overlay" aria-modal="true" role="dialog" hidden>
  <div class="checkout-panel">
    <div class="checkout-header">
      <span id="checkout-plan-label" class="eyebrow">Plan</span>
      <button id="checkout-close" class="checkout-close" type="button" aria-label="Cerrar">✕</button>
    </div>

    <div id="checkout-loading" class="checkout-loading">
      <div class="checkout-spinner" aria-hidden="true"></div>
      <p>Preparando el pago seguro…</p>
    </div>

    <div id="checkout-error" class="checkout-error" hidden>
      <p>No hemos podido cargar el pago. <button type="button" class="checkout-error-link" data-open-lara>Pregúntale a Lara</button> y te echa una mano.</p>
    </div>

    <form id="checkout-datos" class="checkout-datos" hidden>
      <label for="checkout-negocio">¿Cómo se llama tu negocio?</label>
      <input
        id="checkout-negocio"
        name="negocio"
        type="text"
        required
        maxlength="80"
        autocomplete="organization"
        placeholder="Ej: Peluquería Marta"
        enterkeyhint="go"
      />
      <p class="checkout-datos-ayuda">Es el nombre con el que Lara saludará a tus clientes.</p>
      <button type="submit" class="checkout-datos-boton">Continuar al pago</button>
    </form>

    <div id="stripe-checkout-mount"></div>
  </div>
</div>

