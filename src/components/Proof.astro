---
---
<section class="proof">
  <div class="container-nx">
    <div class="proof-grid">
      <div class="proof-left">
        <div class="eyebrow">Prueba real</div>
        <h2 class="h-section">
          No vendemos humo. <em>Lo usamos nosotros.</em>
        </h2>
        <p class="proof-text">
          Nexux nació como nuestra propia app — y todo lo que vamos a hacer en tu salón,
          ya lo hacemos en casa cada día. Estos son números reales del último mes.
        </p>
        <a href="#hablar" class="btn-ghost proof-cta" data-track="proof_cta">
          Quiero esto para mi salón
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="proof-right">
        <div class="metric-card">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 14l3-3 3 3 5-5"/></svg>
          </div>
          <div class="metric-num">€1,82</div>
          <div class="metric-label">Coste por lead en Meta Ads</div>
          <div class="metric-foot">vs €12-18 media del sector</div>
        </div>

        <div class="metric-card">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div class="metric-num">&lt; 4s</div>
          <div class="metric-label">Tiempo medio de respuesta</div>
          <div class="metric-foot">24h al día, sin descanso</div>
        </div>

        <div class="metric-card">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2M16 3.13a4 4 0 010 7.75M22 21v-2a4 4 0 00-3-3.85"/></svg>
          </div>
          <div class="metric-num">+340</div>
          <div class="metric-label">Conversaciones gestionadas al mes</div>
          <div class="metric-foot">Sin contratar a nadie</div>
        </div>

        <div class="metric-card">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
          </div>
          <div class="metric-num">87%</div>
          <div class="metric-label">Conversaciones resueltas sin humano</div>
          <div class="metric-foot">Solo el 13% necesita tu intervención</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .proof { padding: 7rem 0; }
  @media (max-width: 768px) { .proof { padding: 4rem 0; } }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .proof-grid { grid-template-columns: 1fr 1.1fr; gap: 5rem; }
  }

  .proof-left .eyebrow { margin-bottom: 1.25rem; }
  .proof-left .h-section { margin-bottom: 1.5rem; }
  .proof-text {
    color: var(--nx-ink-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .proof-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .metric-card {
    background: var(--nx-deep);
    border: 1px solid var(--nx-line);
    border-radius: 18px;
    padding: 1.75rem 1.5rem;
    transition: all 0.4s var(--nx-ease);
  }
  .metric-card:hover {
    border-color: rgba(78, 205, 196, 0.25);
    transform: translateY(-3px);
  }
  .metric-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: var(--nx-magnet-halo);
    color: var(--nx-magnet);
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }
  .metric-num {
    font-family: var(--nx-font-serif);
    font-size: 2.5rem;
    color: var(--nx-ink);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .metric-label {
    color: var(--nx-ink);
    font-size: 0.88rem;
    line-height: 1.4;
    margin-bottom: 0.4rem;
  }
  .metric-foot {
    color: var(--nx-ink-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .proof-right { grid-template-columns: 1fr; }
  }
</style>
