---
const { trial = false } = Astro.props;
---
<!-- Floating launcher button -->
<button id="lara-launcher" class="lara-launcher" aria-label="Habla con Lara" data-track="lara_open" data-trial={trial ? "1" : "0"}>
  <div class="lara-launcher-inner">
    <div class="lara-avatar-mini">L</div>
    <div class="lara-launch-text">
      <div class="lara-launch-title">Habla con Lara</div>
      <div class="lara-launch-sub">Descubre tu plan ideal</div>
    </div>
  </div>
  <div class="lara-pulse"></div>
</button>

<!-- Chat window -->
<div id="lara-chat" class="lara-chat" aria-hidden="true">
  <div class="lara-head">
    <div class="lara-head-left">
      <div class="lara-avatar">L</div>
      <div>
        <div class="lara-name">Lara <span class="lara-tag">Asistente IA</span></div>
        <div class="lara-status"><span class="online-dot-mini"></span> Lista para ayudarte</div>
      </div>
    </div>
    <button id="lara-close" class="lara-close" aria-label="Cerrar chat">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="lara-body" id="lara-body"></div>
  <div class="lara-input-wrap">
    <input type="text" id="lara-input" placeholder="Escribe tu respuesta..." autocomplete="off" />
    <button id="lara-send" class="lara-send" aria-label="Enviar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </button>
  </div>
  <div class="lara-foot">Conversación protegida · Tus datos no se comparten</div>
</div>

<div id="hablar"></div>

<script is:inline>
(function() {

  const PLANES = {
    starter: {
      nombre: 'Starter',
      precio: '249 €/mes',
      emoji: '🌱',
      puntos: [
        'Lara responde WhatsApp 24h sin que hagas nada',
        'Agenda citas automáticamente y sin errores',
        'Nunca más una cita perdida por no contestar',
      ],
      desc: 'Perfecto si empiezas: tu asistente siempre activa en WhatsApp.'
    },
    pro: {
      nombre: 'Pro',
      precio: '449 €/mes',
      emoji: '⚡',
      puntos: [
        'WhatsApp + Instagram DMs cubiertos 24h',
        'Recupera automáticamente clientas que llevan meses sin venir',
        'Analítica de qué servicios te dan más dinero',
      ],
      desc: 'El más elegido: cubre todos tus canales y hace crecer tu cartera de clientas.'
    },
    total: {
      nombre: 'Total',
      precio: '749 €/mes',
      emoji: '👑',
      puntos: [
        'Todo lo anterior, sin límites de mensajes ni trabajadoras',
        'Campañas de marketing automatizadas cada mes',
        'Tu asistente con nombre y personalidad propios',
      ],
      desc: 'Para salones que quieren dominar su zona: marketing, agenda y atención en piloto automático.'
    }
  };

  function recomendar(data) {
    const esGrande = ['4-8', '+8'].includes(data.trabajadoras);
    const conInstagram = ['Instagram', 'Por todos lados'].includes(data.canal);
    const muchasPerdidas = data.citas_perdidas === 'Más de 5';
    const todo = data.mayor_dolor === 'Todo a la vez';
    const captarClientas = data.mayor_dolor === 'Recuperar clientas';

    if (esGrande || todo || (conInstagram && muchasPerdidas)) return 'total';
    if (conInstagram || captarClientas || data.citas_perdidas === '3-5' || data.trabajadoras === '2-3') return 'pro';
    return 'starter';
  }

  const FLOW_STANDARD = [
    {
      id: 'welcome',
      bot: '¡Hola! 👋 Soy Lara, la asistente IA que gestiona peluquerías mientras las dueñas trabajan.<br/><br/>¿Cómo te llamas?',
      field: 'nombre',
      validate: v => v.length >= 2,
    },
    {
      id: 'salon',
      bot: (data) => `Encantada, ${data.nombre} 🌸. ¿Cómo se llama tu salón o centro?`,
      field: 'salon',
      validate: v => v.length >= 2,
    },
    {
      id: 'canal',
      bot: '¿Por dónde te contactan más tus clientas?',
      field: 'canal',
      validate: v => v.length >= 2,
      suggestions: ['WhatsApp', 'Instagram', 'Teléfono', 'Por todos lados'],
    },
    {
      id: 'trabajadoras',
      bot: '¿Cuántas personas trabajáis en el salón?',
      field: 'trabajadoras',
      validate: v => v.length >= 1,
      suggestions: ['Solo yo', '2-3', '4-8', '+8'],
    },
    {
      id: 'citas_perdidas',
      bot: (data) => `${data.salon}, ¿cuántas citas crees que se os escapan a la semana por no contestar a tiempo?`,
      field: 'citas_perdidas',
      validate: v => v.length >= 1,
      suggestions: ['1-2', '3-5', 'Más de 5', 'No lo sé bien'],
    },
    {
      id: 'mayor_dolor',
      bot: '¿Qué es lo que más te come el tiempo en el día a día?',
      field: 'mayor_dolor',
      validate: v => v.length >= 2,
      suggestions: ['Responder mensajes', 'Gestionar la agenda', 'Recuperar clientas', 'Todo a la vez'],
    },
    {
      id: 'recomendacion',
      bot: (data) => {
        const planKey = recomendar(data);
        data._plan = planKey;
        const p = PLANES[planKey];
        const alts = Object.entries(PLANES).filter(([k]) => k !== planKey);
        return `Con lo que me has contado, el plan ideal para <strong>${data.salon}</strong> es:<br/><br/>` +
          `<div class="lara-plan-card">` +
          `<div class="lara-plan-badge">⭐ Recomendado</div>` +
          `<div class="lara-plan-header">${p.emoji} <strong>Plan ${p.nombre}</strong> · <span class="lara-plan-price">${p.precio}</span></div>` +
          `<ul class="lara-plan-list">${p.puntos.map(pt => `<li>${pt}</li>`).join('')}</ul>` +
          `<div class="lara-plan-desc">${p.desc}</div>` +
          `</div>` +
          `<div class="lara-plan-alts-label">También disponibles:</div>` +
          alts.map(([k, alt]) =>
            `<div class="lara-plan-alt">` +
            `<div class="lara-plan-alt-header">${alt.emoji} <strong>Plan ${alt.nombre}</strong> · <span class="lara-plan-price">${alt.precio}</span></div>` +
            `<div class="lara-plan-alt-desc">${alt.desc}</div>` +
            `</div>`
          ).join('') +
          `<br/>¿Con cuál te quedas?`;
      },
      field: 'plan_elegido',
      validate: (v, data) => {
        const lower = v.toLowerCase();
        if (lower.includes('starter')) { data._plan = 'starter'; return true; }
        if (lower.includes('pro')) { data._plan = 'pro'; return true; }
        if (lower.includes('total')) { data._plan = 'total'; return true; }
        return false;
      },
      suggestions: (data) => {
        const rec = data._plan || 'pro';
        return ['starter', 'pro', 'total'].map(k =>
          k === rec ? `✓ Plan ${PLANES[k].nombre}` : `Plan ${PLANES[k].nombre}`
        );
      },
    },
    {
      id: 'telefono',
      bot: (data) => {
        const p = PLANES[data._plan || 'pro'];
        return `Para activar el <strong>Plan ${p.nombre}</strong> solo necesito un dato más.<br/>¿Cuál es tu teléfono? Te confirmo la activación por WhatsApp en menos de 24h.`;
      },
      field: 'telefono',
      validate: v => /^[+\d\s\-()]{9,}$/.test(v),
    },
    {
      id: 'final',
      bot: (data) => {
        const p = PLANES[data._plan || 'pro'];
        return `¡Listo, ${data.nombre}! 🎉<br/><br/>He registrado tu solicitud para el <strong>Plan ${p.nombre}</strong> de ${data.salon}. Recibirás un mensaje en el ${data.telefono} con todos los pasos para activar Lara en tu salón.`;
      },
      field: null,
      final: true,
      showCTA: true,
    },
  ];


  // ── TRIAL FLOW (prueba gratis) ─────────────────────────────────────────
  const FLOW_TRIAL = [
    {
      id: 'welcome',
      bot: '¡Hola! 👋 Soy Lara.<br/><br/>Voy a activarte la prueba gratis en menos de 24h. Es muy rápido. ¿Cómo te llamas?',
      field: 'nombre',
      validate: v => v.length >= 2,
    },
    {
      id: 'salon',
      bot: (data) => `Encantada, ${data.nombre} 🌸. ¿Cómo se llama tu salón?`,
      field: 'salon',
      validate: v => v.length >= 2,
    },
    {
      id: 'canal',
      bot: '¿Por dónde te contactan más tus clientas?',
      field: 'canal',
      validate: v => v.length >= 2,
      suggestions: ['WhatsApp', 'Instagram', 'Teléfono', 'Por todos lados'],
    },
    {
      id: 'telefono',
      bot: (data) => `Perfecto. Para activar Lara en <strong>${data.salon}</strong> solo necesito tu número de WhatsApp.<br/><br/>Te activo Lara en tu salón en minutos — gratis, sin tarjeta.`,
      field: 'telefono',
      validate: v => /^[+\d\s\-()]{9,}$/.test(v),
    },
    {
      id: 'final',
      bot: (data) => `¡Listo, ${data.nombre}! 🎉<br/><br/>He registrado tu prueba gratuita para <strong>${data.salon}</strong>. En pocos minutos recibirás un mensaje en el ${data.telefono} para activar Lara.<br/><br/><em>Sin tarjeta · Sin compromisos · 7 días para probarlo todo</em>`,
      field: null,
      final: true,
      showCTA: false,
    },
  ];

  // Detect trial mode from launcher data attribute
  const IS_TRIAL = document.getElementById('lara-launcher')?.dataset?.trial === '1';
  const flow = IS_TRIAL ? FLOW_TRIAL : FLOW_STANDARD;

  const state = {
    step: 0,
    data: {},
    opened: false,
    finished: false,
  };

  function $(id) { return document.getElementById(id); }

  function track(event, props) {
    if (window.gtag) gtag('event', event, props || {});
    if (window.fbq) fbq('trackCustom', event, props || {});
    if (window.plausible) plausible(event, { props: props || {} });
  }

  function addMsg(text, who) {
    const body = $('lara-body');
    const msg = document.createElement('div');
    msg.className = 'lara-msg lara-msg-' + who;
    if (who === 'bot') { msg.innerHTML = text; } else { msg.textContent = text; }
    body.appendChild(msg);
    requestAnimationFrame(() => msg.classList.add('show'));
    body.scrollTop = body.scrollHeight;
  }

  function addTyping() {
    const body = $('lara-body');
    const t = document.createElement('div');
    t.className = 'lara-msg lara-msg-bot lara-typing';
    t.innerHTML = '<span></span><span></span><span></span>';
    t.id = 'lara-typing';
    body.appendChild(t);
    body.scrollTop = body.scrollHeight;
  }

  function removeTyping() {
    const t = $('lara-typing');
    if (t) t.remove();
  }

  function addSuggestions(suggestions) {
    const body = $('lara-body');
    const wrap = document.createElement('div');
    wrap.className = 'lara-chips';
    wrap.id = 'lara-chips';
    suggestions.forEach(s => {
      const b = document.createElement('button');
      b.className = 'lara-chip';
      b.textContent = s;
      b.onclick = () => {
        $('lara-input').value = s;
        handleSend();
      };
      wrap.appendChild(b);
    });
    body.appendChild(wrap);
    body.scrollTop = body.scrollHeight;
  }

  function removeSuggestions() {
    const c = $('lara-chips');
    if (c) c.remove();
  }

  function addCTA() {
    const body = $('lara-body');
    const wrap = document.createElement('div');
    wrap.className = 'lara-cta-wrap';
    const planKey = state.data._plan || 'pro';
    const p = PLANES[planKey];
    const btn = document.createElement('button');
    btn.className = 'lara-cta-btn';
    btn.setAttribute('data-checkout-plan', planKey);
    btn.textContent = `Activar Plan ${p.nombre} — ${p.precio} →`;
    wrap.appendChild(btn);
    body.appendChild(wrap);
    body.scrollTop = body.scrollHeight;
  }

  async function showStep(idx) {
    const step = flow[idx];
    if (!step) return;
    removeSuggestions();
    const delay = step.autoNext ? 700 : 900 + Math.random() * 600;
    addTyping();
    await new Promise(r => setTimeout(r, delay));
    removeTyping();
    const text = typeof step.bot === 'function' ? step.bot(state.data) : step.bot;
    addMsg(text, 'bot');
    if (step.suggestions) {
      const suggs = typeof step.suggestions === 'function' ? step.suggestions(state.data) : step.suggestions;
      setTimeout(() => addSuggestions(suggs), 200);
    }
    if (step.autoNext) {
      setTimeout(() => {
        state.step += 1;
        showStep(state.step);
      }, step.autoNextDelay || 1200);
      return;
    }
    if (step.final) {
      if (step.showCTA) setTimeout(addCTA, 500);
      $('lara-input').disabled = true;
      $('lara-send').disabled = true;
      state.finished = true;
      sendLead();
      track('lara_lead_complete', { plan: state.data._plan });
    }
  }

  function sendLead() {
    const payload = {
      ...state.data,
      source: 'nexux.pro',
      timestamp: new Date().toISOString(),
      utm: new URLSearchParams(location.search).toString(),
    };

    try {
      sessionStorage.setItem('laraData', JSON.stringify(state.data));
    } catch (e) {
      console.warn('[lara] sessionStorage unavailable', e);
    }

    fetch('/api/leads/pro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    }).catch(() => {});
  }

  async function handleSend() {
    if (state.finished) return;
    const input = $('lara-input');
    const value = input.value.trim();
    if (!value) return;
    const step = flow[state.step];
    if (!step || !step.field) return;
    if (!step.validate(value, state.data)) {
      addMsg(value, 'user');
      addTyping();
      await new Promise(r => setTimeout(r, 700));
      removeTyping();
      addMsg('Mmm, ¿podrías concretar un poquito más? 🌷', 'bot');
      input.value = '';
      return;
    }
    addMsg(value, 'user');
    state.data[step.field] = value;
    input.value = '';
    track('lara_step_' + step.id, { value });
    state.step += 1;
    showStep(state.step);
  }

  function open() {
    if (state.opened) return;
    state.opened = true;
    $('lara-chat').classList.add('open');
    $('lara-chat').setAttribute('aria-hidden', 'false');
    $('lara-launcher').classList.add('hidden');
    track('lara_opened');
    if (state.step === 0 && $('lara-body').children.length === 0) {
      showStep(0);
    }
  }

  function close() {
    state.opened = false;
    $('lara-chat').classList.remove('open');
    $('lara-chat').setAttribute('aria-hidden', 'true');
    $('lara-launcher').classList.remove('hidden');
  }

  function init() {
    $('lara-launcher').addEventListener('click', open);
    $('lara-close').addEventListener('click', close);
    $('lara-send').addEventListener('click', handleSend);
    $('lara-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') handleSend();
    });
    document.querySelectorAll('a[href="#hablar"]').forEach(a => {
      a.addEventListener('click', e => { e.preventDefault(); open(); });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style is:global>
  .lara-launcher {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    background: var(--nx-magnet);
    color: var(--nx-void);
    border: none;
    border-radius: 999px;
    padding: 0.875rem 1.25rem 0.875rem 0.875rem;
    box-shadow:
      0 20px 40px -10px rgba(78,205,196,0.5),
      0 0 0 6px rgba(78,205,196,0.15);
    cursor: pointer;
    transition: transform 0.3s var(--nx-ease);
    animation: launcher-in 0.6s var(--nx-ease) 1.5s backwards;
  }
  @keyframes launcher-in {
    from { transform: translateY(40px) scale(0.8); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  .lara-launcher.hidden { display: none; }
  .lara-launcher:hover { transform: translateY(-3px) scale(1.02); }
  .lara-launcher-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }
  .lara-avatar-mini {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--nx-void);
    color: var(--nx-magnet);
    display: grid;
    place-items: center;
    font-family: var(--nx-font-serif);
    font-style: italic;
    font-size: 1.2rem;
    font-weight: 500;
  }
  .lara-launch-text { text-align: left; }
  .lara-launch-title {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .lara-launch-sub {
    font-size: 0.72rem;
    opacity: 0.7;
    margin-top: 0.1rem;
  }
  .lara-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid var(--nx-magnet);
    animation: lara-pulse 2.2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes lara-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; }
  }

  .lara-chat {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 380px;
    max-width: calc(100vw - 32px);
    height: 620px;
    max-height: calc(100vh - 48px);
    background: var(--nx-deep);
    border: 1px solid var(--nx-line-hover);
    border-radius: 24px;
    box-shadow: 0 40px 80px -20px rgba(0,0,0,0.7);
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px) scale(0.96);
    pointer-events: none;
    transition: all 0.35s var(--nx-ease);
  }
  .lara-chat.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .lara-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--nx-line);
    background: linear-gradient(180deg, rgba(78,205,196,0.06), transparent);
  }
  .lara-head-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lara-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    display: grid;
    place-items: center;
    font-family: var(--nx-font-serif);
    font-style: italic;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .lara-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--nx-ink);
    line-height: 1.2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lara-tag {
    font-size: 0.65rem;
    background: var(--nx-magnet-halo);
    color: var(--nx-magnet);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .lara-status {
    font-size: 0.72rem;
    color: var(--nx-ink-muted);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }
  .online-dot-mini {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-success);
    box-shadow: 0 0 4px var(--nx-success);
  }
  .lara-close {
    background: transparent;
    border: none;
    color: var(--nx-ink-muted);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 8px;
    transition: all 0.2s;
  }
  .lara-close:hover { background: var(--nx-surface); color: var(--nx-ink); }

  .lara-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--nx-void);
  }
  .lara-body::-webkit-scrollbar { width: 4px; }
  .lara-body::-webkit-scrollbar-thumb {
    background: var(--nx-line-hover);
    border-radius: 999px;
  }

  .lara-msg {
    padding: 0.7rem 1rem;
    border-radius: 18px;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 88%;
    word-wrap: break-word;
    white-space: pre-wrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s, transform 0.3s;
  }
  .lara-msg.show { opacity: 1; transform: translateY(0); }
  .lara-msg-user {
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    font-weight: 500;
  }
  .lara-msg-bot {
    background: var(--nx-surface);
    color: var(--nx-ink);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .lara-typing {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.85rem 1rem;
    opacity: 1;
    transform: translateY(0);
  }
  .lara-typing span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-ink-muted);
    animation: typing-bounce 1.2s infinite;
  }
  .lara-typing span:nth-child(2) { animation-delay: 0.2s; }
  .lara-typing span:nth-child(3) { animation-delay: 0.4s; }

  .lara-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: 0.25rem;
  }
  .lara-chip {
    background: transparent;
    border: 1px solid var(--nx-line-hover);
    color: var(--nx-ink);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .lara-chip:hover {
    border-color: var(--nx-magnet);
    color: var(--nx-magnet);
