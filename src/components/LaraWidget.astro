---
const { trial = false } = Astro.props;
---
<!-- Floating launcher button -->
<button id="lara-launcher" class="lara-launcher" aria-label="Habla con Lara" data-track="lara_open" data-trial={trial ? "1" : "0"}>
  <div class="lara-launcher-inner">
    <div class="lara-avatar-mini">L</div>
    <div class="lara-launch-text">
      <div class="lara-launch-title">Habla con Lara</div>
      <div class="lara-launch-sub">Descubre tu plan ideal</div>
    </div>
  </div>
  <div class="lara-pulse"></div>
</button>

<!-- Chat window -->
<div id="lara-chat" class="lara-chat" aria-hidden="true">
  <div class="lara-head">
    <div class="lara-head-left">
      <div class="lara-avatar">L</div>
      <div>
        <div class="lara-name">Lara <span class="lara-tag">Asistente IA</span></div>
        <div class="lara-status"><span class="online-dot-mini"></span> Lista para ayudarte</div>
      </div>
    </div>
    <button id="lara-close" class="lara-close" aria-label="Cerrar chat">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="lara-body" id="lara-body"></div>
  <div class="lara-input-wrap">
    <input type="text" id="lara-input" placeholder="Escribe tu respuesta..." autocomplete="off" />
    <button id="lara-send" class="lara-send" aria-label="Enviar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </button>
  </div>
  <div class="lara-foot">Conversación protegida · Tus datos no se comparten</div>
</div>

<div id="hablar"></div>

<script is:inline>
(function() {
  var state = {
    history: [],
    sessionData: {},
    sessionId: '',
    opened: false,
    finished: false,
    loading: false
  };

  function $(id) { return document.getElementById(id); }

  function genId() {
    try { return crypto.randomUUID(); } catch (e) { return Date.now().toString(36) + Math.random().toString(36).slice(2); }
  }

  function getSessionId() {
    var sid;
    try { sid = sessionStorage.getItem('laraSessionId'); } catch (e) {}
    if (!sid) { sid = genId(); try { sessionStorage.setItem('laraSessionId', sid); } catch (e) {} }
    return sid;
  }

  function track(event, props) {
    if (window.gtag) gtag('event', event, props || {});
    if (window.fbq) fbq('trackCustom', event, props || {});
    if (window.plausible) plausible(event, { props: props || {} });
  }

  function addMsg(text, who) {
    var body = $('lara-body');
    var msg = document.createElement('div');
    msg.className = 'lara-msg lara-msg-' + who;
    if (who === 'bot') { msg.innerHTML = text; } else { msg.textContent = text; }
    body.appendChild(msg);
    requestAnimationFrame(function() { msg.classList.add('show'); });
    body.scrollTop = body.scrollHeight;
  }

  function addTyping() {
    var body = $('lara-body');
    var t = document.createElement('div');
    t.className = 'lara-msg lara-msg-bot lara-typing';
    t.innerHTML = '<span></span><span></span><span></span>';
    t.id = 'lara-typing';
    body.appendChild(t);
    body.scrollTop = body.scrollHeight;
  }

  function removeTyping() {
    var t = $('lara-typing');
    if (t) t.remove();
  }

  function renderPlanCard(plan) {
    var body = $('lara-body');
    var wrap = document.createElement('div');
    wrap.className = 'lara-plan-card';
    wrap.innerHTML =
      '<div class="lara-plan-badge">⭐ Recomendado</div>' +
      '<div class="lara-plan-header">' + plan.emoji + ' <strong>Plan ' + plan.nombre + '</strong> · <span class="lara-plan-price">' + plan.precio + '</span></div>' +
      '<ul class="lara-plan-list">' + plan.puntos.map(function(p) { return '<li>' + p + '</li>'; }).join('') + '</ul>' +
      '<div class="lara-plan-desc">' + plan.desc + '</div>';
    body.appendChild(wrap);

    var cta = document.createElement('div');
    cta.className = 'lara-cta-wrap';
    var btn = document.createElement('button');
    btn.className = 'lara-cta-btn';
    btn.textContent = 'Quiero empezar con ' + plan.nombre + ' — ' + plan.precio + ' →';
    btn.onclick = function() {
      track('lara_plan_click', { plan: plan.plan });
      window.open('https://wa.me/34630745369?text=Hola%2C%20quiero%20el%20plan%20' + plan.plan, '_blank');
    };
    cta.appendChild(btn);
    body.appendChild(cta);
    body.scrollTop = body.scrollHeight;
  }

  async function sendToAI(value) {
    if (state.loading) return;
    state.loading = true;
    addTyping();
    try {
      var res = await fetch('/api/lara-web/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sessionId: state.sessionId,
          message: value,
          history: state.history,
          sessionData: state.sessionData
        })
      });
      removeTyping();
      if (!res.ok) {
        addMsg('Lo siento, hubo un error. ¿Puedes intentarlo de nuevo? 🌷', 'bot');
        state.loading = false;
        return;
      }
      var data = await res.json();
      addMsg(data.reply, 'bot');
      state.history.push({ role: 'user', content: value });
      state.history.push({ role: 'assistant', content: data.reply });
      if (data.sessionData) state.sessionData = data.sessionData;
      if (state.history.length > 20) state.history = state.history.slice(-20);

      if (data.done && data.planRecommendation) {
        state.finished = true;
        $('lara-input').disabled = true;
        $('lara-send').disabled = true;
        setTimeout(function() { renderPlanCard(data.planRecommendation); }, 500);
        track('lara_lead_complete', { plan: data.planRecommendation.plan });
      }
    } catch (e) {
      removeTyping();
      addMsg('Lo siento, no he podido conectarme. ¿Puedes escribirme por WhatsApp? 💬', 'bot');
    }
    state.loading = false;
  }

  function handleSend() {
    if (state.finished || state.loading) return;
    var input = $('lara-input');
    var value = input.value.trim();
    if (!value) return;
    addMsg(value, 'user');
    input.value = '';
    sendToAI(value);
  }

  function open() {
    if (state.opened) return;
    state.opened = true;
    state.sessionId = getSessionId();
    $('lara-chat').classList.add('open');
    $('lara-chat').setAttribute('aria-hidden', 'false');
    $('lara-launcher').classList.add('hidden');
    track('lara_opened');
    if (state.history.length === 0 && $('lara-body').children.length === 0) {
      sendToAI('Hola');
    }
  }

  function close() {
    state.opened = false;
    $('lara-chat').classList.remove('open');
    $('lara-chat').setAttribute('aria-hidden', 'true');
    $('lara-launcher').classList.remove('hidden');
  }

  function init() {
    $('lara-launcher').addEventListener('click', open);
    $('lara-close').addEventListener('click', close);
    $('lara-send').addEventListener('click', handleSend);
    $('lara-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') handleSend();
    });
    document.querySelectorAll('a[href="#hablar"]').forEach(function(a) {
      a.addEventListener('click', function(e) { e.preventDefault(); open(); });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style is:global>
  .lara-launcher {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    background: var(--nx-magnet);
    color: var(--nx-void);
    border: none;
    border-radius: 999px;
    padding: 0.875rem 1.25rem 0.875rem 0.875rem;
    box-shadow:
      0 20px 40px -10px rgba(78,205,196,0.5),
      0 0 0 6px rgba(78,205,196,0.15);
    cursor: pointer;
    transition: transform 0.3s var(--nx-ease);
    animation: launcher-in 0.6s var(--nx-ease) 1.5s backwards;
  }
  @keyframes launcher-in {
    from { transform: translateY(40px) scale(0.8); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  .lara-launcher.hidden { display: none; }
  .lara-launcher:hover { transform: translateY(-3px) scale(1.02); }
  .lara-launcher-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }
  .lara-avatar-mini {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--nx-void);
    color: var(--nx-magnet);
    display: grid;
    place-items: center;
    font-family: var(--nx-font-serif);
    font-style: italic;
    font-size: 1.2rem;
    font-weight: 500;
  }
  .lara-launch-text { text-align: left; }
  .lara-launch-title {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .lara-launch-sub {
    font-size: 0.72rem;
    opacity: 0.7;
    margin-top: 0.1rem;
  }
  .lara-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid var(--nx-magnet);
    animation: lara-pulse 2.2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes lara-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; }
  }

  .lara-chat {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 380px;
    max-width: calc(100vw - 32px);
    height: 620px;
    max-height: calc(100vh - 48px);
    background: var(--nx-deep);
    border: 1px solid var(--nx-line-hover);
    border-radius: 24px;
    box-shadow: 0 40px 80px -20px rgba(0,0,0,0.7);
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px) scale(0.96);
    pointer-events: none;
    transition: all 0.35s var(--nx-ease);
  }
  .lara-chat.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .lara-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--nx-line);
    background: linear-gradient(180deg, rgba(78,205,196,0.06), transparent);
  }
  .lara-head-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lara-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    display: grid;
    place-items: center;
    font-family: var(--nx-font-serif);
    font-style: italic;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .lara-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--nx-ink);
    line-height: 1.2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lara-tag {
    font-size: 0.65rem;
    background: var(--nx-magnet-halo);
    color: var(--nx-magnet);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .lara-status {
    font-size: 0.72rem;
    color: var(--nx-ink-muted);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }
  .online-dot-mini {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-success);
    box-shadow: 0 0 4px var(--nx-success);
  }
  .lara-close {
    background: transparent;
    border: none;
    color: var(--nx-ink-muted);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 8px;
    transition: all 0.2s;
  }
  .lara-close:hover { background: var(--nx-surface); color: var(--nx-ink); }

  .lara-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--nx-void);
  }
  .lara-body::-webkit-scrollbar { width: 4px; }
  .lara-body::-webkit-scrollbar-thumb {
    background: var(--nx-line-hover);
    border-radius: 999px;
  }

  .lara-msg {
    padding: 0.7rem 1rem;
    border-radius: 18px;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 88%;
    word-wrap: break-word;
    white-space: pre-wrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s, transform 0.3s;
  }
  .lara-msg.show { opacity: 1; transform: translateY(0); }
  .lara-msg-user {
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    font-weight: 500;
  }
  .lara-msg-bot {
    background: var(--nx-surface);
    color: var(--nx-ink);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .lara-typing {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.85rem 1rem;
    opacity: 1;
    transform: translateY(0);
  }
  .lara-typing span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--nx-ink-muted);
    animation: typing-bounce 1.2s infinite;
  }
  .lara-typing span:nth-child(2) { animation-delay: 0.2s; }
  .lara-typing span:nth-child(3) { animation-delay: 0.4s; }

  .lara-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: 0.25rem;
  }
  .lara-chip {
    background: transparent;
    border: 1px solid var(--nx-line-hover);
    color: var(--nx-ink);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .lara-chip:hover {
    border-color: var(--nx-magnet);
    color: var(--nx-magnet);
    background: var(--nx-magnet-halo);
  }

  /* Plan recommendation card */
  .lara-plan-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--nx-magnet);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }
  .lara-plan-alts-label {
    font-size: 0.75rem;
    color: var(--nx-ink-muted);
    margin: 0.6rem 0 0.2rem;
  }
  .lara-plan-alt {
    background: var(--nx-surface);
    border: 1px solid var(--nx-line);
    border-radius: 10px;
    padding: 0.55rem 0.8rem;
    margin-top: 0.35rem;
  }
  .lara-plan-alt-header {
    font-size: 0.83rem;
    color: var(--nx-ink);
    margin-bottom: 0.15rem;
  }
  .lara-plan-alt-desc {
    font-size: 0.73rem;
    color: var(--nx-ink-muted);
  }
  .lara-plan-card {
    background: var(--nx-void);
    border: 1px solid var(--nx-magnet);
    border-radius: 14px;
    padding: 0.85rem 1rem;
    margin-top: 0.5rem;
    box-shadow: 0 0 20px -8px rgba(78,205,196,0.3);
  }
  .lara-plan-header {
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .lara-plan-price {
    color: var(--nx-magnet);
    font-weight: 700;
  }
  .lara-plan-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .lara-plan-list li {
    font-size: 0.82rem;
    color: var(--nx-ink-muted);
    padding-left: 1.2rem;
    position: relative;
  }
  .lara-plan-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--nx-magnet);
    font-weight: 700;
  }
  .lara-plan-desc {
    font-size: 0.78rem;
    color: var(--nx-ink-faint);
    font-style: italic;
    border-top: 1px solid var(--nx-line);
    padding-top: 0.5rem;
    margin-top: 0.3rem;
  }

  /* Final CTA */
  .lara-cta-wrap {
    align-self: stretch;
    margin-top: 0.25rem;
  }
  .lara-cta-btn {
    width: 100%;
    background: linear-gradient(135deg, var(--nx-magnet), var(--nx-magnet-deep));
    color: var(--nx-void);
    border: none;
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--nx-font-sans);
  }
  .lara-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -6px rgba(78,205,196,0.5);
  }

  .lara-input-wrap {
    display: flex;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--nx-line);
    background: var(--nx-deep);
  }
  #lara-input {
    flex: 1;
    background: var(--nx-void);
    border: 1px solid var(--nx-line);
    color: var(--nx-ink);
    padding: 0.65rem 1rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-family: var(--nx-font-sans);
    outline: none;
    transition: border-color 0.2s;
  }
  #lara-input:focus { border-color: var(--nx-magnet); }
  #lara-input:disabled { opacity: 0.5; }
  .lara-send {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--nx-magnet);
    color: var(--nx-void);
    border: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .lara-send:hover:not(:disabled) {
    background: var(--nx-magnet-glow);
    transform: translateX(2px);
  }
  .lara-send:disabled { opacity: 0.4; cursor: not-allowed; }

  .lara-foot {
    text-align: center;
    padding: 0.4rem;
    font-size: 0.68rem;
    color: var(--nx-ink-faint);
    background: var(--nx-deep);
    border-top: 1px solid var(--nx-line);
  }

  @media (max-width: 500px) {
    .lara-launcher {
      bottom: 16px; right: 16px;
      padding: 0.7rem 1rem 0.7rem 0.7rem;
    }
    .lara-launch-text { display: none; }
    .lara-chat {
      bottom: 0; right: 0; left: 0;
      width: 100%;
      max-width: 100%;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
    }
  }
</style>
